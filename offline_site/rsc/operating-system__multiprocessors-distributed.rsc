1b:{"metadata":[["$","title","0",{"children":"Multiprocessors, Multicomputers & Distributed Systems: Operating Systems"}],["$","meta","1",{"name":"description","content":"What changes when one CPU becomes many cores, many boxes, and finally many machines that can each fail on their own"}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}],["$","link","3",{"rel":"icon","href":"/icon.png?5dbc1fad7703bc98","type":"image/png","sizes":"512x512"}],["$","link","4",{"rel":"apple-touch-icon","href":"/apple-icon.png?375f5bf186e6939a","type":"image/png","sizes":"180x180"}],["$","$L4c","5",{}]],"error":null,"digest":"$undefined"}
20:"$1b:metadata"
