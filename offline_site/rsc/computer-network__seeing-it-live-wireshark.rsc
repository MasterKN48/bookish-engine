23:["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Wireshark is a packet analyzer: it captures the frames flowing through your network interface and decodes them into human-readable detail. It is the single best way to actually see the protocols you have learned: DNS, TCP, TLS, HTTP, in action."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L2a",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch31%2F01-what-is-wireshark.jpg?v=f1b7823a97c963a064ea8fef06821d33","alt":"A magnifying glass over a wire showing individual packets."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]
24:["$","section","02-layers-in-packet",{"id":"02-layers-in-packet","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"One packet, all the layers"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Click any packet and Wireshark expands it layer by layer, the Ethernet frame (with MAC addresses), the IP header (with IPs and TTL), the TCP header (ports, sequence numbers, flags), and the application data (like HTTP). It is the encapsulation from Chapter 1, laid out in front of you."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L2a",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch31%2F02-layers-in-packet.jpg?v=1126e1086c6e29a967b9f72f52fd2a89","alt":"A captured packet expanded into Frame, IP, TCP, HTTP rows."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
25:["$","section","03-handshake-capture",{"id":"03-handshake-capture","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Spotting the 3-way handshake"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Open any TCP connection and the first three packets are unmistakable: SYN, then SYN, ACK, then ACK. You can read the sequence and acknowledgement numbers changing exactly as Chapter 16 described. Theory becomes observation."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L2a",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch31%2F03-handshake-capture.jpg?v=eb8ce765fc14276230ed492e4c1cbdec","alt":"Three capture rows: SYN, SYN-ACK, ACK."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
26:["$","section","04-udp-dns-capture",{"id":"04-udp-dns-capture","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"A DNS query over UDP"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Filter for DNS and you will see a tiny pair of packets: a \"Standard query A example.com\" and the \"Standard query response\" carrying the IP, sent over UDP on port 53, just as we covered. It is a perfect, minimal example of a request and reply."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L2a",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch31%2F04-udp-dns-capture.jpg?v=0df5e15b92311b76fa9d3c43cb0a9382","alt":"Two rows: DNS standard query and response over UDP port 53."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
27:["$","section","05-filters",{"id":"05-filters","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Display filters cut the noise"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A live capture is overwhelming, so Wireshark’s display filters narrow it down. Type dns to see only DNS, tcp.port == 443 for HTTPS, or ip.addr == 10.0.0.1 to follow one host. Filtering is the skill that turns noise into insight."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L2a",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch31%2F05-filters.jpg?v=dc4623c1c4e0841a8bd1c3496c1fd54e","alt":"A filter bar with tcp.port == 443, dns, ip.addr == 10.0.0.1."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
28:["$","section","06-why-it-matters",{"id":"06-why-it-matters","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Why capture traffic?"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Beyond learning, packet capture is a real debugging superpower: you can see retransmissions behind a slow request, confirm a TLS handshake succeeded, or prove where a connection breaks. Once you can watch the network, nothing about it stays mysterious."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["You made it",": "]}],"From a single fetch() down to bits on the wire, and back up through TCP, DNS, HTTP and TLS, you now have the full mental model of how the internet moves your data."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L2a",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch31%2F06-why-it-matters.jpg?v=530284c33da279bc130725bc98c0f619","alt":"Checklist: debug slow requests, see retransmissions, confirm TLS, learn by seeing."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
