2f:["$","section","09-devops-context",{"id":"09-devops-context","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"09"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Where you will meet CIDR"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"CIDR is not just theory, it is everywhere in DevOps. When you create a VPC on AWS or DigitalOcean, you define its address range with CIDR (e.g. 10.0.0.0/16). Security-group and firewall rules use it too."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Next",": "]}],"CIDR tells us the split; the subnet mask (next chapter) is how a machine actually computes it."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch03%2F09-devops-context.jpg?v=92046f77fed952a1ad6547e37a98c104","alt":"An AWS/DigitalOcean cloud containing a VPC with CIDR 10.0.0.0/16."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
