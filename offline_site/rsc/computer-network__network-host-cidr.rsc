2a:["$","section","04-lan",{"id":"04-lan","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"LAN vs WAN"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Our little home network is a LAN, a Local Area Network. Everything beyond it, the wider internet, is the WAN (Wide Area Network). Most of networking is about how a device on your LAN reaches something out on the WAN."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch03%2F04-lan.jpg?v=cfa08e9059c92ea5ac655633fa8b2361","alt":"A dashed circle labelled LAN around a router and devices, with a WAN/Internet cloud outside."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
2b:["$","section","05-cidr",{"id":"05-cidr","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"CIDR notation"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"CIDR (Classless Inter-Domain Routing) is a compact way to describe a whole range of addresses, written as an IP followed by a slash and a number: 192.168.1.0/24."}],["$","dl","1",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"The .0 address"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The first IP of a range (like 192.168.1.0) is reserved to represent the network itself, not assigned to a device."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"The /24"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The number after the slash = how many bits are reserved for the network portion."}]]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch03%2F05-cidr.jpg?v=d79ad1cecdee070c86dbce6d45f56fd1","alt":"192.168.1.0/24 with .0 labelled network IP and /24 labelled network bits."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
2c:["$","section","06-network-host-bits",{"id":"06-network-host-bits","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Network bits vs host bits"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"In 192.168.1.0/24, the /24 means the first 24 bits, the first three octets (8+8+8), are the network part. They stay the same for every device on the network. The remaining 8 bits (the last octet) are the host part, unique per device."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"So plugging in a new printer gives it 192.168.1.5: the first three octets are unchanged (same network), only the last octet differs (a new host)."}],["$","div","2",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Rule of thumb",": "]}],"Network bits = fixed across the network. Host bits = free to change per device."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch03%2F06-network-host-bits.jpg?v=6f195c67d8f9bccb9f8a2918734ac19c","alt":"IP bits with the first 24 bracketed as NETWORK (fixed) and the last 8 as HOST (changes)."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
2d:["$","section","07-host-count",{"id":"07-host-count","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"07"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"How many hosts fit?"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The host bits decide how many devices fit. With 8 host bits (a /24), you get 2⁸ = 256 possible host addresses. Try to add more than that and you run out of bits to assign, the network is full."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["In practice",": "]}],"A couple of those 256 are reserved (the network address and the broadcast address), so usable hosts are slightly fewer, but 2^(host bits) is the number to remember."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch03%2F07-host-count.jpg?v=0beeac0de97fe33a135ee308ea5a238a","alt":"8 host bits gives 2^8 = 256 hosts."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
2e:["$","section","08-cidr-examples",{"id":"08-cidr-examples","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"08"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Reading different CIDR ranges"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Change the slash number and you change the split:"}],["$","dl","1",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"/24"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"First 3 octets are network; 256 host addresses."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"/16"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"First 2 octets network, last 2 host, a much bigger network (~65,536 hosts)."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"/0"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Zero network bits, matches every IP. 0.0.0.0/0 means \"the entire internet\"."}]]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://9