25:["$","div",null,{"className":"flex min-w-0 flex-1 flex-col gap-16","children":[["$","section","01-network",{"id":"01-network","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"01"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"What is a network?"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A network is simply a set of devices connected together so they can communicate. Picture a home router with a laptop, a phone, and a tablet attached to it. Those devices form one network, and within it they can talk to each other directly, no internet required."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Key point",": "]}],"Devices on the same network reach each other directly. Reaching anything else means leaving the network (later chapters)."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch03%2F01-network.jpg?v=f2c345ff70cd5d7ae812927ea26b08be","alt":"A router connected in a star to a laptop, phone and tablet."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}],["$","section","02-host",{"id":"02-host","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"What is a host?"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A host is any single device on the network that holds a unique IP. In our example the router is 192.168.1.1, the phone is .2, the tablet is .3, and the laptop is .4. Each host has its own address so data can be delivered to exactly the right one."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch03%2F02-host.jpg?v=469f1c0a172fe2729b4942a5859ad87f","alt":"Router .1, phone .2, tablet .3, laptop .4, each device a host with a unique IP."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}],["$","section","03-dhcp",{"id":"03-dhcp","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"DHCP hands out the IPs"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"You never type in these IPs by hand. When a new device joins, the router assigns it one automatically using DHCP (Dynamic Host Configuration Protocol). The router keeps a table of who has which address."}],"$L28"]}],"$L29"]}]]}],"$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"]}]
