25:["$","div",null,{"className":"flex min-w-0 flex-1 flex-col gap-16","children":[["$","section","01-why-subnet-mask",{"id":"01-why-subnet-mask","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"01"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Why we need a subnet mask"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"When a device wants to send data, it must first decide how. If the target is on the same network, it can send directly, no router, no internet. If not, it has to go through the router and out to the wider internet. The subnet mask is the tool that makes this decision."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["The whole job",": "]}],"Same network → send direct. Different network → route. The mask tells you which."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch04%2F01-why-subnet-mask.jpg?v=dfb202ecda193d75afb1f58d83787609","alt":"A laptop choosing between sending directly to a nearby device or routing through the internet."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}],["$","section","02-mask-is-ip",{"id":"02-mask-is-ip","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"A mask looks like an IP"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A subnet mask is written like an IP address, for a /24 network it is 255.255.255.0. But it is not a usable address: you cannot assign it to a device. It exists purely to be applied to IPs."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch04%2F02-mask-is-ip.jpg?v=fc86009fb20c52677b3977e11553ebb5","alt":"The subnet mask 255.255.255.0 labelled as a /24 mask, not assignable to a device."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}],["$","section","03-255-binary",{"id":"03-255-binary","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"255 means \"all ones\""}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The magic of a mask is clearest in binary. 255 is 11111111 (eight ones) and 0 is 00000000 (eight zeros). So 255.255.255.0 is twenty-four 1s followed by eight 0s, exactly the /24 split from the last chapter."}],"$L28"]}],"$L29"]}]]}],"$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"]}]
