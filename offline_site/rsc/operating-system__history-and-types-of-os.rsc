2f:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch02%2F03-multiprogramming-timesharing.jpg?v=31e0ae2a17e849128b39e51017149548","alt":"Hand-drawn diagram: several jobs resident in memory at once, the CPU switching to a ready job whenever the running one blocks on I/O; beside it, many user terminals each getting a time slice."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
30:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch02%2F04-pc-era.jpg?v=c03265df23e594bd8698cc701faff07c","alt":"Hand-drawn branching family tree: a cheap microprocessor at the root, splitting into DOS→Windows, the Mac/macOS line, and UNIX→Linux with an open-source label."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
31:["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}]
32:["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Same core, different scorecard",": "]}],"A general-purpose OS optimises for average performance across many programs. An RTOS sacrifices average speed to guarantee the worst case, because in real-time work, being usually fast is not good enough."]}]
33:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch02%2F05-mobile-embedded-realtime.jpg?v=62b124dc4ca7b3121d37fc6db36ec1e9","alt":"Hand-drawn three-panel sketch: a phone running Android-on-Linux and iOS, a tiny sensor chip with an RTOS, and a car airbag controller labelled \"hard real-time: deadline must not be missed\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
34:["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["The through-line",": "]}],"Whatever the zoo animal, phone, laptop, pacemaker, or cloud server, every operating system exists to do the same three jobs: manage the CPU, manage memory, and manage devices. Everything ahead in this course is those three jobs, done well."]}]
35:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L27",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch02%2F06-os-zoo-today.jpg?v=5e01fb4292b4bb026ce72e67c6f155a6","alt":"Hand-drawn taxonomy chart branching into Desktop/Server, Mobile, Embedded/RTOS, and Distributed/Cloud, with a small hypervisor box splitting one server into VMs and containers."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
