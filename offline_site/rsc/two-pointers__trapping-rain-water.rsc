19:["$","$L1a","trapping-rain-water",{"problem":{"id":"trapping-rain-water","patternId":"two-pointers","title":"Trapping Rain Water","subtitle":"Water held between bars of varying heights","kind":"problem","leetcode":{"id":42,"slug":"trapping-rain-water","difficulty":"Hard"},"companies":["Amazon","Google","Goldman Sachs"],"statement":"Given an elevation map of bar heights, compute how many units of water can be trapped between the bars after rain.","input":[2,0,4,1,0,3,1],"render":"bars","approaches":[{"label":"Brute force · scan both sides per column","complexity":{"time":"O(n²)","space":"O(1)"},"pseudocode":["given h[]","total ← 0","for i ← 0 to n − 1:","    maxL ← max(h[0..i])","    maxR ← max(h[i..n − 1])","    cap = min(maxL, maxR)","    total += max(0, cap − h[i])","return total"],"steps":[{"codeLine":1,"narration":"Imagine rain falling on these bars. Where does the water collect? Water can only sit above a column if there are TALLER bars on BOTH sides to hold it.","vars":[["n",7]]},{"codeLine":1,"narration":"For each column i, water above it = max(0, min(maxL, maxR) − h[i]). maxL = tallest bar in h[0..i], maxR = tallest in h[i..n−1]. The min is the \"cap\", water only rises as high as the SHORTER wall.","vars":[["formula","min(maxL, maxR) − h[i]"]]},{"codeLine":4,"narration":"Column 0 (h[0] = 2). Scan left over h[0..0], the tallest bar is leftMax = 2. (Red dashed line is the LEFT wall.)","pointers":[{"name":"i","index":0,"color":"ink"}],"highlights":[0],"vars":[["i",0],["h[i]",2],["leftMax",2],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[{"id":"leftWall","y":2,"xStart":0,"xEnd":1,"color":"red","label":"leftMax = 2"}]},{"codeLine":5,"narration":"Scan right over h[0..6], the tallest is rightMax = 4. (Blue dashed line is the RIGHT wall.)","pointers":[{"name":"i","index":0,"color":"ink"}],"highlights":[0],"vars":[["i",0],["leftMax",2],["rightMax",4],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[{"id":"leftWall","y":2,"xStart":0,"xEnd":1,"color":"red","label":"leftMax = 2"},{"id":"rightWall","y":4,"xStart":0,"xEnd":7,"color":"blue","label":"rightMax = 4"}]},{"codeLine":6,"narration":"cap = min(2, 4) = 2. h[0] = 2 already reaches the cap, so water[0] = 0. This column is a wall, not a valley.","pointers":[{"name":"i","index":0,"color":"ink"}],"highlights":[0],"vars":[["i",0],["leftMax",2],["rightMax",4],["cap",2],["water[i]",0],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[{"id":"leftWall","y":2,"xStart":0,"xEnd":1,"color":"red","label":"leftMax = 2"},{"id":"rightWall","y":4,"xStart":0,"xEnd":7,"color":"blue","label":"rightMax = 4"},{"id":"cap","y":2,"xStart":0,"xEnd":7,"color":"gold","label":"cap = 2","style":"solid"}]},{"codeLine":7,"narration":"Nothing to settle (column 0 hits the cap). total = 0.","pointers":[{"name":"i","index":0,"color":"ink"}],"highlights":[0],"vars":[["i",0],["water[i]",0],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[{"id":"cap","y":2,"xStart":0,"xEnd":1,"color":"gold","label":"+0","style":"solid"}]},{"codeLine":4,"narration":"Column 1 (h[1] = 0). Scan left over h[0..1], the tallest bar is leftMax = 2. (Red dashed line is the LEFT wall.)","pointers":[{"name":"i","index":1,"color":"ink"}],"highlights":[1],"vars":[["i",1],["h[i]",0],["leftMax",2],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[{"id":"leftWall","y":2,"xStart":0,"xEnd":2,"color":"red","label":"leftMax = 2"}]},{"codeLine":5,"narration":"Scan right over h[1..6], the tallest is rightMax = 4. (Blue dashed line is the RIGHT wall.)","pointers":[{"name":"i","index":1,"color":"ink"}],"highlights":[1],"vars":[["i",1],["leftMax",2],["rightMax",4],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[{"id":"leftWall","y":2,"xStart":0,"xEnd":2,"color":"red","label":"leftMax = 2"},{"id":"rightWall","y":4,"xStart":1,"xEnd":7,"color":"blue","label":"rightMax = 4"}]},{"codeLine":6,"narration":"cap = min(2, 4) = 2. (Gold line is the water surface, the SHORTER wall sets it.) water[1] = 2 − 0 = 2.","pointers":[{"name":"i","index":1,"color":"ink"}],"highlights":[1],"vars":[["i",1],["leftMax",2],["rightMax",4],["cap",2],["water[i]",2],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[{"id":"leftWall","y":2,"xStart":0,"xEnd":2,"color":"red","label":"leftMax = 2"},{"id":"rightWall","y":4,"xStart":1,"xEnd":7,"color":"blue","label":"rightMax = 4"},{"id":"cap","y":2,"xStart":0,"xEnd":7,"color":"gold","label":"cap = 2","style":"solid"}]},{"codeLine":7,"narration":"Water settles above column 1. total = 2.","pointers":[{"name":"i","index":1,"color":"ink"}],"highlights":[1],"vars":[["i",1],["water[i]",2],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"cap","y":2,"xStart":1,"xEnd":2,"color":"gold","label":"+2","style":"solid"}]},{"codeLine":4,"narration":"Column 2 (h[2] = 4). Scan left over h[0..2], the tallest bar is leftMax = 4. (Red dashed line is the LEFT wall.)","pointers":[{"name":"i","index":2,"color":"ink"}],"highlights":[2],"vars":[["i",2],["h[i]",4],["leftMax",4],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 4"}]},{"codeLine":5,"narration":"Scan right over h[2..6], the tallest is rightMax = 4. (Blue dashed line is the RIGHT wall.)","pointers":[{"name":"i","index":2,"color":"ink"}],"highlights":[2],"vars":[["i",2],["leftMax",4],["rightMax",4],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 4"},{"id":"rightWall","y":4,"xStart":2,"xEnd":7,"color":"blue","label":"rightMax = 4"}]},{"codeLine":6,"narration":"cap = min(4, 4) = 4. h[2] = 4 already reaches the cap, so water[2] = 0. This column is a wall, not a valley.","pointers":[{"name":"i","index":2,"color":"ink"}],"highlights":[2],"vars":[["i",2],["leftMax",4],["rightMax",4],["cap",4],["water[i]",0],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 4"},{"id":"rightWall","y":4,"xStart":2,"xEnd":7,"color":"blue","label":"rightMax = 4"},{"id":"cap","y":4,"xStart":0,"xEnd":7,"color":"gold","label":"cap = 4","style":"solid"}]},{"codeLine":7,"narration":"Nothing to settle (column 2 hits the cap). total = 2.","pointers":[{"name":"i","index":2,"color":"ink"}],"highlights":[2],"vars":[["i",2],["water[i]",0],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"cap","y":4,"xStart":2,"xEnd":3,"color":"gold","label":"+0","style":"solid"}]},{"codeLine":4,"narration":"Column 3 (h[3] = 1). Scan left over h[0..3], the tallest bar is leftMax = 4. (Red dashed line is the LEFT wall.)","pointers":[{"name":"i","index":3,"color":"ink"}],"highlights":[3],"vars":[["i",3],["h[i]",1],["leftMax",4],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":4,"color":"red","label":"leftMax = 4"}]},{"codeLine":5,"narration":"Scan right over h[3..6], the tallest is rightMax = 3. (Blue dashed line is the RIGHT wall.)","pointers":[{"name":"i","index":3,"color":"ink"}],"highlights":[3],"vars":[["i",3],["leftMax",4],["rightMax",3],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":4,"color":"red","label":"leftMax = 4"},{"id":"rightWall","y":3,"xStart":3,"xEnd":7,"color":"blue","label":"rightMax = 3"}]},{"codeLine":6,"narration":"cap = min(4, 3) = 3. (Gold line is the water surface, the SHORTER wall sets it.) water[3] = 3 − 1 = 2.","pointers":[{"name":"i","index":3,"color":"ink"}],"highlights":[3],"vars":[["i",3],["leftMax",4],["rightMax",3],["cap",3],["water[i]",2],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":4,"color":"red","label":"leftMax = 4"},{"id":"rightWall","y":3,"xStart":3,"xEnd":7,"color":"blue","label":"rightMax = 3"},{"id":"cap","y":3,"xStart":0,"xEnd":7,"color":"gold","label":"cap = 3","style":"solid"}]},{"codeLine":7,"narration":"Water settles above column 3. total = 4.","pointers":[{"name":"i","index":3,"color":"ink"}],"highlights":[3],"vars":[["i",3],["water[i]",2],["total",4]],"waterColumns":[0,2,0,2,0,0,0],"levels":[{"id":"cap","y":3,"xStart":3,"xEnd":4,"color":"gold","label":"+2","style":"solid"}]},{"codeLine":4,"narration":"Column 4 (h[4] = 0). Scan left over h[0..4], the tallest bar is leftMax = 4. (Red dashed line is the LEFT wall.)","pointers":[{"name":"i","index":4,"color":"ink"}],"highlights":[4],"vars":[["i",4],["h[i]",0],["leftMax",4],["total",4]],"waterColumns":[0,2,0,2,0,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":5,"color":"red","label":"leftMax = 4"}]},{"codeLine":5,"narration":"Scan right over h[4..6], the tallest is rightMax = 3. (Blue dashed line is the RIGHT wall.)","pointers":[{"name":"i","index":4,"color":"ink"}],"highlights":[4],"vars":[["i",4],["leftMax",4],["rightMax",3],["total",4]],"waterColumns":[0,2,0,2,0,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":5,"color":"red","label":"leftMax = 4"},{"id":"rightWall","y":3,"xStart":4,"xEnd":7,"color":"blue","label":"rightMax = 3"}]},{"codeLine":6,"narration":"cap = min(4, 3) = 3. (Gold line is the water surface, the SHORTER wall sets it.) water[4] = 3 − 0 = 3.","pointers":[{"name":"i","index":4,"color":"ink"}],"highlights":[4],"vars":[["i",4],["leftMax",4],["rightMax",3],["cap",3],["water[i]",3],["total",4]],"waterColumns":[0,2,0,2,0,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":5,"color":"red","label":"leftMax = 4"},{"id":"rightWall","y":3,"xStart":4,"xEnd":7,"color":"blue","label":"rightMax = 3"},{"id":"cap","y":3,"xStart":0,"xEnd":7,"color":"gold","label":"cap = 3","style":"solid"}]},{"codeLine":7,"narration":"Water settles above column 4. total = 7.","pointers":[{"name":"i","index":4,"color":"ink"}],"highlights":[4],"vars":[["i",4],["water[i]",3],["total",7]],"waterColumns":[0,2,0,2,3,0,0],"levels":[{"id":"cap","y":3,"xStart":4,"xEnd":5,"color":"gold","label":"+3","style":"solid"}]},{"codeLine":4,"narration":"Column 5 (h[5] = 3). Scan left over h[0..5], the tallest bar is leftMax = 4. (Red dashed line is the LEFT wall.)","pointers":[{"name":"i","index":5,"color":"ink"}],"highlights":[5],"vars":[["i",5],["h[i]",3],["leftMax",4],["total",7]],"waterColumns":[0,2,0,2,3,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":6,"color":"red","label":"leftMax = 4"}]},{"codeLine":5,"narration":"Scan right over h[5..6], the tallest is rightMax = 3. (Blue dashed line is the RIGHT wall.)","pointers":[{"name":"i","index":5,"color":"ink"}],"highlights":[5],"vars":[["i",5],["leftMax",4],["rightMax",3],["total",7]],"waterColumns":[0,2,0,2,3,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":6,"color":"red","label":"leftMax = 4"},{"id":"rightWall","y":3,"xStart":5,"xEnd":7,"color":"blue","label":"rightMax = 3"}]},{"codeLine":6,"narration":"cap = min(4, 3) = 3. h[5] = 3 already reaches the cap, so water[5] = 0. This column is a wall, not a valley.","pointers":[{"name":"i","index":5,"color":"ink"}],"highlights":[5],"vars":[["i",5],["leftMax",4],["rightMax",3],["cap",3],["water[i]",0],["total",7]],"waterColumns":[0,2,0,2,3,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":6,"color":"red","label":"leftMax = 4"},{"id":"rightWall","y":3,"xStart":5,"xEnd":7,"color":"blue","label":"rightMax = 3"},{"id":"cap","y":3,"xStart":0,"xEnd":7,"color":"gold","label":"cap = 3","style":"solid"}]},{"codeLine":7,"narration":"Nothing to settle (column 5 hits the cap). total = 7.","pointers":[{"name":"i","index":5,"color":"ink"}],"highlights":[5],"vars":[["i",5],["water[i]",0],["total",7]],"waterColumns":[0,2,0,2,3,0,0],"levels":[{"id":"cap","y":3,"xStart":5,"xEnd":6,"color":"gold","label":"+0","style":"solid"}]},{"codeLine":4,"narration":"Column 6 (h[6] = 1). Scan left over h[0..6], the tallest bar is leftMax = 4. (Red dashed line is the LEFT wall.)","pointers":[{"name":"i","index":6,"color":"ink"}],"highlights":[6],"vars":[["i",6],["h[i]",1],["leftMax",4],["total",7]],"waterColumns":[0,2,0,2,3,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":7,"color":"red","label":"leftMax = 4"}]},{"codeLine":5,"narration":"Scan right over h[6..6], the tallest is rightMax = 1. (Blue dashed line is the RIGHT wall.)","pointers":[{"name":"i","index":6,"color":"ink"}],"highlights":[6],"vars":[["i",6],["leftMax",4],["rightMax",1],["total",7]],"waterColumns":[0,2,0,2,3,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":7,"color":"red","label":"leftMax = 4"},{"id":"rightWall","y":1,"xStart":6,"xEnd":7,"color":"blue","label":"rightMax = 1"}]},{"codeLine":6,"narration":"cap = min(4, 1) = 1. h[6] = 1 already reaches the cap, so water[6] = 0. This column is a wall, not a valley.","pointers":[{"name":"i","index":6,"color":"ink"}],"highlights":[6],"vars":[["i",6],["leftMax",4],["rightMax",1],["cap",1],["water[i]",0],["total",7]],"waterColumns":[0,2,0,2,3,0,0],"levels":[{"id":"leftWall","y":4,"xStart":0,"xEnd":7,"color":"red","label":"leftMax = 4"},{"id":"rightWall","y":1,"xStart":6,"xEnd":7,"color":"blue","label":"rightMax = 1"},{"id":"cap","y":1,"xStart":0,"xEnd":7,"color":"gold","label":"cap = 1","style":"solid"}]},{"codeLine":7,"narration":"Nothing to settle (column 6 hits the cap). total = 7.","pointers":[{"name":"i","index":6,"color":"ink"}],"highlights":[6],"vars":[["i",6],["water[i]",0],["total",7]],"waterColumns":[0,2,0,2,3,0,0],"levels":[{"id":"cap","y":1,"xStart":6,"xEnd":7,"color":"gold","label":"+0","style":"solid"}]},{"codeLine":8,"narration":"Done. total = 7. Each column did a full left-scan and right-scan → O(n²) time. Notice we re-walked the SAME bars for every column. Can we compute maxL and maxR once?","vars":[["time","O(n²)"],["space","O(1)"],["total",7]],"waterColumns":[0,2,0,2,3,0,0]}]},{"label":"Better · precompute maxL[] and maxR[] arrays","complexity":{"time":"O(n)","space":"O(n)"},"pseudocode":["given h[]","maxL ← array of size n","maxL[0] = h[0]","for i ← 1 to n − 1:","    maxL[i] = max(maxL[i − 1], h[i])","maxR ← array of size n","maxR[n − 1] = h[n − 1]","for i ← n − 2 down to 0:","    maxR[i] = max(maxR[i + 1], h[i])","total ← 0","for i ← 0 to n − 1:","    total += max(0, min(maxL[i], maxR[i]) − h[i])","return total"],"steps":[{"codeLine":1,"narration":"The brute approach re-scanned for every column. Idea: compute maxL[] in ONE left-to-right pass and maxR[] in ONE right-to-left pass. Then one more pass to settle water. Three passes total → O(n).","vars":[["n",7],["plan","maxL[] + maxR[] + water[]"]]},{"codeLine":4,"narration":"Pass 1: build maxL[]. maxL[0] = h[0] = 2. The leftMax line starts here.","pointers":[{"name":"i","index":0,"color":"accent"}],"highlights":[0],"vars":[["phase","pass 1: maxL[]"],["i",0],["maxL[i]",2]],"aux":{"label":"maxL[]","values":[2,0,0,0,0,0,0],"highlights":[0]},"levels":[{"id":"leftMaxBuild","y":2,"xStart":0,"xEnd":1,"color":"red","label":"maxL[0]=2"}]},{"codeLine":5,"narration":"i = 1: h[1] = 0 ≤ maxL[0] = 2. maxL[1] = 2, same as before.","pointers":[{"name":"i","index":1,"color":"accent"}],"highlights":[1],"vars":[["i",1],["h[i]",0],["maxL[i-1]",2],["maxL[i]",2]],"aux":{"label":"maxL[]","values":[2,2,0,0,0,0,0],"highlights":[1],"dimmed":[2,3,4,5,6]},"levels":[{"id":"maxL-0","y":2,"xStart":0,"xEnd":1,"color":"red"},{"id":"maxL-1","y":2,"xStart":1,"xEnd":2,"color":"red","label":"maxL[1]=2"}]},{"codeLine":5,"narration":"i = 2: h[2] = 4 > maxL[1] = 2. maxL[2] = 4, the wall lifts.","pointers":[{"name":"i","index":2,"color":"accent"}],"highlights":[2],"vars":[["i",2],["h[i]",4],["maxL[i-1]",2],["maxL[i]",4]],"aux":{"label":"maxL[]","values":[2,2,4,0,0,0,0],"highlights":[2],"dimmed":[3,4,5,6]},"levels":[{"id":"maxL-0","y":2,"xStart":0,"xEnd":1,"color":"red"},{"id":"maxL-1","y":2,"xStart":1,"xEnd":2,"color":"red"},{"id":"maxL-2","y":4,"xStart":2,"xEnd":3,"color":"red","label":"maxL[2]=4"}]},{"codeLine":5,"narration":"i = 3: h[3] = 1 ≤ maxL[2] = 4. maxL[3] = 4, same as before.","pointers":[{"name":"i","index":3,"color":"accent"}],"highlights":[3],"vars":[["i",3],["h[i]",1],["maxL[i-1]",4],["maxL[i]",4]],"aux":{"label":"maxL[]","values":[2,2,4,4,0,0,0],"highlights":[3],"dimmed":[4,5,6]},"levels":[{"id":"maxL-0","y":2,"xStart":0,"xEnd":1,"color":"red"},{"id":"maxL-1","y":2,"xStart":1,"xEnd":2,"color":"red"},{"id":"maxL-2","y":4,"xStart":2,"xEnd":3,"color":"red"},{"id":"maxL-3","y":4,"xStart":3,"xEnd":4,"color":"red","label":"maxL[3]=4"}]},{"codeLine":5,"narration":"i = 4: h[4] = 0 ≤ maxL[3] = 4. maxL[4] = 4, same as before.","pointers":[{"name":"i","index":4,"color":"accent"}],"highlights":[4],"vars":[["i",4],["h[i]",0],["maxL[i-1]",4],["maxL[i]",4]],"aux":{"label":"maxL[]","values":[2,2,4,4,4,0,0],"highlights":[4],"dimmed":[5,6]},"levels":[{"id":"maxL-0","y":2,"xStart":0,"xEnd":1,"color":"red"},{"id":"maxL-1","y":2,"xStart":1,"xEnd":2,"color":"red"},{"id":"maxL-2","y":4,"xStart":2,"xEnd":3,"color":"red"},{"id":"maxL-3","y":4,"xStart":3,"xEnd":4,"color":"red"},{"id":"maxL-4","y":4,"xStart":4,"xEnd":5,"color":"red","label":"maxL[4]=4"}]},{"codeLine":5,"narration":"i = 5: h[5] = 3 ≤ maxL[4] = 4. maxL[5] = 4, same as before.","pointers":[{"name":"i","index":5,"color":"accent"}],"highlights":[5],"vars":[["i",5],["h[i]",3],["maxL[i-1]",4],["maxL[i]",4]],"aux":{"label":"maxL[]","values":[2,2,4,4,4,4,0],"highlights":[5],"dimmed":[6]},"levels":[{"id":"maxL-0","y":2,"xStart":0,"xEnd":1,"color":"red"},{"id":"maxL-1","y":2,"xStart":1,"xEnd":2,"color":"red"},{"id":"maxL-2","y":4,"xStart":2,"xEnd":3,"color":"red"},{"id":"maxL-3","y":4,"xStart":3,"xEnd":4,"color":"red"},{"id":"maxL-4","y":4,"xStart":4,"xEnd":5,"color":"red"},{"id":"maxL-5","y":4,"xStart":5,"xEnd":6,"color":"red","label":"maxL[5]=4"}]},{"codeLine":5,"narration":"i = 6: h[6] = 1 ≤ maxL[5] = 4. maxL[6] = 4, same as before.","pointers":[{"name":"i","index":6,"color":"accent"}],"highlights":[6],"vars":[["i",6],["h[i]",1],["maxL[i-1]",4],["maxL[i]",4]],"aux":{"label":"maxL[]","values":[2,2,4,4,4,4,4],"highlights":[6],"dimmed":[]},"levels":[{"id":"maxL-0","y":2,"xStart":0,"xEnd":1,"color":"red"},{"id":"maxL-1","y":2,"xStart":1,"xEnd":2,"color":"red"},{"id":"maxL-2","y":4,"xS