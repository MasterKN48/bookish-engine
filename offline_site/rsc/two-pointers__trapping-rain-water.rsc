,2,3,0,0],"levels":[{"id":"maxL-0","y":2,"xStart":0,"xEnd":1,"color":"red","label":"$undefined"},{"id":"maxL-1","y":2,"xStart":1,"xEnd":2,"color":"red","label":"$undefined"},{"id":"maxL-2","y":4,"xStart":2,"xEnd":3,"color":"red","label":"$undefined"},{"id":"maxL-3","y":4,"xStart":3,"xEnd":4,"color":"red","label":"$undefined"},{"id":"maxL-4","y":4,"xStart":4,"xEnd":5,"color":"red","label":"$undefined"},{"id":"maxL-5","y":4,"xStart":5,"xEnd":6,"color":"red","label":"$undefined"},{"id":"maxL-6","y":4,"xStart":6,"xEnd":7,"color":"red","label":"$undefined"},{"id":"maxR-0","y":4,"xStart":0,"xEnd":1,"color":"blue","label":"$undefined"},{"id":"maxR-1","y":4,"xStart":1,"xEnd":2,"color":"blue","label":"$undefined"},{"id":"maxR-2","y":4,"xStart":2,"xEnd":3,"color":"blue","label":"$undefined"},{"id":"maxR-3","y":3,"xStart":3,"xEnd":4,"color":"blue","label":"$undefined"},{"id":"maxR-4","y":3,"xStart":4,"xEnd":5,"color":"blue","label":"$undefined"},{"id":"maxR-5","y":3,"xStart":5,"xEnd":6,"color":"blue","label":"$undefined"},{"id":"maxR-6","y":1,"xStart":6,"xEnd":7,"color":"blue","label":"$undefined"}]},{"codeLine":12,"narration":"Done. total = 7. Three single passes → O(n) time, O(n) space (for maxL[] and maxR[]). Can we get rid of those two arrays?","vars":[["time","O(n)"],["space","O(n)"],["total",7]],"waterColumns":[0,2,0,2,3,0,0],"levels":[{"id":"maxL-0","y":2,"xStart":0,"xEnd":1,"color":"red","label":"$undefined"},{"id":"maxL-1","y":2,"xStart":1,"xEnd":2,"color":"red","label":"$undefined"},{"id":"maxL-2","y":4,"xStart":2,"xEnd":3,"color":"red","label":"$undefined"},{"id":"maxL-3","y":4,"xStart":3,"xEnd":4,"color":"red","label":"$undefined"},{"id":"maxL-4","y":4,"xStart":4,"xEnd":5,"color":"red","label":"$undefined"},{"id":"maxL-5","y":4,"xStart":5,"xEnd":6,"color":"red","label":"$undefined"},{"id":"maxL-6","y":4,"xStart":6,"xEnd":7,"color":"red","label":"$undefined"},{"id":"maxR-0","y":4,"xStart":0,"xEnd":1,"color":"blue","label":"$undefined"},{"id":"maxR-1","y":4,"xStart":1,"xEnd":2,"color":"blue","label":"$undefined"},{"id":"maxR-2","y":4,"xStart":2,"xEnd":3,"color":"blue","label":"$undefined"},{"id":"maxR-3","y":3,"xStart":3,"xEnd":4,"color":"blue","label":"$undefined"},{"id":"maxR-4","y":3,"xStart":4,"xEnd":5,"color":"blue","label":"$undefined"},{"id":"maxR-5","y":3,"xStart":5,"xEnd":6,"color":"blue","label":"$undefined"},{"id":"maxR-6","y":1,"xStart":6,"xEnd":7,"color":"blue","label":"$undefined"}]}]},{"label":"Optimized · two pointers, O(1) space","complexity":{"time":"O(n)","space":"O(1)"},"pseudocode":["given h[]","left ← 0; right ← n − 1","leftMax ← 0; rightMax ← 0; total ← 0","while left < right:","    if h[left] < h[right]:","        if h[left] ≥ leftMax: leftMax = h[left]","        else: total += leftMax − h[left]","        left++","    else:","        if h[right] ≥ rightMax: rightMax = h[right]","        else: total += rightMax − h[right]","        right−−","return total"],"steps":[{"codeLine":1,"narration":"Better idea: we only need to know which side is the BOTTLENECK at each step. Use two pointers walking inward, track the leftMax seen so far (red line) and rightMax (blue line).","vars":[["n",7]]},{"codeLine":1,"narration":"Key insight: if h[left] < h[right], then the right side has a wall ≥ h[right] > h[left]. So leftMax (whatever it is) is the BINDING cap on column left, settle it NOW. Symmetric on the other side.","vars":[["rule","settle the smaller side"]]},{"codeLine":2,"narration":"Init: left = 0, right = n − 1, leftMax = 0, rightMax = 0, total = 0.","pointers":[{"name":"left","index":0,"color":"accent"},{"name":"right","index":6,"color":"accent2"}],"vars":[["left",0],["right",6],["leftMax",0],["rightMax",0],["total",0]]},{"codeLine":4,"narration":"Iter 1: h[left=0] = 2, h[right=6] = 1. 2 ≥ 1 → settle the RIGHT side.","pointers":[{"name":"left","index":0,"color":"accent"},{"name":"right","index":6,"color":"accent2"}],"highlights":[0,6],"vars":[["left",0],["right",6],["h[left]",2],["h[right]",1],["leftMax",0],["rightMax",0],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[]},{"codeLine":10,"narration":"h[right] = 1 ≥ rightMax = 0. This column IS the new right wall. rightMax ← 1. (Blue line lifts.)","pointers":[{"name":"left","index":0,"color":"accent"},{"name":"right","index":6,"color":"accent2"}],"highlights":[6],"vars":[["right",6],["h[right]",1],["rightMax",1],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[{"id":"rightMaxLine","y":1,"xStart":6,"xEnd":7,"color":"blue","label":"rightMax = 1"}]},{"codeLine":12,"narration":"right−− → 5. The blue wall now extends through column 6.","pointers":[{"name":"left","index":0,"color":"accent"},{"name":"right","index":5,"color":"accent2"}],"vars":[["left",0],["right",5],["rightMax",1],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[{"id":"rightMaxLine","y":1,"xStart":5,"xEnd":7,"color":"blue","label":"rightMax = 1"}]},{"codeLine":4,"narration":"Iter 2: h[left=0] = 2, h[right=5] = 3. 2 < 3 → settle the LEFT side.","pointers":[{"name":"left","index":0,"color":"accent"},{"name":"right","index":5,"color":"accent2"}],"highlights":[0,5],"vars":[["left",0],["right",5],["h[left]",2],["h[right]",3],["leftMax",0],["rightMax",1],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[{"id":"rightMaxLine","y":1,"xStart":5,"xEnd":7,"color":"blue","label":"rightMax = 1"}]},{"codeLine":6,"narration":"h[left] = 2 ≥ leftMax = 0. This column IS the new left wall, no water sits on it. leftMax ← 2. (Red line lifts.)","pointers":[{"name":"left","index":0,"color":"accent"},{"name":"right","index":5,"color":"accent2"}],"highlights":[0],"vars":[["left",0],["h[left]",2],["leftMax",2],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":1,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":1,"xStart":5,"xEnd":7,"color":"blue","label":"rightMax = 1"}]},{"codeLine":8,"narration":"left++ → 1. The red wall now extends through column 0.","pointers":[{"name":"left","index":1,"color":"accent"},{"name":"right","index":5,"color":"accent2"}],"vars":[["left",1],["right",5],["leftMax",2],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":2,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":1,"xStart":5,"xEnd":7,"color":"blue","label":"rightMax = 1"}]},{"codeLine":4,"narration":"Iter 3: h[left=1] = 0, h[right=5] = 3. 0 < 3 → settle the LEFT side.","pointers":[{"name":"left","index":1,"color":"accent"},{"name":"right","index":5,"color":"accent2"}],"highlights":[1,5],"vars":[["left",1],["right",5],["h[left]",0],["h[right]",3],["leftMax",2],["rightMax",1],["total",0]],"waterColumns":[0,0,0,0,0,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":2,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":1,"xStart":5,"xEnd":7,"color":"blue","label":"rightMax = 1"}]},{"codeLine":7,"narration":"h[left] = 0 < leftMax = 2. Water settles above column 1: leftMax − h[left] = 2 − 0 = 2. total = 2.","pointers":[{"name":"left","index":1,"color":"accent"},{"name":"right","index":5,"color":"accent2"}],"highlights":[1],"vars":[["left",1],["h[left]",0],["leftMax",2],["water[left]",2],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":2,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":1,"xStart":5,"xEnd":7,"color":"blue","label":"rightMax = 1"}]},{"codeLine":8,"narration":"left++ → 2. The red wall now extends through column 1.","pointers":[{"name":"left","index":2,"color":"accent"},{"name":"right","index":5,"color":"accent2"}],"vars":[["left",2],["right",5],["leftMax",2],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":1,"xStart":5,"xEnd":7,"color":"blue","label":"rightMax = 1"}]},{"codeLine":4,"narration":"Iter 4: h[left=2] = 4, h[right=5] = 3. 4 ≥ 3 → settle the RIGHT side.","pointers":[{"name":"left","index":2,"color":"accent"},{"name":"right","index":5,"color":"accent2"}],"highlights":[2,5],"vars":[["left",2],["right",5],["h[left]",4],["h[right]",3],["leftMax",2],["rightMax",1],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":1,"xStart":5,"xEnd":7,"color":"blue","label":"rightMax = 1"}]},{"codeLine":10,"narration":"h[right] = 3 ≥ rightMax = 1. This column IS the new right wall. rightMax ← 3. (Blue line lifts.)","pointers":[{"name":"left","index":2,"color":"accent"},{"name":"right","index":5,"color":"accent2"}],"highlights":[5],"vars":[["right",5],["h[right]",3],["rightMax",3],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":3,"xStart":5,"xEnd":7,"color":"blue","label":"rightMax = 3"}]},{"codeLine":12,"narration":"right−− → 4. The blue wall now extends through column 5.","pointers":[{"name":"left","index":2,"color":"accent"},{"name":"right","index":4,"color":"accent2"}],"vars":[["left",2],["right",4],["rightMax",3],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":3,"xStart":4,"xEnd":7,"color":"blue","label":"rightMax = 3"}]},{"codeLine":4,"narration":"Iter 5: h[left=2] = 4, h[right=4] = 0. 4 ≥ 0 → settle the RIGHT side.","pointers":[{"name":"left","index":2,"color":"accent"},{"name":"right","index":4,"color":"accent2"}],"highlights":[2,4],"vars":[["left",2],["right",4],["h[left]",4],["h[right]",0],["leftMax",2],["rightMax",3],["total",2]],"waterColumns":[0,2,0,0,0,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":3,"xStart":4,"xEnd":7,"color":"blue","label":"rightMax = 3"}]},{"codeLine":11,"narration":"h[right] = 0 < rightMax = 3. Water settles above column 4: 3 − 0 = 3. total = 5.","pointers":[{"name":"left","index":2,"color":"accent"},{"name":"right","index":4,"color":"accent2"}],"highlights":[4],"vars":[["right",4],["h[right]",0],["rightMax",3],["water[right]",3],["total",5]],"waterColumns":[0,2,0,0,3,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":3,"xStart":4,"xEnd":7,"color":"blue","label":"rightMax = 3"}]},{"codeLine":12,"narration":"right−− → 3. The blue wall now extends through column 4.","pointers":[{"name":"left","index":2,"color":"accent"},{"name":"right","index":3,"color":"accent2"}],"vars":[["left",2],["right",3],["rightMax",3],["total",5]],"waterColumns":[0,2,0,0,3,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":3,"xStart":3,"xEnd":7,"color":"blue","label":"rightMax = 3"}]},{"codeLine":4,"narration":"Iter 6: h[left=2] = 4, h[right=3] = 1. 4 ≥ 1 → settle the RIGHT side.","pointers":[{"name":"left","index":2,"color":"accent"},{"name":"right","index":3,"color":"accent2"}],"highlights":[2,3],"vars":[["left",2],["right",3],["h[left]",4],["h[right]",1],["leftMax",2],["rightMax",3],["total",5]],"waterColumns":[0,2,0,0,3,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":3,"xStart":3,"xEnd":7,"color":"blue","label":"rightMax = 3"}]},{"codeLine":11,"narration":"h[right] = 1 < rightMax = 3. Water settles above column 3: 3 − 1 = 2. total = 7.","pointers":[{"name":"left","index":2,"color":"accent"},{"name":"right","index":3,"color":"accent2"}],"highlights":[3],"vars":[["right",3],["h[right]",1],["rightMax",3],["water[right]",2],["total",7]],"waterColumns":[0,2,0,2,3,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":3,"xStart":3,"xEnd":7,"color":"blue","label":"rightMax = 3"}]},{"codeLine":12,"narration":"right−− → 2. The blue wall now extends through column 3.","pointers":[{"name":"left","index":2,"color":"accent"},{"name":"right","index":2,"color":"accent2"}],"vars":[["left",2],["right",2],["rightMax",3],["total",7]],"waterColumns":[0,2,0,2,3,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":3,"xStart":2,"xEnd":7,"color":"blue","label":"rightMax = 3"}]},{"codeLine":13,"narration":"left met right. One pass, each step advanced one pointer → O(n) time, O(1) extra space. Total water = 7. Each side settled the moment IT was the shorter one, we never needed to know the global max on the other side.","vars":[["time","O(n)"],["space","O(1)"],["total",7]],"waterColumns":[0,2,0,2,3,0,0],"levels":[{"id":"leftMaxLine","y":2,"xStart":0,"xEnd":3,"color":"red","label":"leftMax = 2"},{"id":"rightMaxLine","y":3,"xStart":2,"xEnd":7,"color":"blue","label":"rightMax = 3"}]}]}]},"patternTitle":"Two Pointers"}]
