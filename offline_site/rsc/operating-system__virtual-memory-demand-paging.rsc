1b:{"metadata":[["$","title","0",{"children":"Virtual Memory & Demand Paging: Operating Systems"}],["$","meta","1",{"name":"description","content":"How a machine runs programs far larger than its RAM by keeping only the pages you actually touch in memory, and fetching the rest from disk, one fault at a time"}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}],["$","link","3",{"rel":"icon","href":"/icon.png?5dbc1fad7703bc98","type":"image/png","sizes":"512x512"}],["$","link","4",{"rel":"apple-touch-icon","href":"/apple-icon.png?375f5bf186e6939a","type":"image/png","sizes":"180x180"}],["$","$L4e","5",{}]],"error":null,"digest":"$undefined"}
