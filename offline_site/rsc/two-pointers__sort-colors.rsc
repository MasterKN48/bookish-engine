10:{"metadata":[["$","title","0",{"children":"Chai Prep: Your preparation ground for interviews"}],["$","meta","1",{"name":"description","content":"Chai Prep is your preparation ground for software interviews: visual courses, notes, video courses, practice sheets, timed aptitude mocks and AI interview rounds, in one place. For students, job switchers, colleges and companies."}],["$","link","2",{"rel":"icon","href":"/icon.png?5dbc1fad7703bc98","type":"image/png","sizes":"512x512"}],["$","link","3",{"rel":"apple-touch-icon","href":"/apple-icon.png?375f5bf186e6939a","type":"image/png","sizes":"180x180"}],["$","$L1b","4",{}]],"error":null,"digest":"$undefined"}
