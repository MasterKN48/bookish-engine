2a:["$","section","05-termination",{"id":"05-termination","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Closing the connection"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Closing is a four-way exchange because each side shuts down its own direction independently: one side sends FIN, the other ACKs it; then the other side sends its own FIN, which gets ACKed. This lets data still flow one way while the other way is already closed."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L24",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch15%2F05-termination.jpg?v=49765b9e5cd8c4b225ff8801e924047f","alt":"FIN, ACK, FIN, ACK four-way close."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
