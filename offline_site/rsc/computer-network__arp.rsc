2a:["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Step 1: Same network?"}]
2b:["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A1 already knows A3’s IP (you always know the IP before making a request, just like a frontend knows the backend’s address after DNS). It applies the subnet mask to its own IP and to A3’s: both give 192.168.1.0. Same network → A1 can send directly. But to actually deliver, it first needs A3’s MAC. Enter ARP."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch09%2F04-same-network-check.jpg?v=1eb074e1693d5926a84ed73a0a0f99dd","alt":"A1 and A3 both reduce to 192.168.1.0, but A1 still needs A3’s MAC."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]
2c:["$","section","05-arp-broadcast",{"id":"05-arp-broadcast","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Step 2: ARP broadcast"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A1 sends an ARP request as a broadcast, it goes to every device on the network (A2, A3, and the router all receive it). The request asks: \"Who has 192.168.1.4? Tell me your MAC.\" (Compare: DNS asking \"what is the IP of api.example.com?\")"}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch09%2F05-arp-broadcast.jpg?v=d99ceeea36bb0a05bb4b4fcf10d2e9e0","alt":"A1 broadcasts \"who has 192.168.1.4?\" to A2, A3 and the router."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
2d:["$","section","06-only-owner-replies",{"id":"06-only-owner-replies","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Step 3: Only the owner replies"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Every device checks the requested IP against its own. A2 and the router do not match, so they ignore the request. Only A3, the actual owner of 192.168.1.4, replies, sending back its MAC address."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch09%2F06-only-owner-replies.jpg?v=0edf8474b3cff9a10195536131d222f6","alt":"A2 and the router ignore it; A3 replies with its MAC."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
2e:["$","section","07-arp-table",{"id":"07-arp-table","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"07"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The ARP table (cache)"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Every device keeps an ARP table in cache memory, a simple key-value map of IP → MAC. Initially a device’s table holds just its own IP↔MAC (which is how A3 knew what to answer). When A1 gets A3’s reply, it caches the 192.168.1.4 → MAC entry so it can skip the broadcast next time."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Why cache?",": "]}],"Re-broadcasting for every packet would be wasteful. The cache makes repeat sends instant."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch09%2F07-arp-table.jpg?v=685ab36c0225482d1d1590a28b870f72","alt":"A key-value IP|MAC table; A1 caches 192.168.1.4 → its MAC."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
2f:["$","section","08-out-of-network",{"id":"08-out-of-network","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"08"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Out-of-network case"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"What if the target (say 10.0.0.1) is not on the network? The mask check fails, so A1 must send to its default gateway. A1 already knows the gateway’s IP (pre-configured on every machine). So it ARP-broadcasts for the gateway’s IP, and this time only the router replies with its MAC. A1 then uses that MAC to hand the packet to the router."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch09%2F08-out-of-network.jpg?v=af8f49301dae331a1aeb3c5d621b7eb7","alt":"For a non-local target, A1 ARPs for the gateway’s IP; only the router replies."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
30:["$","section","09-arp-a",{"id":"09-arp-a","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"09"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"See it yourself: arp -a"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"This is not abstract, you can inspect your own ARP table right now. On macOS/Linux, run arp -a in a terminal. You will see the IP-to-MAC entries your machine has cached, including your router/default gateway’s IP and MAC."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Try it",": "]}],"Run arp -a after browsing for a bit, you will see entries your machine learned via exactly the broadcast-and-reply process above."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch09%2F09-arp-a.jpg?v=d449aaf8a626c9e20867c4451f13e314","alt":"A terminal running arp -a listing IP → MAC entries including the gateway."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
