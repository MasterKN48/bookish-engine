27:["$","section","04-intra-send",{"id":"04-intra-send","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"A1 → A3: direct delivery"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Because they are on the same network, A1 sends straight to A3, the router is not needed for this one. (In practice a switch inside the network helps, with negligible latency.)"}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Intra-network",": "]}],"Same network = direct delivery. The gateway sits idle."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch06%2F04-intra-send.jpg?v=1f716eb15e4729604d8a1fc2afab9d17","alt":"A1 sends straight to A3 inside Network A, router unused."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
28:["$","section","05-inter-calc",{"id":"05-inter-calc","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"A1 → B3: run the mask"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Now A1 wants to reach B3 (192.168.2.4). A1 ANDs B3’s IP with the mask → 192.168.2.0, which does not equal A1’s own 192.168.1.0. Different networks: A1 cannot deliver this directly."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch06%2F05-inter-calc.jpg?v=c136a2d6aa7d1cb3538fb5d791c2e1b3","alt":"A1 reduces to 192.168.1.0 but B3 reduces to 192.168.2.0, different networks."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
29:["$","section","06-inter-send",{"id":"06-inter-send","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"A1 → B3: via the gateway"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"So A1 forwards the packet to its default gateway (the router), essentially saying \"I do not know where this IP is.\" The router looks at its interfaces, sees that Network B is on its other interface, and forwards the packet through to B3."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Inter-network",": "]}],"Different networks = hand to the gateway, which bridges the two sides."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch06%2F06-inter-send.jpg?v=f4d1e02ed0e393496508cd93a2f540d3","alt":"A1 sends to the router, which forwards through its second interface into Network B to reach B3."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
2a:["$","section","07-whats-next",{"id":"07-whats-next","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"07"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"What is still missing"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"We have glossed over one thing: to actually place a packet on the wire toward the next device, we need that device’s physical (MAC) address. And there is much more ahead."}],["$","dl","1",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"MAC address"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The physical address of a device’s interface, next chapter."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"ARP"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"How a device finds a MAC from an IP."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"NAT & hop-by-hop routing"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"How private networks share a public IP and how packets change at each hop."}]]}