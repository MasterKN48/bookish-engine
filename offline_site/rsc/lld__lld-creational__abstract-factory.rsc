messages":"$c:props:children:1:props:lesson:approaches:0:steps:3:sequence:messages","shownCount":3,"activeIndex":1},"vars":[["family","all-Mac, guaranteed ✓"]]},{"view":"sequence","codeLine":9,"narration":"Then it asks the SAME factory for a checkbox: makeCheckbox().","sequence":{"actors":"$c:props:children:1:props:lesson:approaches:0:steps:3:sequence:actors","messages":"$c:props:children:1:props:lesson:approaches:0:steps:3:sequence:messages","shownCount":4,"activeIndex":3}},{"view":"sequence","codeLine":9,"narration":"Because everything came from MacFactory, the button and checkbox are guaranteed to MATCH, you can never accidentally pair a Windows button with a Mac checkbox. Swap to WinFactory and the whole UI changes consistently.","sequence":{"actors":"$c:props:children:1:props:lesson:approaches:0:steps:3:sequence:actors","messages":"$c:props:children:1:props:lesson:approaches:0:steps:3:sequence:messages","shownCount":6,"activeIndex":4},"vars":[["family","all-Mac, guaranteed ✓"],["swap factory","whole UI changes"]]}]}]}}]]}]
