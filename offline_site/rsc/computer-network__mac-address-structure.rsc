22:["$","div",null,{"className":"flex min-w-0 flex-1 flex-col gap-16","children":[["$","section","01-what-is-mac",{"id":"01-what-is-mac","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"01"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"What is a MAC address?"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"MAC stands for Media Access Control. A MAC address identifies the physical location of a device, the specific network interface hardware, whereas an IP address identifies a virtual/logical location."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Two addresses",": "]}],"IP = virtual (can change, used for routing). MAC = physical (fixed, used for local delivery). Every interface has both."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L24",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch07%2F01-what-is-mac.jpg?v=a1e6c82aef665108e3ae34b454ee077f","alt":"A NIC chip tagged with a MAC address; MAC = Media Access Control."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}],["$","section","02-physical-hardware",{"id":"02-physical-hardware","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Interfaces are physical hardware"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A network interface is real hardware that needs addressing. Examples: the NIC (Network Interface Card, a chip with an antenna that emits and receives signals), the Ethernet interface (electrical signals), and Bluetooth (a short-range interface). Each physical interface carries its own MAC."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L24",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch07%2F02-physical-hardware.jpg?v=952de595dd75c539a9dcd31202e07051","alt":"A NIC with antenna, an Ethernet port, and a Bluetooth symbol."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}],["$","section","03-why-not-ip",{"id":"03-why-not-ip","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Why not just use the IP?"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"IP is virtual and mutable. Connect your laptop to the router and it might get 192.168.1.4; disconnect, power-cycle, reconnect, and it might get 192.168.1.9. Same physical device, different IP. That makes IP useless for permanently identifying a piece of hardware."}],"$L25"]}],"$L26"]}]]}],"$L27","$L28","$L29","$L2a","$L2b"]}]
