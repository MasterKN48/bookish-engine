27:["$","section","04-mac-size",{"id":"04-mac-size","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Size: 6 bytes = 48 bits"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A MAC address is always 6 bytes = 48 bits. Each byte is written as two hexadecimal digits (so FA is one byte). Six bytes × 8 bits = 48 bits. This size is constant everywhere."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L24",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch07%2F04-mac-size.jpg?v=91fac03aa309c9530fda40746e3029a1","alt":"Six bytes FA:34:AF:09:00:BA; one byte = 2 hex digits = 8 bits; total 48 bits."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
28:["$","section","05-colon-vs-dash",{"id":"05-colon-vs-dash","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Colons vs dashes"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The bytes are separated by punctuation, and the style depends on the OS: macOS and Linux use colons (FA:34:AF:09:00:BA), while Windows uses dashes (FA-34-AF-09-00-BA). Same address, different separator."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L24",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch07%2F05-colon-vs-dash.jpg?v=1636230e2b02b554020d750ca9f10eed","alt":"Mac/Linux uses colons, Windows uses dashes."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
29:["$","section","06-hex",{"id":"06-hex","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"A quick word on hexadecimal"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"MAC addresses are hexadecimal (base 16). Decimal uses 0–9, binary uses 0–1, and hex uses sixteen symbols: 0–9 then A, B, C, D, E, F. After 9, instead of rolling to two digits, you continue with letters up to F (which is 15)."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L24",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch07%2F06-hex.jpg?v=96f781148f62024a990797a7c2009b54","alt":"The 16 hex symbols 0-9 then A-F."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
2a:["$","section","07-oui-device",{"id":"07-oui-device","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"07"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Two halves: OUI + device"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A MAC address splits into two halves, much like an IP splits into network and host:"}],["$","dl","1",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"First 3 bytes: OUI"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Organizationally Unique Identifier: assigned to the manufacturer (Cisco, Intel, Apple…)."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Last 3 bytes, device"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Uniquely identifies the specific interface made by that manufacturer."}]]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L24",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch07%2F07-oui-device.jpg?v=9c5f6ec4132e8c671fd7eee1f5fa7f2a","alt":"MAC split: first 3 bytes OUI (manufacturer), last 3 bytes device/host."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
2b:["$","section","08-oui-example",{"id":"08-oui-example","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"08"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The OUI identifies the maker"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Because the OUI is fixed per manufacturer, you can identify who made a device from the first three bytes of its MAC. Two Intel NICs share the same first three bytes (their OUI) but differ in the last three (the device portion), keeping every MAC unique."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Aside",": "]}],"You rarely set MACs by hand as a developer, but the OUI-vs-device idea matters for understanding the OSI model and how delivery works."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L24",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch07%2F08-oui-example.jpg?v=4bb75067de148c05e3d21f337f1e2cf8","alt":"Two Intel NICs sharing OUI AC:DE:48 but differing in the last 3 bytes."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
