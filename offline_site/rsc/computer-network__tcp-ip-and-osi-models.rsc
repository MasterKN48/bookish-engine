22:["$","div",null,{"className":"flex min-w-0 flex-1 flex-col gap-16","children":[["$","section","01-why-layers",{"id":"01-why-layers","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"01"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Why layer the network at all?"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Networking is hard because it does many jobs at once: find the right app, deliver reliably, route across the world, and put bits on a wire. Layering splits these into separate concerns, each handled by one layer that only talks to the layers directly above and below it."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Big idea",": "]}],"Each layer has one job and trusts the layer below to do its job. You can swap WiFi for Ethernet without changing HTTP."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L24",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch10%2F01-why-layers.jpg?v=b98891e7d082905cbf3e44ca291dd840","alt":"A vertical stack of trays each passing a package down: App, Transport, Internet, Link."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}],["$","secti