1b:{"metadata":[["$","title","0",{"children":"CPU Scheduling I: The Basics: Operating Systems"}],["$","meta","1",{"name":"description","content":"Many threads want the CPU and there is only one, the rules the OS uses to decide who runs next"}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}],["$","link","3",{"rel":"icon","href":"/icon.png?5dbc1fad7703bc98","type":"image/png","sizes":"512x512"}],["$","link","4",{"rel":"apple-touch-icon","href":"/apple-icon.png?375f5bf186e6939a","type":"image/png","sizes":"180x180"}],["$","$L56","5",{}]],"error":null,"digest":"$undefined"}
