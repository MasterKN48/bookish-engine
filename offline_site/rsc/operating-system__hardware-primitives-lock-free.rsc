1b:{"metadata":[["$","title","0",{"children":"Hardware Primitives & Lock-Free Programming: Operating Systems"}],["$","meta","1",{"name":"description","content":"What is really under the lock, the atomic CPU instructions that make mutual exclusion possible, and the expert art of doing without a lock at all"}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}],["$","link","3",{"rel":"icon","href":"/icon.png?5dbc1fad7703bc98","type":"image/png","sizes":"512x512"}],["$","link","4",{"rel":"apple-touch-icon","href":"/apple-icon.png?375f5bf186e6939a","type":"image/png","sizes":"180x180"}],["$","$L49","5",{}]],"error":null,"digest":"$undefined"}
20:"$1b:metadata"
