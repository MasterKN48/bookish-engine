26:["$","section","04-sliding-window",{"id":"04-sliding-window","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The sliding window"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Picture the byte stream divided into: bytes sent and acknowledged, bytes sent but not yet acknowledged (in flight), bytes that may be sent now, and bytes that must wait. As ACKs arrive, the window slides to the right, letting new data be sent. Hence \"sliding window\"."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch18%2F04-sliding-window.jpg?v=247ff3f34653cf1509870d57fd090ba3","alt":"A window bracket over a byte stream sliding right as ACKs arrive."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
27:["$","section","05-window-scaling",{"id":"05-window-scaling","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Window scaling"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The window field is only 16 bits, capping it at 64 KB, too small for modern fast, long-distance links. The window scale option multiplies the window by a factor negotiated in the handshake, allowing much larger windows so fast links can stay full."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch18%2F05-window-scaling.jpg?v=39d306614b73510f5bae472a136fc21e","alt":"A small 64 KB window multiplied by a scale factor into a large window."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
28:["$","section","06-zero-window",{"id":"06-zero-window","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Zero window = pause"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"If the receiver’s buffer is completely full, it advertises Window = 0, telling the sender to stop. The sender periodically sends tiny \"window probes\" to ask if space has opened up, and resumes once the receiver advertises a non-zero window again."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch18%2F06-zero-window.jpg?v=e5af2038b7bc318674ba9f82a6816e3e","alt":"Receiver full advertising Window = 0; sender sends tiny probes."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
29:["$","section","07-flow-vs-congestion",{"id":"07-flow-vs-congestion","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"07"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Flow ≠ congestion"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","div","0",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Do not confuse them",": "]}],"Flow control protects the RECEIVER (its buffer). Congestion control protects the NETWORK (the links in between). Same goal of smooth delivery, different bottleneck, congestion control is next."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch18%2F07-flow-vs-congestion.jpg?v=b3112131922cb45b260cdfc7f2d3e87b","alt":"Flow control protects the receiver; congestion control protects the network."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
