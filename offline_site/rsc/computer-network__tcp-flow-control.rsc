23:["$","div",null,{"className":"flex min-w-0 flex-1 flex-col gap-16","children":[["$","section","01-problem",{"id":"01-problem","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"01"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The problem"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The receiver has a limited buffer where incoming data waits to be read by the application. If the sender pushes data faster than the app reads it, that buffer fills up and overflows, and data is lost. Flow control prevents this."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch18%2F01-problem.jpg?v=d16c3f36aedd4cdcb09ca84f78ca9d6c","alt":"A fire-hose sender overflowing a small bucket receiver."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}],["$","section","02-receive-window",{"id":"02-receive-window","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The receive window (rwnd)"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The receiver tracks how much free space is left in its buffer and calls it the receive window (rwnd). This number is the maximum amount of unacknowledged data the sender is allowed to have in flight at once."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch18%2F02-receive-window.jpg?v=10cfdd721c482a408958ffd5381c6111","alt":"The receiver buffer with free space labelled as the window."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}],["$","section","03-window-in-header",{"id":"03-window-in-header","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Advertised in every ACK"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The receiver advertises its current window in the Window field of every segment it sends back. So with each ACK the sender learns exactly how much more it may send. It must never exceed the advertised window."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch18%2F03-window-in-header.jpg?v=d5b6c9adcf0082ebd18c53f56ee10844","alt":"An ACK carrying Window = 8 KB from receiver to sender."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}],"$L26","$L27","$L28","$L29"]}]
