1b:{"metadata":[["$","title","0",{"children":"I/O Hardware & Software Layers: Operating Systems"}],["$","meta","1",{"name":"description","content":"How one read() call reaches a disk, a keyboard or a network card, and stays the same shape for all of them"}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}],["$","link","3",{"rel":"icon","href":"/icon.png?5dbc1fad7703bc98","type":"image/png","sizes":"512x512"}],["$","link","4",{"rel":"apple-touch-icon","href":"/apple-icon.png?375f5bf186e6939a","type":"image/png","sizes":"180x180"}],["$","$L51","5",{}]],"error":null,"digest":"$undefined"}
20:"$1b:metadata"
