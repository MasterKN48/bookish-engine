21:["$","section","01-what-is-ip",{"id":"01-what-is-ip","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"01"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"What is an IP address?"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"IP stands for Internet Protocol, one of the most important protocols on the internet. An IP address is the identifier a device uses to be found on a network, every device that wants to communicate gets one."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Familiar example",": "]}],"127.0.0.1 (localhost / loopback) is an IP address you have seen many times, it points back to your own machine."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch02%2F01-what-is-ip.jpg?v=062c416d71b9bba52bf222ffc0bef322","alt":"A laptop tagged with the IP 127.0.0.1."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
22:["$","section","02-dotted-quad",{"id":"02-dotted-quad","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Dotted-quad notation"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"An IPv4 address is written as four non-negative integers separated by dots, the form A.B.C.D. This is called dotted-quad (or dotted-decimal) notation."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"For example: 192.168.1.4. Four numbers, three dots."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch02%2F02-dotted-quad.jpg?v=ed92b117ccdac2cd5623787d05d85fcd","alt":"A.B.C.D template with each letter labelled integer, and the example 192.168.1.4."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
23:["$","section","03-octet",{"id":"03-octet","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Each part is an octet"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Each dot-separated number is called an octet. So 192.168.1.4 has four octets. You will often hear people talk about the \"first three octets\" versus the \"last octet\", a distinction that becomes very important when we split an IP into a network part and a host part."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Why \"octet\"?",": "]}],"Each of these numbers is stored in 8 bits, and \"octet\" literally means a group of eight."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch02%2F03-octet.jpg?v=a9951f20bfa7130e5a1bf1460a770266","alt":"192.168.1.4 with the first three numbers bracketed as first 3 octets and the last as last octet."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
24:["$","section","04-binary",{"id":"04-binary","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"An octet in binary"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Decimal (192.168.1.4) is how humans read IPs, but the machine sees binary. Each octet is an 8-bit binary number. For example, 192 in binary is 11000000, eight bits."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Getting comfortable seeing an octet as 8 bits is the single prerequisite for understanding subnet masks in a couple of chapters."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch02%2F04-binary.jpg?v=3cdc95cb2a2af1971955b3a52d721f35","alt":"192 converted to the 8-bit binary 11000000."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
25:["$","section","05-32-bit",{"id":"05-32-bit","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Why IPv4 is 32 bits"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Now the headline fact. There are 4 octets, and each octet is 8 bits. So the whole address is 8 × 4 = 32 bits, which is 4 bytes."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Remember",": "]}],"IPv4 = 32 bits = 4 bytes = 4 octets. This is why there are only about 4.3 billion (2³²) possible IPv4 addresses."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch02%2F05-32-bit.jpg?v=144a88efbc9931613399b6868724542c","alt":"Four groups of 8 bits with the equation 8 x 4 = 32 bits = 4 bytes."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
26:["$","section","06-ipv4-vs-ipv6",{"id":"06-ipv4-vs-ipv6","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"IPv4 vs IPv6 (a quick note)"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Because 32 bits ran out of room for the modern internet, IPv6 was introduced, a 128-bit address written in hexadecimal groups (like 2001:db8::1). It provides an astronomically larger address space."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["For now",": "]}],"This course focuses on IPv4 to build intuition; IPv6 gets its own chapter later. The concepts (network vs host, routing) carry over."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch02%2F06-ipv4-vs-ipv6.jpg?v=789e7368b6b2b829e3c52e1938c7ea0b","alt":"Table comparing IPv4 (32-bit) with IPv6 (128-bit)."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
