22:["$","section","02-request-structure",{"id":"02-request-structure","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Anatomy of a request"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A request has a request line (method + path + version), headers (metadata like Host and Authorization), a blank line, and an optional body. The method states intent:"}],["$","dl","1",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"GET"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Read a resource."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"POST"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Create / submit data."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"PUT / PATCH"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Update a resource."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"DELETE"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Remove a resource."}]]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch22%2F02-request-structure.jpg?v=bd1444b74eca37618dd902f7c2126449","alt":"GET /profile HTTP/1.1 with Host and Authorization headers and a body."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
23:["$","section","03-status-codes",{"id":"03-status-codes","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Status codes"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The response starts with a status code that tells you what happened, grouped by first digit: 2xx success, 3xx redirect, 4xx client error (you sent something wrong), 5xx server error (the server broke). Learning these families makes debugging APIs much faster."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch22%2F03-status-codes.jpg?v=7d0905c7cb94533ee6033b35cad7e450","alt":"2xx success, 3xx redirect, 4xx client error, 5xx server error."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
24:["$","section","04-http1",{"id":"04-http1","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"HTTP/1.1"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"HTTP/1.1 kept connections open (keep-alive) so they could be reused, which was a big improvement. But on a single connection requests are handled one at a time, a slow response blocks the ones behind it (head-of-line blocking). Browsers worked around this by opening several connections at once."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch22%2F04-http1.jpg?v=ca3289cc2f9d27384ee98e5cd0bb0b67","alt":"One connection carrying requests one at a time, with head-of-line blocking."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
25:["$","section","05-http2",{"id":"05-http2","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"HTTP/2"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"HTTP/2 introduced multiplexing: many requests and responses share a single connection as independent streams, so they no longer wait in line. It also switched to a compact binary format and compressed headers, big wins for pages that load many resources."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch22%2F05-http2.jpg?v=0b004ee1ca50a9b6c115720b50427c94","alt":"One connection carrying many multiplexed streams, binary framing, header compression."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
26:["$","section","06-http3",{"id":"06-http3","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"HTTP/3 (QUIC)"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"HTTP/2 still ran on TCP, where a single lost packet stalls all streams. HTTP/3 fixes this by running on QUIC, a new transport built on UDP. QUIC gives each stream independence (one loss does not block the others) and faster connection setup, including quicker TLS."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch22%2F06-http3.jpg?v=8d49b30880195001d33a2e0039670add","alt":"HTTP/3 over QUIC over UDP, with independent streams and no head-of-line blocking."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
27:["$","section","07-timeline",{"id":"07-timeline","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"07"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The evolution at a glance"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The through-line: same HTTP semantics, ever-better transport. 1.0 opened a connection per request; 1.1 reused connections; 2 multiplexed them; 3 moved onto QUIC/UDP to remove TCP’s head-of-line blocking entirely."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch22%2F07-timeline.jpg?v=349dde34ce98fc40a7a6f8efb317b3c0","alt":"Timeline HTTP/1.0 → 1.1 → 2 → 3 (QUIC)."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
