28:["$","div",null,{"className":"flex min-w-0 flex-1 flex-col gap-16","children":[["$","section","01-when-sharing-goes-wrong",{"id":"01-when-sharing-goes-wrong","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"01"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"When sharing goes wrong"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Picture a bank account with a balance of 1000, stored in shared memory. One thread handles a deposit of 100; another, at the same instant, handles a withdrawal of 100. Each does the obvious thing: read the balance, compute the new value, write it back. If they take turns, the answer is 1000, deposit then withdraw, order does not matter. The trouble is that they do not have to take turns, and nothing you have written so far forces them to."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Suppose both threads read 1000 before either has written anything back. The deposit thread computes 1100 and stores it. The withdrawal thread, still holding its stale copy of 1000, computes 900 and stores that, overwriting the deposit entirely. The 100 that was deposited has simply evaporated. Run the same program a thousand times and it might be correct 999 times and wrong once, because correctness now depends on who reached the store instruction first."}],["$","dl","2",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Shared data"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Any memory more than one thread can read and write, a global, a heap object, a field both threads hold a reference to."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Race condition"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"A bug where the result depends on the relative timing (interleaving) of concurrent threads, not just on the code."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Interleaving"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The specific order in which the scheduler happens to run instructions from different threads on this particular execution."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Nondeterminism"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The property that the same program with the same input can produce different results on different runs."}]]}]]}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],"$L2a"]}]]}],"$L2b"]}]]}],"$L2c","$L2d","$L2e","$L2f","$L30","$L31"]}]
29:["$","$L32",null,{"prev":{"slug":"interprocess-communication","title":"Interprocess Communication (IPC)","kind":"$undefined","number":13},"next":{"slug":"locks-semaphores-condition-variables","title":"Locks, Semaphores & Condition Variables","kind":"$undefined","number":15}}]
33:I[76156,["2619","static/chunks/2619-04bc32f026a0d946.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs","6238","static/chunks/app/operating-system/%5Bchapter%5D/page-6f5feff9906adfcd.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs"],"NoteImage"]
2a:["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["The uncomfortable part",": "]}],"A race is not a crash you can catch. It is a wrong answer produced by correct-looking code, appearing only under timing you cannot reproduce on demand. That is exactly why it deserves a whole chapter."]}]
2b:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch14%2F01-when-sharing-goes-wrong.jpg?v=beef18fe83fa15bb67038b32ba109d28","alt":"Handwritten A4 diagram: one shared box labelled \"balance = 1000\" in the middle; two threads T1 and T2 drawn as arrows both reaching into that box at the same time, T1 adding 100 and T2 withdrawing 100; a question mark over the final value showing it could end up 1000, 1100, or 900 depending on timing."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
2c:["$","section","02-anatomy-of-a-race",{"id":"02-anatomy-of-a-race","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Anatomy of a race: count++ is three steps"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The heart of the problem is that count++ is not one operation. The CPU cannot add to a memory location in a single indivisible move; it must load the value from memory into a register, add one in the register, and store the register back to memory. Three steps. And between any two of them, the scheduler is free to pause this thread and run another one, including another thread executing the very same three steps on the very same variable."}],["$","figure","1",{"className":"overflow-hidden rounded-lg border border-ink/15 bg-ink/[0.04]","children":[["$","div",null,{"className":"flex items-center justify-between border-b border-ink/10 bg-ink/[0.03] px-3.5 py-1.5","children":[["$","span",null,{"className":"font-mono text-[0.7rem] uppercase tracking-wide text-mute","children":"What the single line count++ actually compiles to, three separate instructions."}],["$","span",null,{"className":"font-mono text-[0.7rem] text-accent/70","children":"text"}]]}],["$","pre",null,{"className":"overflow-x-auto px-4 py-3 text-[0.86rem] leading-[1.6]","children":["$","code",null,{"className":"font-mono text-ink/90","children":"count++;   // one line of C ...\n\n// ... is really three machine steps:\n   load   reg, [count]   // 1. copy count from memory into a register\n   add    reg, 1         // 2. increment the register\n   store  [count], reg   // 3. copy the register back to memory"}]}]]}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Now interleave two threads, T1 and T2, that each run count++ when count is 5. If the three steps of T1 finish before T2 starts, we get 7, as expected. But watch the bad schedule: T1 loads 5, then the scheduler switches to T2, which also loads 5. T1 adds and stores 6. T2, still holding its own 5, adds and stores 6 too. Two increments ran; count went from 5 to 6. One update was lost, and no rule was broken, every instruction did exactly what it was told."}],["$","ul","3",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"T1: load count → reg1 = 5"}]]}],["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"T2: load count → reg2 = 5   (switched in before T1 could store)"}]]}],["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"T1: reg1 = 6, store count = 6"}]]}],["$","li","3",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"T2: reg2 = 6, store count = 6   (overwrites T1 with a stale value)"}]]}],["$","li","4",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":["$L34","$L35"]}]]}],"$L36"]}],"$L37"]}]]}]
2d:["$","section","03-the-critical-section",{"id":"03-the-critical-section","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The critical section"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Once you see the problem clearly, the fix has an obvious shape: never let two threads execute their read-modify-write on the same data at the same time. The stretch of code that touches shared data, the load, add, and store on count, is called the critical section. The whole game of concurrency control is making sure that at most one thread is inside a given critical section at any moment. That guarantee has a name: mutual exclusion."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"It helps to divide each thread’s code into four regions. The critical section is the sensitive part. Wrapped around it are an entry section, where a thread asks permission to go in, and an exit section, where it signals that it has left so someone else may enter. Everything else, the work that touches only a thread’s own local data, is the remainder section, and it never needs protecting."}],["$","dl","2",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Critical section"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The region of code that accesses shared data and must not run concurrently with another thread’s access to the same data."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Mutual exclusion"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The guarantee that at most one thread is executing inside a given critical section at a time."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Entry section"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The code just before the critical section where a thread requests and waits for permission to enter."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Exit section"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The code just after the critical section that releases the section so another waiting thread can proceed."}]]}]]}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Reframe the goal",": "]}],"We are no longer trying to make count++ atomic by wishing. We are surrounding it with an entry and exit that let exactly one thread through at a time. Every lock, semaphore, and monitor in the coming chapters is a way to build that gate."]}]]}]]}],"$L38"]}]]}]
2e:["$","section","04-three-requirements",{"id":"04-three-requirements","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The three requirements of a correct solution"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Mutual exclusion alone is not enough to call a solution correct. A gate that keeps everyone out forever technically prevents two threads from being inside at once, but it is useless. So a correct critical-section solution must satisfy three properties together, and it is worth stating each one precisely, because real bugs come from quietly dropping one of them."}],["$","dl","1",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Mutual exclusion"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"If one thread is executing in its critical section, no other thread may be executing in its critical section at the same time."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Progress"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"If no thread is in the critical section and one or more want in, the choice of who enters cannot be postponed indefinitely, and threads doing only their remainder work cannot block that choice."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Bounded waiting"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"There is a limit on how many times other threads can enter the critical section after a thread has requested entry and before that request is granted, so no thread is starved forever."}]]}]]}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Read them as three different failures you are ruling out. Break mutual exclusion and you get the lost-update race we just dissected. Break progress and threads that could safely proceed are needlessly blocked, or the whole system stalls with the section empty and everyone waiting. Break bounded waiting and one unlucky thread is repeatedly overtaken, waiting forever while others cut ahead, starvation. A solution is only trustworthy when it holds all three at once."}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Your checklist",": "]}],"When you meet any synchronization scheme, yours or a textbook’s, run it against these three. Most broken concurrency code satisfies mutual exclusion and fails progress or bounded waiting under a schedule the author never imagined."]}]]}]]}],"$L39"]}]]}]
2f:["$","section","05-a-naive-attempt",{"id":"05-a-naive-attempt","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"A naive attempt, and why it fails"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The natural first idea is a shared boolean flag: if it is false the section is free, so set it to true, do your work, then set it back to false. It reads like a lock. It even works most of the time, which is exactly what makes it dangerous. But the flag protecting the critical section is itself shared data touched by a read-modify-write, and we already know what happens to those."}],["$","figure","1",{"className":"overflow-hidden rounded-lg border border-ink/15 bg-ink/[0.04]","children":[["$","div",null,{"className":"flex items-center justify-between border-b border-ink/10 bg-ink/[0.03] px-3.5 py-1.5","children":[["$","span",null,{"className":"font-mono text-[0.7rem] uppercase tracking-wide text-mute","children":"A tempting but broken lock: the check and the set are two separate steps."}],["$","span",null,{"className":"font-mono text-[0.7rem] text-accent/70","children":"c"}]]}],["$","pre",null,{"className":"overflow-x-auto px-4 py-3 text-[0.86rem] leading-[1.6]","children":["$","code",null,{"className":"font-mono text-ink/90","children":"int locked = 0;                 /* shared flag: 0 = free, 1 = held */\n\nvoid enter(void) {\n    while (locked == 1) { }     /* 1. wait while someone holds it */\n    locked = 1;                 /* 2. claim it ... but AFTER the check */\n}\n\nvoid leave(void) {\n    locked = 0;                 /* release */\n}"}]}]]}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The gap sits between line 1 and line 2. Thread T1 reads locked as 0 and breaks out of the while loop. Before T1 can execute locked = 1, the scheduler switches to T2, which also reads locked as 0, also breaks out, and also proceeds. Now both threads set locked = 1 and both walk into the critical section together. Mutual exclusion is broken by the very code meant to enforce it, because \"check if free\" and \"claim it\" were two instructions with a window in between."}],["$","p","3",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"You cannot patch this by being cleverer with ordinary reads and writes alone; strict two-thread schemes exist (Peterson’s algorithm is the classic) but they are intricate, do not scale past a couple of threads, and modern CPUs reorder memory operations in ways that break their assumptions. The lesson is not \"try harder\". It is that we need a primitive the hardware guarantees to be indivisible, check-and-set as one unbreakable step."}],["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["The tell",": "]}],"Any \"lock\" you can build from plain reads and writes has a check-then-act gap somewhere. Finding that gap is the skill; closing it needs hardware help, which is the next chapter."]}]]}]]}],"$L3a"]}]]}]
30:["$","section","06-atomicity",{"id":"06-atomicity","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Atomicity, and why \"just be careful\" fails"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The word underneath everything so far is atomicity. An operation is atomic if it happens all at once, indivisibly: no other thread can observe it half-finished, and it cannot be interrupted partway through. count++ is not atomic because its three steps can be split apart. If the hardware gave us an atomic increment, load, add, and store fused into one uninterruptible instruction, the race in section two simply could not occur, because there would be no gap to slip into."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"This is why \"just be careful\" is not a strategy. Carefulness cannot make a three-step sequence into one step. The scheduler can preempt your thread between any two machine instructions, on any run, and it will eventually pick the one schedule that breaks you, usually in production, under load, months after the code shipped. Correctness here has to be a guarantee provided by a mechanism, not a hope resting on good intentions."}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"And the ground is even less solid than it looks, because the interleaving of threads is not the only reordering in play. To go faster, both the compiler and the CPU may reorder memory reads and writes as long as a single thread cannot tell the difference, but another thread can tell, and sees operations happen in an order your source code never wrote. Taming this needs atomic instructions and memory barriers, hardware features we take on directly in the next chapter."}],["$","dl","3",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Atomic operation"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"One that completes indivisibly, no other thread ever sees an intermediate, half-applied state."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Non-atomic (composite)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"An operation made of several steps (load-modify-store) that a thread can be interrupted between."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Memory reordering"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The compiler and CPU may execute reads/writes out of program order for speed; other threads can observe the reordered order."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":["$L3b","$L3c"]}]]}],"$L3d"]}],"$L3e"]}]]}]
31:["$","section","07-where-this-bites",{"id":"07-where-this-bites","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"07"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Where this bites engineers"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"This is not a museum piece for exams. The bank balance is any counter under concurrency: two web requests incrementing a \"likes\" or \"views\" total, two workers decrementing an inventory count, two threads bumping a metrics gauge. Each request reads the current value, adds one, and writes it back, the exact lost-update race, and the symptom is a total that drifts steadily below the truth, worse the more traffic you get. Plenty of production counters are quietly wrong for precisely this reason."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The second classic is check-then-act, also called TOCTOU, time-of-check to time-of-use. You check a condition and then act on it, but the world can change in the gap between the two. \"If no user with this email exists, create one\": two concurrent signups both pass the check, both insert, and now you have duplicates or a crash. \"If the file does not exist, create it\"; \"if balance ≥ amount, withdraw\", same shape, same gap. The check and the act must be one atomic step, or the check means nothing."}],["$","ul","2",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Lost updates: concurrent read-modify-write on a shared counter silently drops increments."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Check-then-act / TOCTOU: a condition verified, then acted on, is invalidated in the window between."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Non-atomic ++: a plain counter shared across threads or requests is never safe without synchronization."}]]}],["$","li","3",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Fix pattern: shrink the critical section, then guard it, a lock, an atomic instruction, or a single atomic DB statement."}]]}]]}],["$","p","3",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The cleanest place to see the whole idea scaled up is a database. Two transactions selling the last item both read stock = 1, both write stock = 0, and you have oversold, a lost update at the row level. This is why databases are built around exactly the tools of this chapter: row locks that enforce mutual exclusion, and MVCC (multi-version concurrency control), which lets readers see a consistent snapshot while a writer works. The critical section did not disappear when we moved from threads to transactions; it just moved into the database engine."}],"$L3f"]}],"$L40"]}]]}]
34:["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}]
35:["$","span",null,{"children":"Result: count = 6, not 7, a lost update."}]
36:["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Generalise it",": "]}],"The bank balance, the counter, a size field, a reference count, all the same shape. A read, a modify, and a write that is not indivisible. Any read-modify-write on shared data is a race waiting to happen."]}]]}]
37:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch14%2F02-anatomy-of-a-race.jpg?v=fcca9d7505bafce85327ae4704b36351","alt":"Handwritten A4 diagram: an interleaving table with two thread columns (T1, T2) and a shared \"count\" column; count starts at 5; rows show T1 load 5, T2 load 5, T1 add=6, T2 add=6, T1 store 6, T2 store 6; the final count is circled as 6 with a note \"should be 7, one increment lost\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
38:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch14%2F03-the-critical-section.jpg?v=0a6883dfc075aa6472b32970e9015488","alt":"Handwritten A4 diagram: a thread loop drawn as a cycle: \"entry section\" (a gate), then a highlighted shaded box labelled \"critical section: touches shared data\", then \"exit section\" (gate opening), then \"remainder section\" (non-shared work); a note says \"only one thread inside the shaded box at a time\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
39:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch14%2F04-three-requirements.jpg?v=97a7b305234e6ea5f9fcd4d12a207c79","alt":"Handwritten A4 diagram: three labelled panels, (1) Mutual exclusion: two threads, only one inside the box, the other blocked at the gate; (2) Progress: an empty critical section with a waiting thread being let in, arrow \"no needless waiting\"; (3) Bounded waiting: a thread with a small counter \"at most N others first\" so it cannot be starved forever."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
3a:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch14%2F05-a-naive-attempt.jpg?v=dda19a957a25fb53643c855caf267a11","alt":"Handwritten A4 diagram: two threads sharing a boolean flag \"locked\"; an interleaving table shows T1 reads locked==false, T2 reads locked==false (both before either sets it), then both set locked=true and both enter the shaded critical section together; a big red cross over \"mutual exclusion broken\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
3b:["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Memory barrier"}]
3c:["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"A special instruction that forbids reordering across it, restoring an order other threads can rely on (covered next chapter)."}]
3d:["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["The pivot",": "]}],"We have defined the problem exactly: protect a critical section with mutual exclusion, progress, and bounded waiting, built on operations the hardware guarantees to be atomic. From here on, every tool is an answer to this one question."]}]]}]
3e:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch14%2F06-atomicity.jpg?v=6041e7e62bf053f2ab31944487f072a0","alt":"Handwritten A4 diagram: left half shows count++ as three interruptible steps with scissors cutting between them (non-atomic); right half shows the same operation inside a solid unbreakable capsule labelled \"atomic, all-or-nothing, no thread sees a half-done state\"; a small side note: \"compiler & CPU may also reorder memory, see next chapter\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
3f:["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["The hand-off",": "]}],"We now have the problem stated with full precision: a critical section needing mutual exclusion, progress, and bounded waiting, built on atomic operations. The next chapter builds the first real tool for it, the lock. And we return to the database version of this exact story in the capstone."]}]]}]
40:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch14%2F07-where-this-bites.jpg?v=e411f10989b60a479201318e9f6e3d99","alt":"Handwritten A4 diagram: three real-world panels, (1) two web requests both reading likes=41 and both writing 42, a lost like; (2) check-then-act: two threads both see \"file absent\" then both create it (TOCTOU); (3) a database row \"stock = 1\" with two transactions both selling it, and a box labelled \"locks / MVCC\" holding them apart, arrow to \"DB capstone\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
