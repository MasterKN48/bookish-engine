text-ink/80","children":"PostgreSQL"}]]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch28%2F02-well-known.jpg?v=a0b849f73b885dc281991995c54fbca7","alt":"Table: 22 SSH, 53 DNS, 80 HTTP, 443 HTTPS, 5432 Postgres."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
24:["$","section","03-port-ranges",{"id":"03-port-ranges","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Port ranges"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The 65,536 ports are split into ranges: 0–1023 are well-known (reserved for standard services), 1024–49151 are registered, and 49152+ are ephemeral, temporary ports the OS assigns to your outbound connections as the source port."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch28%2F03-port-ranges.jpg?v=6feb33bd2d1248cf98d5b61244bfc9c1","alt":"0-1023 well-known, 1024-49151 registered, 49152+ ephemeral."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
25:["$","section","04-socket",{"id":"04-socket","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"A socket = IP + port"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A socket is the combination of an IP address and a port, for example 10.0.0.1:443. It is the precise endpoint of communication. When your code \"opens a socket\", it is claiming one of these endpoints to send or receive on."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch28%2F04-socket.jpg?v=f4fccc66261003d57092936e03814ed0","alt":"IP 10.0.0.1 plus port 443 combining into 10.0.0.1:443."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
26:["$","section","05-connection-tuple",{"id":"05-connection-tuple","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"A connection is a 4-tuple"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"One connection is uniquely identified by two sockets: (source IP, source port, destination IP, destination port), the 4-tuple from Chapter 1. This is why your browser can hold many simultaneous connections to the same server: each uses a different source port, so each 4-tuple is unique."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch28%2F05-connection-tuple.jpg?v=d057c41c8c4a888e352699269c718f97","alt":"src IP, src port, dst IP, dst port identify one connection."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
27:["$","section","06-public-private",{"id":"06-public-private","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Public vs private IP (recap)"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Tying it back: inside your network, devices use private IPs (192.168.x.x) and any local ports they like. To the outside world, NAT maps them onto the router’s single public IP using ports to keep the connections apart, ports and sockets are exactly what make that sharing possible."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch28%2F06-public-private.jpg?v=24a8d66eaec7fdade2ff5423d0fb05d0","alt":"Private 192.168.x devices behind a router with one public IP."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
