1b:{"metadata":[["$","title","0",{"children":"Page Replacement Algorithms: Operating Systems"}],["$","meta","1",{"name":"description","content":"When memory is full and a fault arrives, which page do you throw out, and how much does getting it wrong cost you?"}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}],["$","link","3",{"rel":"icon","href":"/icon.png?5dbc1fad7703bc98","type":"image/png","sizes":"512x512"}],["$","link","4",{"rel":"apple-touch-icon","href":"/apple-icon.png?375f5bf186e6939a","type":"image/png","sizes":"180x180"}],["$","$L56","5",{}]],"error":null,"digest":"$undefined"}
