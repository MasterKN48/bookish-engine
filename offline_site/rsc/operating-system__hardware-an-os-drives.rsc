3e:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch03%2F08-dma-and-the-big-picture.jpg?v=4d932fae23907f52f290784712d5efb1","alt":"Handwritten diagram: a DMA controller moving a block of data directly between disk and RAM while the CPU works on something else, then a single completion interrupt back to the CPU."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
