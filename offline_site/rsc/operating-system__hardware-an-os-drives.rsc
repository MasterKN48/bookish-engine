3b:["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Polling vs interrupts",": "]}],"Polling wastes the CPU but has low latency for very fast devices; interrupts free the CPU for slow ones. Real drivers mix both (e.g. Linux NAPI polls a busy NIC to avoid interrupt storms)."]}]]}]
3c:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch03%2F07-io-devices-and-buses.jpg?v=a64671e9c6a22ff0a0685252c3c14628","alt":"Handwritten diagram: CPU and RAM on a shared bus connected to device controllers for disk, network and keyboard, each controller exposing status/command/data registers."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
