27:["$","div",null,{"className":"flex min-w-0 flex-1 flex-col gap-16","children":[["$","section","01-why-hardware-matters",{"id":"01-why-hardware-matters","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"01"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Why an OS engineer must know the hardware"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The entire reason an operating system exists is to manage hardware and hand it to programs in a safe, shared, convenient form. That means every abstraction we will build later maps back to something physical. A process is the CPU plus a slice of memory, guarded. Virtual memory is a hardware address-translation unit plus some tables. A file is bytes on a disk reachable through a device controller. The OS is the layer that turns raw parts into clean ideas."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"This matters for you as an engineer even if you never write kernel code. When a service is slow, a server thrashes, or latency spikes under load, the explanation almost always lives at the hardware boundary, a cache miss, a page fault, a syscall storm, an I/O wait. Engineers who can see the hardware through the abstraction can reason about these problems; everyone else reboots and hopes."}],["$","ul","2",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"The CPU executes instructions and enforces protection via a privilege mode bit."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Memory comes in a hierarchy: tiny and fast at the top, huge and slow at the bottom."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Interrupts and a timer let devices and the clock take control away from a running program."}]]}],["$","li","3",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Buses, controllers and DMA move bulk data without burning CPU time."}]]}]]}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["The tour",": "]}],"Keep one question in mind: which hardware feature makes each OS trick possible? Every section answers it."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch03%2F01-why-hardware-matters.jpg?v=38c345d7c1d531b4a07309d3595088a1","alt":"Handwritten diagram: an OS box in the middle with arrows down to CPU, RAM, disk and devices, and arrows up to abstractions labelled processes, virtual memory, files."}],"$L2a"]}]]}]]}],"$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31"]}]
28:["$","$L32",null,{"prev":{"slug":"history-and-types-of-os","title":"A Short History & the OS Zoo","kind":"$undefined","number":2},"next":{"slug":"os-structure-and-architecture","title":"OS Structures & Architectures","kind":"$undefined","number":4}}]
2a:["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]
2b:["$","section","02-cpu-and-registers",{"id":"02-cpu-and-registers","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The CPU & its registers"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"At its core the CPU does one thing, over and over, billions of times a second: the fetch-decode-execute cycle. It fetches the next instruction from memory, decodes what that instruction means, executes it, and repeats. Which instruction is \"next\" is held in a special register called the program counter (the PC, sometimes called the instruction pointer). Advance the PC and you move through the program; overwrite it and you jump elsewhere."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The CPU does not reach into RAM for every value it touches, that would be far too slow. Instead it works out of registers: a small set of tiny, blazingly fast storage slots physically on the chip. There are general-purpose registers for your data, and special-purpose ones with fixed jobs: the program counter, the stack pointer (SP), and a status/flags register recording things like whether the last result was zero or overflowed."}],["$","dl","2",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Program counter (PC)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Holds the address of the next instruction to run; it is the CPU’s bookmark in your code."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"General registers"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"A handful of fast slots (e.g. RAX, RBX on x86-64) the CPU computes with directly."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Stack pointer (SP)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Points at the top of the current call stack, where locals and return addresses live."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Status / flags register"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Records side effects of operations, zero, carry, overflow, sign, used by branches."}]]}]]}],["$","p","3",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Here is the preview that makes registers matter for the OS. All the \"state\" of a running program that is not in memory lives in these registers. So when the OS wants to pause one program and run another, it must save every register somewhere and load the next program’s saved registers back in. That save-and-restore is the essence of a context switch, and because it touches the CPU’s most intimate state, it is not cheap."}],"$L33"]}],"$L34"]}]]}]
2c:["$","section","03-user-vs-kernel-mode",{"id":"03-user-vs-kernel-mode","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"User mode vs kernel mode (privilege rings)"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"How does the OS stop one buggy program from halting the machine or reading another program’s secrets? Not by good manners, by hardware. The CPU runs in one of (at least) two privilege levels, tracked by a mode bit. In kernel mode the CPU will execute any instruction, including the dangerous ones. In user mode a whole class of privileged instructions is simply forbidden; attempt one and the CPU refuses and traps into the OS."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"On x86 these levels are drawn as rings: ring 0 is the fully privileged kernel, ring 3 is where all your applications live, and the outer ring cannot do things like halt the CPU, mask interrupts, change the page tables, or talk to devices directly. Those powers are reserved for the kernel. Most OSes use only ring 0 and ring 3 and ignore the two in between."}],["$","dl","2",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Mode bit"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"A single hardware flag saying whether the CPU is currently privileged (kernel) or restricted (user)."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Ring 0 (kernel)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Full privilege: all instructions, all memory, all devices. The kernel runs here."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Ring 3 (user)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Restricted: no privileged instructions, no direct hardware. Every normal app runs here."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Privileged instruction"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"An instruction (halt, set page table, I/O, disable interrupts) legal only in kernel mode."}]]}]]}],["$","p","3",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"This single hardware feature is what makes protection possible, and it is exactly the user/kernel boundary from the introduction. Your program cannot touch hardware because the CPU physically will not let it in user mode; it must ask the kernel via a system call, which is the controlled way to flip into kernel mode, do the privileged work, and flip back. That mode switch, plus the cache and pipeline disruption around it, is why a syscall costs meaningfully more than a plain function call."}],"$L35"]}],"$L36"]}]]}]
2d:["$","section","04-memory-hierarchy",{"id":"04-memory-hierarchy","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The memory hierarchy"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"There is no single kind of memory that is fast, huge and cheap all at once, physics and economics forbid it. So computers stack several kinds into a hierarchy. At the top sit the CPU registers: a few hundred bytes, effectively instant. Below them are the L1, L2 and L3 caches, then main memory (RAM), then persistent storage (SSD, and slower still, spinning disk). As you go down, each level is bigger and cheaper per byte, but dramatically slower."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The whole scheme works because of locality. Programs tend to reuse the same data and instructions (temporal locality) and to touch data near what they just touched (spatial locality). Hardware exploits this by pulling data into cache in chunks called cache lines, betting you will want the neighbours too. Good code plays along; bad code fights it."}],["$","ul","2",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"CPU register, under 1 nanosecond, the CPU’s working set."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"L1 cache, about 1 ns; L2 cache, a few ns; L3 cache, around 10-20 ns."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Main memory (RAM), roughly 100 ns, about 100x slower than L1."}]]}],["$","li","3",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"SSD read, tens of microseconds; spinning disk seek, several milliseconds."}]]}],["$","li","4",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Rule of thumb: each step down is 10x-100x slower: RAM to disk spans a factor of tens of thousands."}]]}]]}],["$","p","3",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"This is where hardware knowledge turns into faster software. Iterating an array in order is fast because it walks along cache lines; hopping randomly through a linked list or a pointer-chasing tree stalls the CPU waiting on RAM. Packing hot fields together, choosing arrays over scattered objects, and keeping the working set inside cache are not micro-optimisations, they routinely make real code several times faster."}],["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],"$L37"]}]]}],"$L38"]}]]}]
2e:["$","section","05-interrupts-and-traps",{"id":"05-interrupts-and-traps","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Interrupts & traps"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"If the CPU only ever ran straight through your program, it could never notice that a key was pressed, a packet arrived, or a disk finished a read. The mechanism that lets the outside world grab the processor is the interrupt. A device raises an electrical signal; the CPU finishes its current instruction, saves just enough state, and jumps to a predefined handler, then resumes what it was doing as if nothing happened."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"How does the CPU know where to jump? Through the interrupt vector: a table, set up by the OS at boot, mapping each interrupt number to the address of its handler routine. Interrupt 14 might be a page fault, another number the keyboard, another the timer. The CPU indexes the table and dispatches. This is why we say an OS is fundamentally interrupt-driven: for most of its life the kernel is idle, waiting, and springs to action only when an interrupt or trap fires."}],["$","dl","2",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Hardware interrupt"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"An asynchronous signal from a device (disk, NIC, keyboard, timer), arrives whenever the device is ready."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Trap (software interrupt)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"A deliberate, synchronous jump into the kernel triggered by the program itself, how a system call is made."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Exception / fault"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"An interrupt the CPU raises on an error mid-instruction, divide by zero, or a page fault the OS then fixes up."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Interrupt vector"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The table mapping each interrupt number to its handler address; the OS fills it in at boot."}]]}]]}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["One mechanism, three uses",": "]}],"Devices (async), syscalls (deliberate traps) and errors (faults) all funnel through the same \"stop, save, jump to handler\" machinery. Learn it once and three topics fall into place."]}]]}]]}],"$L39"]}]]}]
2f:["$","section","06-clock-and-timer",{"id":"06-clock-and-timer","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The clock / timer"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Here is a puzzle: once the OS hands the CPU to your program and switches to user mode, how does it ever get control back? Your program is running, not the kernel. If your code entered an infinite loop, what stops it from owning the CPU forever? The answer is a dedicated piece of hardware, the programmable timer, that fires an interrupt at a fixed, regular interval, whether the running program likes it or not."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Each of these ticks (historically the \"timer interrupt\" or \"tick\", often every few milliseconds) drags the CPU out of user mode and into the kernel’s timer handler. At that moment the OS is back in charge and can make a decision: has this process had enough time? If so, it saves the process’s registers, picks another, and returns to that one instead. That forced hand-back is exactly what makes preemptive multitasking possible."}],["$","ul","2",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"The timer fires periodically regardless of what user code is doing, the OS cannot be starved out."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Every tick is a chance for the scheduler to preempt the current process and switch to another."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"The tick interval is a tradeoff: shorter means snappier switching but more overhead spent in the handler."}]]}],["$","li","3",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Without the timer there is no preemption, a single loop could freeze the whole machine."}]]}]]}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Ties to scheduling",": "]}],"The timer interrupt is the heartbeat of the scheduler. When we study scheduling, this tick is the moment every \"who runs next?\" decision is made."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch03%2F06-clock-and-timer.jpg?v=7b6e76c3da5bbc349a192547a451f0ee","alt":"Handwritten diagram: a timer chip ticking at fixed intervals, each tick firing an interrupt into the kernel scheduler, which decides whether to keep or preempt the running process."}],"$L3a"]}]]}]]}]
30:["$","section","07-io-devices-and-buses",{"id":"07-io-devices-and-buses","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"07"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"I/O devices, controllers & buses"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The CPU does not talk to a disk or a network card directly. Between them sits a device controller, a small dedicated chip that knows the messy details of one device and exposes a tidy set of device registers: typically a status register (is the device ready or busy?), a command register (what should it do?), and a data register (the bytes moving through). The OS driver drives the device entirely by reading and writing these registers."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"There are two ways the CPU reaches those registers. With memory-mapped I/O, the device registers are wired into ordinary memory addresses, so a plain load or store to a special address talks to the device. With port-mapped I/O, the device lives in a separate address space accessed by dedicated IN/OUT instructions. Modern hardware leans heavily on memory-mapped I/O. Tying it all together is the bus, the shared set of wires over which the CPU, memory and controllers exchange addresses and data."}],["$","dl","2",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Device controller"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The chip that operates one device and presents it to the CPU as a handful of registers."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Device registers"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The status, command and data slots the driver reads and writes to control the device."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Memory-mapped I/O"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Device registers appear at normal memory addresses; ordinary loads/stores talk to the device."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Bus"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The shared wires (address + data + control) connecting CPU, memory and controllers."}]]}]]}],["$","p","3",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"That leaves one question: after the driver tells a device to do something, how does it learn the work is done? Two styles. In polling, the CPU sits in a loop reading the status register over and over, simple, but it burns the CPU waiting. With interrupts, the driver kicks off the work and moves on; the controller raises an interrupt when finished. Interrupts are why your machine stays responsive during a slow download instead of spinning uselessly."}],"$L3b"]}],"$L3c"]}]]}]
31:["$","section","08-dma-and-the-big-picture",{"id":"08-dma-and-the-big-picture","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"08"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"DMA & the big picture"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Even with interrupts, one problem remains: moving a megabyte of data one register-load at a time would still pin the CPU copying bytes for the whole transfer. The fix is Direct Memory Access (DMA). The CPU tells a DMA controller \"move this many bytes between this device and this region of RAM\", and then walks away to do useful work. The DMA engine performs the whole bulk transfer over the bus by itself."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"When the transfer finishes, the DMA controller raises a single interrupt to say \"done\". So instead of thousands of interruptions or a busy CPU shuffling bytes, the CPU is disturbed exactly once per block. This is how disks and network cards move data at full speed while your programs keep running, the CPU sets up the job and the hardware does the heavy lifting."}],["$","dl","2",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"DMA controller"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"A hardware engine that transfers blocks of data between a device and RAM without the CPU copying each byte."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Bulk transfer"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The whole block moves in one operation over the bus, freeing the CPU meanwhile."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Completion interrupt"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The single interrupt the DMA engine raises when the transfer is finished."}]]}]]}],["$","p","3",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Step back and the whole chapter connects. The CPU and its registers give us execution and, via save/restore, context switches. The mode bit gives us protection and the user/kernel boundary. The memory hierarchy shapes performance. Interrupts, the timer, controllers and DMA give the OS its hands and its heartbeat. Everything ahead, processes, scheduling, virtual memory, files, is the OS wrapping these physical parts in abstractions you can program against without ever touching a device register."}],["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":["$L3d","From here on we build up: the process, the system call, the scheduler, the page table. Each one is the OS putting the hardware in this chapter to work. Now you know what it is really driving."]}]]}]]}],"$L3e"]}]]}]
33:["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Preview",": "]}],"A context switch is, at heart, \"dump all registers, load the other set\". Remember this when we ask why switching threads too often wrecks performance."]}]]}]
34:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch03%2F02-cpu-and-registers.jpg?v=a371fc2d01736aca6b494a6d4e82a533","alt":"Handwritten diagram: a CPU box showing the fetch-decode-execute cycle as a loop, beside a register file listing PC, SP, general registers R0-Rn and status flags."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
35:["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Why syscalls cost",": "]}],"A syscall crosses the mode boundary and disturbs caches and the pipeline. That is why high-throughput code batches I/O instead of making a syscall per byte."]}]]}]
36:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch03%2F03-user-vs-kernel-mode.jpg?v=bb92c7de67ad68d05917d4d0f2623ae5","alt":"Handwritten diagram: concentric rings with ring 0 (kernel) at the centre and ring 3 (user apps) outside, a mode bit flag, and a blocked privileged instruction in user mode."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
37:["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Engineer’s aside, buffer pools",": "]}],"A database buffer pool is a memory hierarchy built by hand: it keeps hot disk pages in RAM so most reads never touch the slow disk. Same principle as a CPU cache, one level up."]}]
38:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch03%2F04-memory-hierarchy.jpg?v=ce83aa9d0992f0890fa94c92bf706ef3","alt":"Handwritten pyramid: registers at the top, then L1, L2, L3 cache, RAM, SSD and disk at the base, with arrows showing faster/smaller at top and bigger/cheaper/slower at bottom."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
39:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch03%2F05-interrupts-and-traps.jpg?v=52020ce25604981051f2bd6cf357f648","alt":"Handwritten diagram: a device raising an interrupt line to the CPU, the CPU consulting an interrupt vector table, and jumping to a handler; a side note distinguishing hardware interrupt, trap and fault."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
