33:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch04%2F03-monolithic-kernels.jpg?v=4a5301a2cabda70ac749098999168d97","alt":"Handwritten notes: one large box labelled KERNEL SPACE holding scheduler, memory manager, file systems and drivers all together, with fast direct arrows between them, and a small warning that a bug in any one can crash everything."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
