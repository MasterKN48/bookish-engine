23:["$","section","02-source-port",{"id":"02-source-port","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Field 1: Source Port"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Source Port (2 bytes) identifies the sending application, so replies can find their way back to the right process. It is optional in UDP and may be 0 if no reply is expected."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch14%2F02-source-port.jpg?v=3eb49ef0ef0af50d395119cca258f251","alt":"Header row with the source port field circled."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
24:["$","section","03-dest-port",{"id":"03-dest-port","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Field 2: Destination Port"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Destination Port (2 bytes) says which application on the receiving machine should get the datagram, for example, port 53 for DNS. This is how one IP can run many services at once."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch14%2F03-dest-port.jpg?v=dd460d098d8bba5e4bd44c1bfb455598","alt":"Header row with the destination port field circled."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
25:["$","section","04-length",{"id":"04-length","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Field 3: Length"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Length (2 bytes) is the size of the entire datagram, header plus data, in bytes. The minimum is 8 (a header with no data)."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch14%2F04-length.jpg?v=c05bcb7d082fdc141b7450a9284630ef","alt":"Header row with the length field circled."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
26:["$","section","05-checksum",{"id":"05-checksum","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Field 4: Checksum"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Checksum (2 bytes) is an error-detection code covering the header, data, and a small pseudo-header of IP info. It lets the receiver detect corruption in transit. It is optional in IPv4 (0 = unused) but mandatory in IPv6."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch14%2F05-checksum.jpg?v=db34755ad449736856ab691e78dfcb05","alt":"Header row with the checksum field circled."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
27:["$","section","06-summary",{"id":"06-summary","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Eight bytes, that’s it"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Add it up: Source Port + Destination Port + Length + Checksum, each 2 bytes, equals an 8-byte header. That tiny, fixed header is exactly why UDP is so lightweight and fast."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L29",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch14%2F06-summary.jpg?v=f967151222fcc5f1daf54efbd6f3655f","alt":"2 + 2 + 2 + 2 = 8 bytes."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
