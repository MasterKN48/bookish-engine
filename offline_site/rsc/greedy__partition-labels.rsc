1a:I[28440,["2619","static/chunks/2619-04bc32f026a0d946.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs","6489","static/chunks/6489-699922ea493f9867.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs","1356","static/chunks/1356-9e2757ba007ad1f9.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs","951","static/chunks/951-3dbda3a86d4c6444.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs","2799","static/chunks/2799-ce430b82b11995d5.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs","6589","static/chunks/6589-cfdc115b042e146b.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs","3650","static/chunks/3650-106e80ed926f59bf.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs","8440","static/chunks/8440-bfb72547be677d52.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs","134","static/chunks/app/%5Bpattern%5D/%5BproblemId%5D/page-f9e02a54f5641ad9.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs"],"AnimationRunner"]
19:["$","$L1a","partition-labels",{"problem":{"id":"partition-labels","patternId":"greedy","title":"Partition Labels","subtitle":"Extend the part to each letter’s last occurrence","kind":"problem","leetcode":{"id":763,"slug":"partition-labels","difficulty":"Medium"},"companies":["Amazon","Google"],"statement":"Given a string, partition it into as many contiguous parts as possible so that each letter appears in at most one part, and return the list of part sizes in order.","input":["a","b","a","b","c","b","a","c","a","d","e","f","e","g","d","e","h","i","j","h","k","l","i","j"],"approaches":[{"label":"Greedy · cut at each letter’s last occurrence","complexity":{"time":"O(n)","space":"O(1)"},"pseudocode":["given s","for i ← 0 to n − 1: last[s[i]] ← i","start ← 0;  end ← 0;  sizes ← []","for i ← 0 to n − 1:","    end = max(end, last[s[i]])","    if i == end:","        sizes.push(end − start + 1);  start ← i + 1","return sizes"],"steps":[{"codeLine":1,"narration":"Partition Labels: cut \"ababcbacadefegdehijhklij\" into the most pieces possible so that no letter is split across two pieces. The greedy key: a partition that contains a letter MUST stretch at least to that letter's LAST occurrence, otherwise the letter would appear in two parts.","highlights":[0],"vars":[["n",24],["s","\"ababcbacadefegdehijhklij\""]]},{"codeLine":2,"narration":"First pass: record the LAST index of each letter. last = {a:8, b:5, c:7, d:14, e:15, f:11, g:13, h:19, i:22, j:23, k:20, l:21}. For example 'a' last appears at index 8, 'b' at 5. These caps are what every partition must respect.","highlights":[8,5],"vars":[["last","{a:8, b:5, c:7, d:14, e:15, f:11, g:13, h:19, i:22, j:23, k:20, l:21}"]]},{"codeLine":3,"narration":"Second pass: scan left to right. start marks the current partition's beginning; end is how far this partition is forced to reach so far. Whenever i catches up to end, no unfinished letter pokes past it, we can safely close the partition here.","pointers":[{"name":"start","index":0,"color":"accent2","lane":0},{"name":"end","index":0,"color":"ink","lane":0}],"highlights":[0],"vars":[["start",0],["end",0]]},{"codeLine":4,"narration":"i = 0: letter 'a' last appears at index 8, which is past the current end 0. The partition is FORCED to stretch: end ← 8. Greedy choice, extend only as far as the contained letters demand, never more.","pointers":[{"name":"start","index":0,"color":"accent2","lane":0},{"name":"i","index":0,"color":"accent"},{"name":"end","index":8,"color":"ink","lane":0}],"highlights":[0],"reads":[8],"vars":[["i",0],["s[i]","a"],["last['a']",8],["start",0],["end",8]],"regions":[{"start":0,"end":9,"tint":"gold","label":"open part [0..8]"}]},{"codeLine":4,"narration":"i = 1: letter 'b' last appears at index 5 ≤ end = 8. Already inside the part, end is unchanged.","pointers":[{"name":"start","index":0,"color":"accent2","lane":0},{"name":"i","index":1,"color":"accent"},{"name":"end","index":8,"color":"ink","lane":0}],"highlights":[1],"reads":[5],"vars":[["i",1],["s[i]","b"],["last['b']",5],["start",0],["end",8]],"regions":[{"start":0,"end":9,"tint":"gold","label":"open part [0..8]"}]},{"codeLine":4,"narration":"i = 2: letter 'a' last appears at index 8 ≤ end = 8. Already inside the part, end is unchanged.","pointers":[{"name":"start","index":0,"color":"accent2","lane":0},{"name":"i","index":2,"color":"accent"},{"name":"end","index":8,"color":"ink","lane":0}],"highlights":[2],"reads":[8],"vars":[["i",2],["s[i]","a"],["last['a']",8],["start",0],["end",8]],"regions":[{"start":0,"end":9,"tint":"gold","label":"open part [0..8]"}]},{"codeLine":4,"narration":"i = 3: letter 'b' last appears at index 5 ≤ end = 8. Already inside the part, end is unchanged.","pointers":[{"name":"start","index":0,"color":"accent2","lane":0},{"name":"i","index":3,"color":"accent"},{"name":"end","index":8,"color":"ink","lane":0}],"highlights":[3],"reads":[5],"vars":[["i",3],["s[i]","b"],["last['b']",5],["start",0],["end",8]],"regions":[{"start":0,"end":9,"tint":"gold","label":"open part [0..8]"}]},{"codeLine":4,"narration":"i = 4: letter 'c' last appears at index 7 ≤ end = 8. Already inside the part, end is unchanged.","pointers":[{"name":"start","index":0,"color":"accent2","lane":0},{"name":"i","index":4,"color":"accent"},{"name":"end","index":8,"color":"ink","lane":0}],"highlights":[4],"reads":[7],"vars":[["i",4],["s[i]","c"],["last['c']",7],["start",0],["end",8]],"regions":[{"start":0,"end":9,"tint":"gold","label":"open part [0..8]"}]},{"codeLine":4,"narration":"i = 5: letter 'b' last appears at index 5 ≤ end = 8. Already inside the part, end is unchanged.","pointers":[{"name":"start","index":0,"color":"accent2","lane":0},{"name":"i","index":5,"color":"accent"},{"name":"end","index":8,"color":"ink","lane":0}],"highlights":[5],"reads":[5],"vars":[["i",5],["s[i]","b"],["last['b']",5],["start",0],["end",8]],"regions":[{"start":0,"end":9,"tint":"gold","label":"open part [0..8]"}]},{"codeLine":4,"narration":"i = 6: letter 'a' last appears at index 8 ≤ end = 8. Already inside the part, end is unchanged.","pointers":[{"name":"start","index":0,"color":"accent2","lane":0},{"name":"i","index":6,"color":"accent"},{"name":"end","index":8,"color":"ink","lane":0}],"highlights":[6],"reads":[8],"vars":[["i",6],["s[i]","a"],["last['a']",8],["start",0],["end",8]],"regions":[{"start":0,"end":9,"tint":"gold","label":"open part [0..8]"}]},{"codeLine":4,"narration":"i = 7: letter 'c' last appears at index 7 ≤ end = 8. Already inside the part, end is unchanged.","pointers":[{"name":"start","index":0,"color":"accent2","lane":0},{"name":"i","index":7,"color":"accent"},{"name":"end","index":8,"color":"ink","lane":0}],"highlights":[7],"reads":[7],"vars":[["i",7],["s[i]","c"],["last['c']",7],["start",0],["end",8]],"regions":[{"start":0,"end":9,"tint":"gold","label":"open part [0..8]"}]},{"codeLine":4,"narration":"i = 8: letter 'a' last appears at index 8 ≤ end = 8. Already inside the part, end is unchanged.","pointers":[{"name":"start","index":0,"c