3a:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L34",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch08%2F04-process-states.jpg?v=611b464180d2090d13f477356cdf79d1","alt":"Hand-drawn A4 state machine: five circles, new, ready, running, waiting (blocked), terminated, with labelled arrows: new→ready (admitted), ready→running (scheduler dispatch), running→ready (timer interrupt / preempt), running→waiting (I/O or event wait), waiting→ready (I/O complete), running→terminated (exit); a note points at the running↔ready loop as \"where scheduling lives\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
3b:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L34",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch08%2F05-fork.jpg?v=3a45f798d2ce6263c8052e35068c2e94","alt":"Hand-drawn A4 diagram: a single arrow entering a \"fork()\" box and two arrows leaving it, one labelled \"returns child PID → parent\", one labelled \"returns 0 → child\"; below, two identical address-space boxes (parent and child) sharing physical pages drawn with a dashed \"copy-on-write\" link, and a note \"write triggers a private copy\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
