28:["$","div",null,{"className":"flex min-w-0 flex-1 flex-col gap-16","children":[["$","section","01-program-vs-process",{"id":"01-program-vs-process","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"01"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"What a process really is"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A program and a process are not the same thing, and confusing them is the root of most beginner errors here. A program is passive: it is a file on disk, a sequence of instructions and initial data sitting there whether or not anyone runs it. A process is active: it is that program in execution, with a current point of activity, the program counter marking which instruction runs next, plus everything the OS wraps around it to keep it running."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The clearest way to feel the difference is that one program can become many processes. Open three terminal windows and each runs its own copy of the shell: one program (bash on disk), three processes, each with its own memory, its own place in the code, its own open files. The recipe is shared and read-only; every cook working from it has their own kitchen, their own half-chopped onions, their own place in the steps."}],["$","dl","2",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Program"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The passive thing: an executable file on disk, instructions and initial data, doing nothing until run."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Process"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The active thing: a program in execution, with a current activity and its own resources."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Current activity"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Where execution is right now, captured by the program counter and the rest of the CPU registers."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Owned resources"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"What the process holds while it runs: an address space, open files, and its CPU register state."}]]}]]}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Remember",": "]}],"Program is the noun on disk; process is the verb in motion. The same file, run twice, is two independent processes that cannot see each other’s memory."]}]]}]]}],"$L2a"]}]]}],"$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32"]}]
29:["$","$L33",null,{"prev":{"slug":"from-source-to-process","title":"From Source Code to a Running Process","kind":"$undefined","number":7},"next":{"slug":"threads","title":"Threads","kind":"$undefined","number":9}}]
34:I[76156,["2619","static/chunks/2619-04bc32f026a0d946.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs","6238","static/chunks/app/operating-system/%5Bchapter%5D/page-6f5feff9906adfcd.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs"],"NoteImage"]
2a:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L34",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch08%2F01-program-vs-process.jpg?v=b78f40907426ad0916ad752ccaf91a68","alt":"Hand-drawn A4 diagram: on the left a program file \"a.out\" resting on a disk icon labelled \"passive, just bytes\"; a big arrow labelled \"run / exec\" points right to a process box labelled \"active\", containing four compartments, code, current activity (a program-counter arrow), an address space, and open files/registers."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
2b:["$","section","02-address-space-recap",{"id":"02-address-space-recap","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"What the process owns in memory"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The biggest resource a process owns is its address space, the private range of memory it believes it has all to itself. We drew this in the previous chapter, and it is worth holding in view because the PCB has to describe every piece of it. From low addresses up: the text segment holds your machine code, then read-only data, then initialised globals, then the zero-filled BSS. Above those the heap grows upward as you allocate; at the top the stack grows downward as you call functions."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Two facts make this an OS story and not just a memory-layout picture. First, the space is private: process A cannot read process B’s address space, because the kernel gives each its own mapping from virtual addresses to physical RAM. Second, the space is an illusion the kernel maintains, a topic we open fully in the memory-management part. For now, treat the address space as the single largest thing a process owns, and something the kernel must record so it can protect it and, later, hand it off during a context switch."}],["$","ul","2",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Text: the process’s code, read-only and often shared between copies of the same program."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Data + BSS: global and static variables, initialised and zero-filled respectively."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Heap: dynamic memory from malloc/new, growing upward on demand."}]]}],["$","li","3",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Stack: local variables and call frames, growing downward; one per thread."}]]}]]}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Why engineers care",": "]}],"Process isolation is exactly this private address space. It is why a crash in one service does not corrupt another, and why sharing data between processes needs deliberate IPC, a wall the kernel enforces on purpose."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L34",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch08%2F02-address-space-recap.jpg?v=aa1012436250ed19d8eb3906cfba0e22","alt":"Hand-drawn vertical memory map of one process, low addresses at the bottom: text (code) → read-only data → initialised data → BSS → heap with an up-arrow (grows up) → a gap holding shared libraries → stack with a down-arrow (grows down) at the top, kernel space above the line; a bracket on the right labels the whole thing \"this process’s private address space\"."}],"$L35"]}]]}]]}]
2c:["$","section","03-the-pcb",{"id":"03-the-pcb","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The Process Control Block"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"For every process alive on the machine, the kernel keeps one record: the Process Control Block, or PCB. On Linux this is a large C struct called task_struct; the name varies by OS but the idea is universal. The PCB is the process, from the kernel’s point of view, it is the complete answer to the question \"everything I need to know to manage, pause, resume, and account for this program\"."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The fields group into a few clear families. There is identity (the PID and the parent’s PID). There is CPU state, the saved registers and program counter, which is what makes it possible to freeze a process mid-instruction and thaw it later. There is memory information (pointers to the process’s page tables that define the address space). There is the open-file table (which files, sockets, and pipes this process has open). There is scheduling information (priority, how much CPU it has used, which queue it sits in). And there is the family tree (links to parent and children)."}],["$","dl","2",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"PID / PPID"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The process ID that uniquely names this process, and the parent process ID that names who created it."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Saved registers + PC"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"A snapshot of CPU state so the process can be paused and later resumed exactly where it stopped."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Memory maps"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Pointers to the page tables describing this process’s address space, text, data, heap, stack."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Open-file table"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The per-process list of open file descriptors: files, sockets, pipes, and their positions."}]]}],["$","div","4",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Scheduling info"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Priority, CPU time consumed, and scheduling class, what the scheduler reads to pick who runs next."}]]}],"$L36"]}],"$L37"]}],"$L38"]}]]}]
2d:["$","section","04-process-states",{"id":"04-process-states","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Process states & the state diagram"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A process is not always running, most of the time it is not. At any instant each process is in one of a small set of states, and the kernel records that state in the PCB. The classic five are: new (being created), ready (able to run, just waiting for a CPU), running (currently executing on a CPU), waiting or blocked (cannot proceed until some event happens, usually I/O), and terminated (finished, awaiting cleanup)."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The interesting part is the transitions, because each one is caused by a specific event. new → ready happens when the OS admits the process. ready → running is a dispatch: the scheduler picks it and loads its PCB onto a CPU. running → ready is a preemption: a timer interrupt fires and the scheduler takes the CPU back to give someone else a turn. running → waiting happens when the process asks for something slow, reads a file, waits on a lock, and the kernel parks it. waiting → ready fires when that event completes, making it runnable again. running → terminated is exit."}],["$","dl","2",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Ready"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Runnable and waiting only for a free CPU; the scheduler chooses from the set of ready processes."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Running"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Actually executing on a CPU right now, on an N-core machine, at most N processes are running at once."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Waiting / blocked"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Cannot make progress until an event (I/O completion, a signal, a lock) occurs; not competing for the CPU."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Preemption"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The kernel forcibly moving a running process back to ready, usually on a timer, so others get a turn."}]]}]]}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":["$L39","A process eating CPU sits in running/ready; a \"hung\" one is usually stuck in waiting on some I/O or lock. Tools like top show this directly, the state column (R, S, D, Z) is literally this diagram, and it tells you whether to look at your CPU or your I/O."]}]]}]]}],"$L3a"]}]]}]
2e:["$","section","05-fork",{"id":"05-fork","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Creating a process: fork()"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"In the Unix model there is exactly one way to create a new process: fork(). It is one of the strangest-looking calls you will meet, because it returns twice. You call fork() once, and the kernel makes a near-duplicate of the calling process, the child, that is almost identical to the parent: same code, same open files, a copy of the same memory. Then both processes return from the same fork() call and continue running the same program from the same line."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"How does each copy know who it is? By fork’s return value, and this convention is the whole trick. In the parent, fork() returns the PID of the new child (a positive number). In the child, fork() returns 0. On failure, it returns -1 in the parent and no child is created. So the standard pattern is an if on the return value, giving each process a different branch to run."}],["$","figure","2",{"className":"overflow-hidden rounded-lg border border-ink/15 bg-ink/[0.04]","children":[["$","div",null,{"className":"flex items-center justify-between border-b border-ink/10 bg-ink/[0.03] px-3.5 py-1.5","children":[["$","span",null,{"className":"font-mono text-[0.7rem] uppercase tracking-wide text-mute","children":"fork returns twice: the child sees 0, the parent sees the child’s PID."}],["$","span",null,{"className":"font-mono text-[0.7rem] text-accent/70","children":"c"}]]}],["$","pre",null,{"className":"overflow-x-auto px-4 py-3 text-[0.86rem] leading-[1.6]","children":["$","code",null,{"className":"font-mono text-ink/90","children":"#include <stdio.h>\n#include <unistd.h>   /* fork, getpid */\n\nint main(void) {\n    pid_t pid = fork();               /* one call, two returns */\n    if (pid < 0) {\n        perror(\"fork\");               /* creation failed */\n    } else if (pid == 0) {\n        printf(\"child:  my pid=%d\\n\", getpid());\n    } else {\n        printf(\"parent: child pid=%d\\n\", pid);\n    }\n    return 0;\n}"}]}]]}],["$","p","3",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Copying a whole address space sounds ruinously expensive, and once it was. Modern kernels avoid it with copy-on-write (COW): after fork, parent and child share the same physical memory pages, marked read-only. Nothing is actually copied until one of them writes to a page, at which point the kernel duplicates just that page. Since a child very often calls exec immediately (next section) and throws the memory away, this makes fork cheap in practice, you rarely pay for the copy at all."}],["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Gotcha",": "]}],"After fork, the order in which parent and child run is not defined, either may print first. And every open file descriptor is shared into the child, which is exactly how pipes get wired up, but also a source of surprises if you forget the child inherited your files."]}]]}]]}],"$L3b"]}]]}]
2f:["$","section","06-exec",{"id":"06-exec","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Running a new program: exec()"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"fork gives you a second copy of the same program, but usually you want to run a different program. That is the job of the exec family of calls. exec does not create a new process; it replaces the current process’s image, its code, data, heap, and stack are all thrown away and rebuilt from a new executable on disk. The PID stays the same, the open files (by default) stay open, but the program running is now something else entirely. On success, exec never returns, because the code that called it no longer exists."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Put fork and exec together and you have the fork-and-exec pattern that runs essentially every command on a Unix system. The shell forks a child; the child calls exec to become the program you asked for (ls, gcc, python); the parent shell waits for it to finish. Splitting creation (fork) from program-loading (exec) is a deliberate design choice, it gives the child a window, after the fork but before the exec, to set things up: redirect its output, close descriptors, change directory. That window is how shell redirection and pipes are implemented."}],["$","figure","2",{"className":"overflow-hidden rounded-lg border border-ink/15 bg-ink/[0.04]","children":[["$","div",null,{"className":"flex items-center justify-between border-b border-ink/10 bg-ink/[0.03] px-3.5 py-1.5","children":[["$","span",null,{"className":"font-mono text-[0.7rem] uppercase tracking-wide text-mute","children":"The fork+exec pattern a shell uses to run a command."}],["$","span",null,{"className":"font-mono text-[0.7rem] text-accent/70","children":"c"}]]}],["$","pre",null,{"className":"overflow-x-auto px-4 py-3 text-[0.86rem] leading-[1.6]","children":["$","code",null,{"className":"font-mono text-ink/90","children":"#include <stdio.h>\n#include <unistd.h>   /* fork, execvp */\n#include <sys/wait.h> /* wait */\n\nint main(void) {\n    pid_t pid = fork();\n    if (pid == 0) {                       /* child */\n        char *argv[] = {\"ls\", \"-l\", NULL};\n        execvp(\"ls\", argv);               /* becomes ls */\n        perror(\"execvp\");                 /* only if exec failed */\n        _exit(127);\n    }\n    wait(NULL);                           /* parent waits */\n    return 0;\n}"}]}]]}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Remember",": "]}],"fork = \"give me another process\"; exec = \"turn this process into a different program\". The line after a successful execvp is unreachable, if it runs, exec failed, which is why we check with perror right there."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L34",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch08%2F06-exec.jpg?v=1b337fb830629a200868b4036217718b","alt":"Hand-drawn A4 diagram: a process box \"shell (bash)\" forks into a child copy; an arrow labelled \"execvp(\"ls\")\" points at the child, its old address space struck through and replaced by fresh \"ls\" text/data/heap/stack, while the PID stays the same; caption strip along the bottom reads \"fork = new process, exec = new program\"."}],"$L3c"]}]]}]]}]
30:["$","section","07-wait-and-exit",{"id":"07-wait-and-exit","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"07"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Waiting & exit: reaping children"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"When a process finishes, it calls exit() (or returns from main, which calls exit for it), passing a small integer exit status, by convention 0 for success and non-zero for failure. But the process does not fully vanish at that moment. The kernel keeps a tiny remnant of it around, mainly its PID and exit status, until the parent asks for it. Collecting that status is called reaping, and the parent does it with wait() or waitpid()."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"wait(NULL) blocks the parent until any one of its children terminates, then returns. waitpid(pid, &status, 0) waits for a specific child and fills in status, which you decode with macros: WIFEXITED(status) tells you it exited normally, and WEXITSTATUS(status) extracts the exit code it passed. This is exactly how a shell knows whether the command you ran succeeded, and it is where the shell’s $? variable comes from."}],["$","figure","2",{"className":"overflow-hidden rounded-lg border border-ink/15 bg-ink/[0.04]","children":[["$","div",null,{"className":"flex items-center justify-between border-b border-ink/10 bg-ink/[0.03] px-3.5 py-1.5","children":[["$","span",null,{"className":"font-mono text-[0.7rem] uppercase tracking-wide text-mute","children":"Parent waits for a child and reads its exit status."}],["$","span",null,{"className":"font-mono text-[0.7rem] text-accent/70","children":"c"}]]}],["$","pre",null,{"className":"overflow-x-auto px-4 py-3 text-[0.86rem] leading-[1.6]","children":["$","code",null,{"className":"font-mono text-ink/90","children":"#include <stdio.h>\n#include <stdlib.h>   /* exit */\n#include <unistd.h>   /* fork */\n#include <sys/wait.h> /* waitpid, WIFEXITED */\n\nint main(void) {\n    pid_t pid = fork();\n    if (pid == 0)\n        exit(42);                          /* child status */\n\n    int status;\n    waitpid(pid, &status, 0);              /* block till it ends */\n    if (WIFEXITED(status))\n        printf(\"child exited with %d\\n\", WEXITSTATUS(status));\n    return 0;\n}"}]}]]}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Why engineers care",": "]}],"The exit status is the whole basis of shell scripting and CI: && and || chain commands on it, and a non-zero exit fails a pipeline. If your program returns the wrong code: 0 on failure, automation downstream will silently believe it worked."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L34",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch08%2F07-wait-and-exit.jpg?v=25b8c3511aa1cdec9ac6794612f840df","alt":"Hand-drawn A4 diagram: a parent process box with a downward arrow \"fork\" to a child; the child ends in an \"exit(status)\" box that sets a small \"exit status\" tag; a dashed arrow carries that status up to the parent, which is drawn blocked in \"waitpid()\" and then resuming with WEXITSTATUS pulling the number out."}],"$L3d"]}]]}]]}]
31:["$","section","08-zombies-and-orphans",{"id":"08-zombies-and-orphans","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"08"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Zombies & orphans"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Two things can go wrong with the parent-child lifecycle, and both have vivid names. A zombie is a child that has terminated but whose parent has not yet called wait to reap it. The child is dead, it holds no memory or CPU, but the kernel must keep its PCB remnant (PID and exit status) alive so the answer is there when the parent finally asks. In ps you see it as state Z and the tag <defunct>."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A single short-lived zombie is harmless. The danger is a long-running parent that forks many children and never waits: each dead child leaves a zombie holding a PID, and because PIDs are a finite resource, a program that leaks them steadily can exhaust the process table until the machine cannot fork anything new. This is a real production failure mode for badly written servers and supervisors."}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"An orphan is the mirror image: a child whose parent exits first, while the child is still running. The child is not in trouble, the kernel simply reparents it, handing it to a special long-lived process (traditionally init, PID 1, or a subreaper). That new parent’s job includes calling wait, so when the orphan eventually exits it is reaped cleanly and never becomes a lasting zombie."}],["$","figure","3",{"className":"overflow-hidden rounded-lg border border-ink/15 bg-ink/[0.04]","children":[["$","div",null,{"className":"flex items-center justify-between border-b border-ink/10 bg-ink/[0.03] px-3.5 py-1.5","children":[["$","span",null,{"className":"font-mono text-[0.7rem] uppercase tracking-wide text-mute","children":"A zombie seen in ps: dead, but still holding a PID until reaped."}],["$","span",null,{"className":"font-mono text-[0.7rem] text-accent/70","children":"bash"}]]}],["$","pre",null,{"className":"overflow-x-auto px-4 py-3 text-[0.86rem] leading-[1.6]","children":["$","code",null,{"className":"font-mono text-ink/90","children":"$$ ps -o pid,ppid,state,comm\n  PID  PPID S COMMAND\n 4123  4120 Z sleep <defunct>   # Z = zombie, waiting to be reaped\n 4120  2891 S server            # its parent, still running"}]}]]}],["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Gotcha",": "]}],"The fix for zombies is not to kill them, they are already dead. You fix the parent: make it call wait/waitpid, or handle SIGCHLD, so every child it forks is eventually reaped. In containers this is why PID 1 must be a real init that reaps, or zombies pile up."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L34",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch08%2F08-zombies-and-orphans.jpg?v=4b75c027cdb05e2d70e008287bfd714e","alt":"Hand-drawn A4 diagram split in two: LEFT \"zombie\", a child in a dashed tombstone box marked \"exited, state Z\" with its PID still held, arrow to a distracted parent that has not called wait(); RIGHT \"orphan\", a live child whose parent box is crossed out, a re-pointing arrow labelled \"reparented to init (PID 1)\" which then reaps it."}],"$L3e"]}]]}]]}]
32:["$","section","09-process-vs-thread",{"id":"09-process-vs-thread","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"09"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Process vs thread & why engineers care"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Everything so far has treated a process as a single line of execution. But a process can contain several threads, independent streams of execution that share the same address space. That is the pivotal contrast: separate processes each get their own private memory and isolation, while threads inside one process share the heap, the globals, and the open files, and differ only in their own stack and registers. Sharing makes threads cheap and fast to communicate, but it is exactly what makes concurrency bugs possible. We devote the whole next chapter to threads."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"You can inspect all of this on a live system without any C. ps shows the process table with PID, PPID, and state; on Linux the /proc filesystem exposes each process’s PCB as readable files, /proc/PID/status has its state and memory, /proc/PID/fd lists its open descriptors, /proc/PID/maps shows the address space. When you debug a stuck or bloated service, this is where you look first."}],["$","figure","2",{"className":"overflow-hidden rounded-lg border border-ink/15 bg-ink/[0.04]","children":[["$","div",null,{"className":"flex items-center justify-between border-b border-ink/10 bg-ink/[0.03] px-3.5 py-1.5","children":[["$","span",null,{"className":"font-mono text-[0.7rem] uppercase tracking-wide text-mute","children":"Linux exposes each process’s kernel record under /proc."}],["$","span",null,{"className":"font-mono text-[0.7rem] text-accent/70","children":"bash"}]]}],["$","pre",null,{"className":"overflow-x-auto px-4 py-3 text-[0.86rem] leading-[1.6]","children":["$","code",null,{"className":"font-mono text-ink/90","children":"$$ ps -o pid,ppid,state,comm -p 4120\n  PID  PPID S COMMAND\n 4120  2891 S server\n$ ls /proc/4120/          # the PCB, as files\ncmdline  fd/  maps  status  task/  wchan"}]}]]}],["$","ul","3",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"fork is cheap because of copy-on-write, so fork-per-request servers (classic Apache prefork, CGI) are viable, but each process carries full isolation overhead."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Thread pools reuse a few processes and many threads to avoid even that cost, at the price of shared-memory bugs to guard against."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Postgres uses one OS process per client connection, strong isolation, a crash in one backend cannot corrupt another."}]]}],["$","li","3",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":["$L3f","$L40"]}]]}],"$L41"]}],"$L42"]}]]}]
