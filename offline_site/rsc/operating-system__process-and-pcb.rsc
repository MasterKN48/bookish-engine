36:["$","div","5",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Process table"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The kernel-wide collection of all PCBs, so the OS can find and manage every process by PID."}]]}]
37:["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Remember",": "]}],"When someone says \"the kernel switched to another process\", they mean it saved the current PCB’s registers and loaded another PCB’s. The PCB is where a paused process lives while it waits its turn."]}]]}]
38:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L34",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch08%2F03-the-pcb.jpg?v=8a1bb1b158f9d15620d954295b27c85a","alt":"Hand-drawn A4 diagram: a single labelled \"PCB\" card listing its fields in rows: PID/PPID, state, saved registers + program counter, memory maps (pointer to page tables), open-file table, scheduling info (priority, time used), accounting, parent/children, and beside it a \"process table\" drawn as an array of such cards indexed by PID."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
