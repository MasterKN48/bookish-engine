23:["$","div",null,{"className":"flex min-w-0 flex-1 flex-col gap-16","children":[["$","section","01-what-is-routing",{"id":"01-what-is-routing","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"01"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"What routing actually is"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Routing is the process of moving a packet across multiple networks toward its destination. No single router knows the whole path, each one just makes one decision: given this destination IP, what is the best next hop?"}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch11%2F01-what-is-routing.jpg?v=a9c1b13366f3cc5f6ff2549135b0d5a9","alt":"A path highlighted through a mesh of routers from a laptop to a server."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}],["$","section","02-routing-table",{"id":"02-routing-table","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The routing table"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Every router keeps a routing table: a list of destination networks (in CIDR) mapped to the next hop and outgoing interface. When a packet arrives, the router looks up the destination IP in this table to decide where to send it."}],["$","dl","1",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Destination"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"A network in CIDR form, e.g. 10.0.0.0/8."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Next hop"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The IP of the next router to forward to (or \"direct\")."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Interface"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Which physical port to send out of."}]]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch11%2F02-routing-table.jpg?v=859b738183ff59e59faf3a17a3a3bc05","alt":"A routing table with Destination, Next Hop and Interface columns."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}],["$","section","03-hop-by-hop",{"id":"03-hop-by-hop","className":"scroll-mt-8","children":["$L26","$L27"]}],"$L28","$L29","$L2a","$L2b"]}]
24:["$","$L2c",null,{"prev":{"slug":"tcp-ip-and-osi-models","title":"The TCP/IP & OSI Models","kind":"$undefined","number":10},"next":{"slug":"icmp-ping-traceroute","title":"ICMP: ping & traceroute","kind":"$undefined","number":12}}]
26:["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Hop by hop (and TTL)"}]]}]
27:["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The packet is forwarded from router to router, each doing its own lookup. To prevent packets looping forever, the IP header carries a TTL (Time To Live) that each router decrements by one. If TTL reaches 0, the packet is dropped, a safety valve we will exploit in traceroute."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch11%2F03-hop-by-hop.jpg?v=3ef2fbc42a1e347cede40313409d9324","alt":"A packet crossing routers with TTL decrementing 64, 63, 62."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]
28:["$","section","04-mac-changes",{"id":"04-mac-changes","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"IP stays, MAC changes"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"This is the crucial insight. The destination IP is end-to-end, it identifies the final server and never changes along the way. But the frame’s MAC addresses are hop-to-hop: at each router the frame is unwrapped, and a new frame is built with the source MAC = this router and the destination MAC = the next router (found via ARP)."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Remember",": "]}],"IP = the whole journey. MAC = only the current hop. This is exactly why you need both addresses."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch11%2F04-mac-changes.jpg?v=58ff11c2cfd5698f246a3bdbb670b7ff","alt":"At each hop the destination IP stays the same but the destination MAC becomes the next router."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
29:["$","section","05-longest-prefix",{"id":"05-longest-prefix","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Longest prefix match"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A destination might match several routes in the table. The router always picks the most specific one, the longest prefix. So 10.1.2.3 matching both 10.0.0.0/8 and 10.1.0.0/16 goes via the /16, because /16 is more specific than /8."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch11%2F05-longest-prefix.jpg?v=99b839eaec9f406e849689335d237864","alt":"Target 10.1.2.3 matching /16 over /8, most specific route wins."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
2a:["$","section","06-static-dynamic",{"id":"06-static-dynamic","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Static vs dynamic routing"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Routing tables can be filled in two ways. Static routes are configured by hand, fine for small setups. Dynamic routing lets routers exchange reachability information automatically using routing protocols like RIP, OSPF, and BGP (the protocol that glues the whole internet together)."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch11%2F06-static-dynamic.jpg?v=1b7d4f01970eccca0184243701dea55a","alt":"Static routes set by hand vs dynamic routing via RIP/OSPF/BGP."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
2b:["$","section","07-default-route",{"id":"07-default-route","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"07"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The default route"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"What if nothing in the table matches? Routers use a default route, written 0.0.0.0/0, the \"when in doubt, send it here\" entry, usually pointing at the ISP. Your own laptop has one too: its default route points at your default gateway."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L25",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch11%2F07-default-route.jpg?v=8f9696b72f14aa5328bd6c57553d2337","alt":"A signpost 0.0.0.0/0 pointing to the ISP for anything unmatched."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
