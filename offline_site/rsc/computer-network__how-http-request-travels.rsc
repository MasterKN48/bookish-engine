 layer, like putting a letter in an envelope, the envelope in a box, the box in a shipping crate, each layer adding the addressing the next hop needs."}]]}]]}]}],["$","div",null,{"className":"mx-auto max-w-5xl px-5 pt-12 sm:px-8","children":["$","$L21",null,{}]}],["$","div",null,{"className":"mx-auto flex max-w-6xl gap-10 px-5 py-12 sm:px-8","children":[["$","nav",null,{"className":"sticky top-8 hidden h-fit w-56 shrink-0 lg:block","children":[["$","p",null,{"className":"mb-3 font-hand text-xl font-bold text-ink","children":"On this page"}],["$","ol",null,{"className":"flex flex-col gap-1.5 text-sm","children":[["$","li","01-the-setup",{"children":["$","a",null,{"href":"#01-the-setup","className":"flex gap-2 rounded-md px-2 py-1 text-mute transition hover:bg-accent/10 hover:text-accent","children":[["$","span",null,{"className":"text-accent/70","children":"01"}],["$","span",null,{"className":"leading-snug","children":"The setup"}]]}]}],["$","li","02-four-tuple",{"children":["$","a",null,{"href":"#02-four-tuple","className":"flex gap-2 rounded-md px-2 py-1 text-mute transition hover:bg-accent/10 hover:text-accent","children":[["$","span",null,{"className":"text-accent/70","children":"02"}],["$","span",null,{"className":"leading-snug","children":"The connection is a 4-tuple"}]]}]}],["$","li","03-dns-step",{"children":["$","a",null,{"href":"#03-dns-step","className":"flex gap-2 rounded-md px-2 py-1 text-mute transition hover:bg-accent/10 hover:text-accent","children":[["$","span",null,{"className":"text-accent/70","children":"03"}],["$","span",null,{"className":"leading-snug","children":"Step 1: DNS turns the name into an IP"}]]}]}],["$","li","04-http-request",{"children":["$","a",null,{"href":"#04-http-request","className":"flex gap-2 rounded-md px-2 py-1 text-mute transition hover:bg-accent/10 hover:text-accent","children":[["$","span",null,{"className":"text-accent/70","children":"04"}],["$","span",null,{"className":"leading-snug","children":"Step 2: Build the HTTP 