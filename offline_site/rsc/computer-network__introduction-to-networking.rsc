2b:["$","div",null,{"className":"flex min-w-0 flex-1 flex-col gap-16","children":[["$","section","01-why-networking",{"id":"01-why-networking","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"01"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Why networking matters for developers"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Modern software is networked software. The frontend you build talks to a backend; the backend talks to databases, third-party APIs, and other services. Streaming a video, loading a web page, or sending a chat message all boil down to packets moving across wires and radio waves."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Because so much rides on the network, understanding it stops being optional. When a request is slow, times out, or silently fails, the engineers who understand the network can actually debug it, instead of guessing and restarting things until it works."}],["$","ul","2",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"You make hundreds of HTTP requests a day, mostly without noticing."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"The network is the invisible layer connecting every service you write."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"The goal of this series: replace \"it just works\" with \"I know exactly what happens under the hood\"."}]]}]]}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Mindset",": "]}],"We will keep asking one question for every topic: what is really happening on the wire, step by step?"]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L2d",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch1%2F01-why-networking.jpg?v=5beb84709a86e5954eb36cf1671b8587","alt":"Handwritten notes: a developer firing GET/POST requests through the internet cloud to YouTube, Netflix and API servers."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}],["$","section","02-http-journey",{"id":"02-http-journey","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"What happens when you make an HTTP request?"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":["$L2e","$L2f","$L30","$L31"]}],"$L32"]}]]}],"$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c"]}]
2c:["$","$L3d",null,{"prev":null,"next":{"slug":"how-http-request-travels","title":"How an HTTP Request Travels","kind":"$undefined","number":1}}]
2e:["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"This is the very first deep-dive of the series, and the question that ties everything together. You type a URL or your app calls an endpoint, and moments later a response appears. Between those two moments, a lot happens."}]
2f:["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"At a high level, the request has to find where the server lives, travel across many networks to get there, be understood by the server, and then make the whole trip back. Each of those steps is powered by a different protocol, and each becomes its own chapter later."}]
30:["$","dl","2",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"You type a URL"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The browser or app starts a request (GET, POST, etc.)."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"DNS lookup"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The human name (like example.com) is turned into an IP address."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Routing"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Packets hop across routers and networks toward that IP."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Server"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The destination machine processes the request."}]]}],["$","div","4",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Response"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The answer travels all the way back to you."}]]}]]}]
31:["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Heads-up",": "]}],"You do not need to fully understand this yet. It is the trailer, every scene gets its own detailed chapter."]}]]}]
