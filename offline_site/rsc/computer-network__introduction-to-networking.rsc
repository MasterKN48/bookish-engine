17:["$","main",null,{"id":"top","children":[["$","header",null,{"className":"border-b border-ink/10 bg-surface/40","children":["$","div",null,{"className":"mx-auto max-w-5xl px-5 py-10 sm:px-8","children":[["$","$Ld",null,{"href":"/computer-network","className":"inline-flex items-center gap-1.5 text-sm font-semibold text-mute transition hover:text-accent","children":"← All chapters"}],["$","div",null,{"className":"mt-5 flex items-center gap-2 text-sm font-semibold text-accent","children":[["$","span",null,{"className":"rounded-full bg-accent/12 px-2.5 py-0.5","children":"Introduction"}],["$","span",null,{"className":"text-mute","children":["· ",9," min read · illustrated"]}]]}],["$","h1",null,{"className":"mt-3 font-hand text-5xl font-bold leading-tight text-ink sm:text-6xl","children":"Introduction to Networking"}],["$","p",null,{"className":"mt-2 text-lg text-mute","children":"Why networks matter to developers, and the road ahead"}],["$","div",null,{"className":"mt-6 flex max-w-2xl flex-col gap-3","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/85","children":"Every single day, without thinking about it, you fire off hundreds of HTTP requests, opening YouTube, scrolling Netflix, hitting an API from your frontend, or spinning up a server that answers GET and POST calls. All of that is network communication. As a software engineer you lean on the network constantly, yet most of us treat it as a black box: we send a request, a response comes back, and the middle is magic."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/85","children":"This chapter is the map for the whole series. We are not going to master every protocol here, instead we will take a guided tour of what actually happens under the hood, and preview each concept we will later break down in depth. If some ideas feel fuzzy right now, that is expected: the goal is to plant the vocabulary so the deep-dive chapters click into place."}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/85","children":"This series is written for developers who already know what a server, a frontend, and an HTTP request are, but want to see what is really happening on the wire."}]]}]]}]}],"$undefined",["$","div",null,{"className":"mx-auto flex max-w-6xl gap-10 px-5 py-12 sm:px-8","children":[["$","nav",null,{"className":"sticky top-8 hidden h-fit w-56 shrink-0 lg:block","children":[["$","p",null,{"className":"mb-3 font-hand text-xl font-bold text-ink","children":"On this page"}],["$","ol",null,{"className":"flex flex-col gap-1.5 text-sm","children":[["$","li","01-why-networking",{"children":["$","a",null,{"href":"#01-why-networking","className":"flex gap-2 rounded-md px-2 py-1 text-mute transition hover:bg-accent/10 hover:text-accent","children":[["$","span",null,{"className":"text-accent/70","children":"01"}],["$","span",null,{"className":"leading-snug","children":"Why networking matters for developers"}]]}]}],["$","li","02-http-journey",{"children":["$","a",null,{"href":"#02-http-journey","className":"flex gap-2 rounded-md px-2 py-1 text-mute transition hover:bg-accent/10 hover:text-accent","children":[["$","span",null,{"className":"text-accent/70","children":"02"}],["$","span",null,{"className":"leading-snug","children":"What happens when you make an HTTP request?"}]]}]}],["$","li","03-fundamentals-map",{"children":["$","a",null,{"href":"#03-fundamentals-map","className":"flex gap-2 rounded-md px-2 py-1 text-mute transition hover:bg-accent/10 hover:text-accent","children":[["$","span",null,{"className":"text-accent/70","children":"03"}],["$","span",null,{"className":"leading-snug","children":"Networking fundamentals, our base layer"}]]}]}],["$","li","04-routing",{"children":["$","a",null,{"href":"#04-routing","className":"flex gap-2 rounded-md px-2 py-1 text-mute transition hover:bg-accent/10 hover:text-accent","children":["$L21","$L22"]}]}],"$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a"]}]]}],"$L2b"]}],"$L2c"]