28:["$","div",null,{"className":"flex min-w-0 flex-1 flex-col gap-16","children":[["$","section","01-storage-is-slow",{"id":"01-storage-is-slow","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"01"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Why storage is the slow part"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Think of the memory hierarchy as a set of shelves, each one bigger and slower than the one above it. At the top the CPU registers and caches answer in about a nanosecond; main memory answers in roughly a hundred. Then comes a cliff. A read that misses memory and has to reach a spinning hard disk can take around ten milliseconds, and ten milliseconds is not \"a bit slower\", it is on the order of a hundred thousand times slower than RAM. A solid-state drive narrows the gap enormously, to tens or hundreds of microseconds, but it is still an order of magnitude or two below memory."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"To feel the scale, borrow the old trick of turning nanoseconds into human time. If a CPU cache hit were one second, a main-memory access would be a couple of minutes, an SSD read would be a day or two, and a single seek on a hard disk would be the better part of a year. That is the mountain the OS is climbing every time your program touches persistent storage, and it explains almost everything the storage stack does."}],["$","ul","2",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Storage is where the memory hierarchy bottoms out: huge capacity, permanence, and brutal latency compared to RAM."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Because a device is so slow, the CPU must never simply sit and wait for it, the OS overlaps I/O with other work (this is why we schedule)."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Because a device is so slow, the OS caches aggressively in RAM (the page cache) so most reads never reach the disk at all."}]]}],["$","li","3",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Because a device is so slow, the *order* in which pending requests are served can change total time dramatically, the heart of this chapter."}]]}]]}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["The through-line",": "]}],"Every technique in this chapter, scheduling, caching, batching, sequential layout, exists for one reason: the device is thousands of times slower than the CPU asking it for data, and that CPU has better things to do than wait."]}]]}]]}],"$L2a"]}]]}],"$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31"]}]
29:["$","$L32",null,{"prev":{"slug":"io-hardware-and-software","title":"I/O Hardware & Software Layers","kind":"$undefined","number":26},"next":{"slug":"files-and-directories","title":"Files & Directories","kind":"$undefined","number":28}}]
33:I[76156,["2619","static/chunks/2619-04bc32f026a0d946.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs","6238","static/chunks/app/operating-system/%5Bchapter%5D/page-6f5feff9906adfcd.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs"],"NoteImage"]
2a:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch27%2F01-storage-is-slow.jpg?v=1e990693d8c3139a0b365da6e0b07f5a","alt":"Handwritten A4 diagram: a vertical memory-hierarchy pyramid with CPU registers and L1/L2 cache at the narrow top (labelled ~1 ns), RAM in the middle (~100 ns), then a thick jagged \"latency cliff\" line, and at the wide bottom two boxes: SSD (~100 µs) and HDD (~10 ms), with a bracket on the right showing the drop is roughly 100,000× from RAM to disk; a small clock icon beside each level."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
2b:["$","section","02-hdd-anatomy",{"id":"02-hdd-anatomy","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"HDD anatomy & the cost model"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A hard disk drive is one of the last pieces of fast-moving mechanical engineering left in a modern computer. Inside the sealed case, one or more rigid platters coated in magnetic material spin at a constant speed, commonly 7200 revolutions per minute in a desktop drive. A read/write head floats a fraction of a micron above each surface on the end of an arm, and the arm pivots in and out to reach different distances from the centre. Data is stored by magnetising tiny regions of the surface as the platter rushes past the head."}],["$","dl","1",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Platter"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"A rigid magnetic disk that spins; a drive stacks several, usually with a head on each surface."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Track"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"One concentric ring of data on a platter surface; the head reads a whole track as the platter rotates under it."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Sector"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The smallest addressable chunk on a track, historically 512 bytes, now typically 4 KB (the physical unit of I/O)."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Cylinder"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The set of same-radius tracks across all platters, reachable without moving the arm, cheap to access together."}]]}],["$","div","4",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Head & arm"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The read/write element and the actuator that pivots it to the right track; moving it is the slow, mechanical part."}]]}]]}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The reason a hard disk is slow is that reaching a specific sector is a three-part physical dance, and two of those parts involve waiting for mass to move. First the arm must swing until the head sits over the right track: that is the seek time, and it is the killer, a few milliseconds for a full-width swing, because you are physically accelerating and stopping a mechanical arm. Second, even once the head is on the right track, you must wait for the platter to rotate until the sector you want comes around under the head: that is rotational latency, and on a 7200 RPM drive one full rotation takes about 8.3 ms, so on average you wait half of that, roughly 4 ms. Only then comes the third part, transfer time, actually streaming the bytes off the surface, which is comparatively quick."}],"$L34","$L35"]}],"$L36"]}]]}]
2c:["$","section","03-disk-addressing",{"id":"03-disk-addressing","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Disk addressing: CHS to LBA"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"How does software name a particular sector? The original scheme, CHS, addressed a sector by its physical coordinates: which Cylinder, which Head (that is, which platter surface), and which Sector around the track. It was honest about the geometry, and that was exactly its problem, software had to know the drive’s physical shape, and real shapes stopped being uniform once manufacturers packed more sectors onto the longer outer tracks than the short inner ones."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Modern drives hide all of that behind Logical Block Addressing. LBA presents the entire disk as one long, flat array of fixed-size blocks numbered 0, 1, 2, up to N. The operating system asks for \"block 4,192,043\" and the drive’s own controller translates that number into whatever physical cylinder, head, and sector currently holds it. The geometry becomes the drive’s private business; the OS just sees a numbered array."}],["$","dl","2",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"CHS (Cylinder–Head–Sector)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The old physical address triple; exposed the drive’s real geometry and did not survive variable track sizes."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"LBA (Logical Block Addressing)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The modern scheme: the disk is one flat array of numbered blocks; the drive maps each number to real hardware."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Block / logical block"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The fixed-size unit the OS reads and writes (512 B historically, 4 KB on modern drives); the atom of disk I/O."}]]}]]}],["$","p","3",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"This flat, numbered array is one of the most important abstractions in the whole storage stack, because it is the surface that everything above builds on. The file system does not think in platters and heads; it thinks \"this file occupies blocks 812, 813, 814, and 990\". Whether those blocks live on a spinning HDD, an SSD, a RAID array, or a network volume, the interface is identical: read block N, write block N. That uniformity is exactly why the same file system code runs unchanged across wildly different hardware, and it is the abstraction the next three chapters on file systems assume from the first line."}],"$L37"]}],"$L38"]}]]}]
2d:["$","section","04-disk-scheduling",{"id":"04-disk-scheduling","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Disk scheduling algorithms"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"When several processes have I/O outstanding, the OS holds a queue of pending block requests for each drive. Because seek time dominates on an HDD, the *order* in which it services that queue changes the total arm travel, and therefore the total time, enormously. Disk scheduling is the policy that picks the order. We will use one running example throughout: a drive with cylinders 0 to 199, the head currently resting at cylinder 53, and a queue of requests for cylinders 98, 183, 37, 122, 14, 124, 65, 67."}],["$","dl","1",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"FCFS"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"First-come, first-served: service requests in arrival order. Perfectly fair, but the arm can whipsaw across the disk."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"SSTF"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Shortest-seek-time-first: always serve the nearest pending cylinder. Fast on average, but can starve far-away requests."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"SCAN (elevator)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The arm sweeps in one direction serving everything in its path, reaches the end, then sweeps back, like a lift."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"C-SCAN"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Circular SCAN: sweep one way, then jump straight back to the start and sweep the same way again, more uniform waits."}]]}],["$","div","4",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"LOOK / C-LOOK"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Practical SCAN/C-SCAN that reverse at the last *request* instead of travelling to the physical end of the disk."}]]}]]}],["$","figure","2",{"className":"overflow-hidden rounded-lg border border-ink/15 bg-ink/[0.04]","children":[["$","div",null,{"className":"flex items-center justify-between border-b border-ink/10 bg-ink/[0.03] px-3.5 py-1.5","children":[["$","span",null,{"className":"font-mono text-[0.7rem] uppercase tracking-wide text-mute","children":"Worked head-movement trace, cylinders 0–199, head starts at 53."}],"$L39"]}],"$L3a"]}],"$L3b","$L3c","$L3d"]}],"$L3e"]}]]}]
2e:["$","section","05-ssd-flash",{"id":"05-ssd-flash","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"SSDs & the flash reality"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A solid-state drive throws away the platters and the arm entirely and stores bits in NAND flash memory cells. With no mass to move, the whole seek-and-rotate cost model of the previous sections evaporates: any location is reachable in roughly the same tens of microseconds, and random reads become nearly as cheap as sequential ones. That alone is why SSDs feel transformative. But flash comes with its own hard constraint that shapes everything about how the drive behaves, and it is not the one people expect."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Flash is organised into pages (the unit you read and write, typically 4–16 KB) grouped into much larger erase blocks (often hundreds of pages). The awkward rule is this: you can read any page freely, and you can write a page, but only if it is already erased, and you cannot erase a single page. Erasing happens only a whole block at a time. So flash cannot overwrite data in place the way a disk sector can. To change one page inside a full block, the drive must write the new version somewhere already-erased and mark the old copy dead, later reclaiming whole blocks in bulk."}],["$","dl","2",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Page"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The unit flash reads and writes, a few KB. You can write a page only if it is currently erased."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Erase block"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"A large group of pages; erasing is only possible for a whole block at once, the root of flash’s complexity."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"FTL (Flash Translation Layer)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Firmware inside the SSD that maps logical block numbers to physical pages, hiding erase-before-write from the OS."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Wear levelling"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Spreading writes across all blocks so no cell wears out early, flash cells survive only a limited number of erases."}]]}],["$","div","4",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":["$L3f","$L40"]}],"$L41"]}],"$L42","$L43","$L44"]}],"$L45"]}]]}]
2f:["$","section","06-hdd-vs-ssd-os",{"id":"06-hdd-vs-ssd-os","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"HDD vs SSD & what changed for the OS"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The arrival of SSDs quietly demoted one of the proudest ideas in this chapter. The elevator algorithms exist to minimise arm travel, but an SSD has no arm. Reordering requests by logical block number no longer shortens any physical path, because \"nearby\" block numbers are not physically nearer on flash. So on an SSD, the elaborate seek-minimising schedulers buy almost nothing, and the CPU time spent sorting the queue can even cost more than it saves. What the OS wants from a fast SSD is mostly to get out of the way."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Linux reflects this directly in its I/O schedulers. For a spinning disk you still want a seek-aware, fairness-aware policy, mq-deadline (which bounds how long any request can wait) or BFQ (which shares bandwidth fairly between processes and keeps the desktop responsive). For a fast NVMe SSD the common choice is literally none: submit requests straight to the device and let the drive’s own parallelism sort it out."}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"That parallelism is the other big shift. Old drives sat behind a single request queue, one arm, one thing at a time. A modern NVMe SSD has many independent flash channels and is built for deep, parallel request queues, so Linux moved to a multi-queue block layer (blk-mq) with a queue per CPU feeding the device. The bottleneck is no longer \"when does the arm get there\"; it is \"keep enough requests in flight to saturate the flash\". Scheduling for throughput now means concurrency, not ordering."}],["$","ul","3",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"On HDDs, request ordering (SCAN/LOOK, mq-deadline, BFQ) still matters a great deal, seek time is real."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"On SSDs, ordering barely helps; the \"none\" scheduler plus deep parallel queues (blk-mq / NVMe) is usually best."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Partition and file-system alignment to the SSD’s erase-block/page size avoids splitting one logical write across two physical blocks (which doubles the erase work)."}]]}],["$","li","3",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Either way, the biggest win is still upstream in the OS: the page cache serving reads from RAM so the device is never asked at all."}]]}]]}],"$L46"]}],"$L47"]}]]}]
30:["$","section","07-raid",{"id":"07-raid","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"07"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Reliability: RAID in brief"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A single drive is one point of failure and one source of bandwidth. RAID, a Redundant Array of Independent Disks, combines several physical drives into one logical volume to buy speed, safety, or both. Two primitives do all the work. Striping spreads consecutive blocks across drives so several can be read or written at once, multiplying bandwidth. Mirroring keeps identical copies on more than one drive so that if one dies the data survives. Parity is the clever compromise: store extra check information so the array can rebuild a lost drive’s contents without paying for a full second copy."}],["$","dl","1",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"RAID 0 (striping)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Blocks striped across drives for maximum speed and full capacity, but zero redundancy; one drive lost loses everything."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"RAID 1 (mirroring)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Every block written to two drives. Survives a drive failure and reads fast, at the cost of half your capacity."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"RAID 5 (striping + parity)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Data plus a rotating parity block across three or more drives; survives any one failure with only one drive’s worth of overhead."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"RAID 10 (1+0)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Mirrored pairs, then striped across them: the speed of striping with the safety of mirroring, the priciest common choice."}]]}]]}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The point is not to memorise level numbers but to see the axis they sit on: performance versus redundancy versus cost, pick your balance. RAID 0 is pure performance and pure risk. RAID 1 is pure safety at double the disks. RAID 5 tries to have both cheaply and mostly succeeds, though rebuilding a failed drive is slow and stresses the survivors. RAID 10 is what databases often run on when they can afford it. And a caution that outlives every level: RAID protects against a drive dying, not against a bad deploy deleting your data: RAID is not a backup."}],"$L48"]}],"$L49"]}]]}]
31:["$","section","08-storage-for-engineers",{"id":"08-storage-for-engineers","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"08"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Storage for engineers"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Everything in this chapter converges on one rule you will use for the rest of your career: sequential access beats random access, and it beats it by a lot. On an HDD it is the difference between one seek and a thousand; on an SSD it is the difference between clean large writes and a storm of small ones that inflate garbage collection and write amplification. This is why serious data systems bend over backwards to turn random writes into sequential ones."}],["$","ul","1",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"A write-ahead log (WAL) appends every change to the end of one file before touching the real data, turning random updates into a sequential append, and giving crash recovery for free. Postgres, MySQL/InnoDB, and SQLite all do this."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Log-structured merge trees (LSM), behind Cassandra, RocksDB, and LevelDB, buffer writes in memory and flush them as large sequential runs, then merge in the background, random writes become sequential batches."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Databases align their page size to the device block size (commonly 4 KB or a multiple) so one logical page is one physical I/O, never a torn write across two blocks."}]]}],["$","li","3",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"On SSDs, over-writing in place still means erase-later work under the hood, so append-only and copy-on-write designs are gentle on the flash as well as fast."}]]}]]}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"When storage is the suspect, measure before you guess, and on Linux the first tool is iostat. It shows per-device throughput, how long requests are waiting, and how busy each device is, which tells you at a glance whether a slow service is actually I/O-bound and, if so, on which device."}],["$","figure","3",{"className":"overflow-hidden rounded-lg border border-ink/15 bg-ink/[0.04]","children":[["$","div",null,{"className":"flex items-center justify-between border-b border-ink/10 bg-ink/[0.03] px-3.5 py-1.5","children":[["$","span",null,{"className":"font-mono text-[0.7rem] uppercase tracking-wide text-mute","children":"iostat -x reveals a saturated HDD hiding behind a healthy SSD."}],["$","span",null,{"className":"font-mono text-[0.7rem] text-accent/70","children":"bash"}]]}],"$L4a"]}],"$L4b","$L4c"]}],"$L4d"]}]]}]
34:["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["The one fact to remember",": "]}],"Sequential I/O pays the seek-and-rotate cost once and then streams; random I/O pays a fresh seek plus rotational wait for every single request. That is why random reads on an HDD can be a hundred times slower than sequential reads of the very same amount of data."]}]]}]
35:["$","p","4",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Put numbers on it. A drive that streams sequentially at 150 MB/s can read a megabyte in well under 10 ms once the head is in place. But if you ask it for 256 scattered 4 KB blocks, each one costs a seek plus half a rotation before any bytes flow, call it 8 ms of pure waiting per request, over 2 seconds of nothing but arm-swinging and spinning for the same one megabyte of data. The disk was never \"reading\" for most of that time; it was waiting for metal to arrive. This single asymmetry is why the OS works so hard to turn random access into sequential access, and why the next few sections exist at all."}]
36:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch27%2F02-hdd-anatomy.jpg?v=8b0822d0ebb10dde667cd72ae1293182","alt":"Handwritten A4 diagram: a top-down view of a hard-disk platter drawn as concentric circles, the rings labelled \"tracks\", a pie-slice wedge labelled \"sector\", and one highlighted track with an arrow to a stacked side-view showing several platters on a spindle with a comb of read/write heads on a pivoting arm; three labelled arrows break a single access into \"1. seek time (arm moves to track)\", \"2. rotational latency (wait for sector to spin under head)\", and \"3. transfer time (read the bytes)\"; a note reads \"same-numbered tracks across platters = a cylinder\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
37:["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Why it still matters",": "]}],"Because LBA hides geometry, the OS can no longer *know* which blocks are physically adjacent, but on an HDD, nearby LBA numbers are still usually nearby on the platter. Disk scheduling leans on exactly that assumption: reorder requests by block number and you tend to reorder them into a shorter physical path."]}]]}]
38:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch27%2F03-disk-addressing.jpg?v=aa20848dee082aca0bc1f971b4c2d940","alt":"Handwritten A4 diagram: on the left an old-style triple (Cylinder, Head, Sector) with three little dials pointing at a physical platter location; a bold arrow labelled \"abstraction\" points right to a long horizontal strip of numbered boxes 0,1,2,3,…,N labelled \"Logical Block Addressing, one flat array of blocks\"; below the strip a caption \"the file system only ever sees block numbers; the drive maps them to real geometry\" and a small note \"block size = 512 B or 4 KB\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
39:["$","span",null,{"className":"font-mono text-[0.7rem] text-accent/70","children":"text"}]
3a:["$","pre",null,{"className":"overflow-x-auto px-4 py-3 text-[0.86rem] leading-[1.6]","children":["$","code",null,{"className":"font-mono text-ink/90","children":"Queue: 98, 183, 37, 122, 14, 124, 65, 67\n\nFCFS  (arrival order)\n  53→98→183→37→122→14→124→65→67\n   45 +85 +146+ 85+108+110+ 59+ 2   = 640\n\nSSTF  (always nearest pending)\n  53→65→67→37→14→98→122→124→183\n   12 + 2 +30 +23 +84 +24 +  2+ 59  = 236\n\nSCAN  (elevator: sweep up to 199, then back down)\n  up:   53→65→67→98→122→124→183→199   = 146\n  down: 199→37→14                     = 185\n  total                               = 331\n\nFor reference, on the same queue:\n  LOOK   (up to 183, then back to 14)        = 299\n  C-SCAN (up to 199, wrap to 0, up to 37)    = 382\n  C-LOOK (up to 183, jump to 14, up to 37)   = 322"}]}]
3b:["$","p","3",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Read the arithmetic and the trade-offs jump out. FCFS is scrupulously fair but travels 640 cylinders because it obeys arrival order blindly: 183 then 37 alone throws the arm most of the way across the disk and back. SSTF cuts that to 236 by always grabbing the closest request, which is why greedy nearest-first feels so fast. But SSTF has a dark side: if requests keep arriving near the head, a request stranded out at cylinder 14 can wait indefinitely, that is starvation."}]
3c:["$","p","4",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"SCAN, the elevator algorithm, is the classic answer to starvation. Like a lift that finishes going up before it comes down, the arm sweeps in one direction serving every request it passes, then reverses. No request waits longer than two full sweeps, so nothing starves, and the total (331 here) sits comfortably between FCFS and SSTF. The refinements are small but real: C-SCAN sweeps only one way and jumps back to the start, which makes waiting times more uniform across the disk (a plain SCAN slightly favours the middle); and LOOK and C-LOOK simply refuse to trudge out to cylinder 0 or 199 when the last real request is at 14 or 183, which is why LOOK’s 299 beats SCAN’s 331 on the same queue. Real systems have long used LOOK-family policies rather than textbook SCAN."}]
3d:["$","div","5",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Trade-off in one line",": "]}],"FCFS optimises fairness, SSTF optimises average seek but risks starvation, and the SCAN/LOOK family optimises throughput while bounding the worst-case wait. Pick your poison by what the workload cannot tolerate."]}]]}]
3e:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch27%2F04-disk-scheduling.jpg?v=207736715e6352c8ab8b256b01103b47","alt":"Handwritten A4 diagram: a horizontal cylinder axis numbered 0 to 199 with tick marks at the request positions 14, 37, 65, 67, 98, 122, 124, 183 and a \"head = 53\" marker; three stacked head-movement traces drawn as zig-zag paths above the axis: FCFS as a wild back-and-forth scribble labelled 640, SSTF as a tighter path labelled 236, and SCAN as a single sweep up to 199 then back down labelled 331; a small elevator icon beside SCAN."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
3f:["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Garbage collection"}]
40:["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Background work that consolidates still-live pages and erases blocks full of dead data to reclaim free space."}]
41:["$","div","5",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"TRIM"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"A command letting the OS tell the SSD which blocks a deleted file no longer needs, so GC can skip copying dead data."}]]}]
42:["$","p","3",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The Flash Translation Layer is the firmware that makes all of this invisible. It keeps a map from logical block numbers (the flat LBA array the OS still thinks it is talking to) to the physical pages that currently hold them. When you \"overwrite\" block 900, the FTL quietly writes the new data to a fresh erased page and repoints the map, so the OS never sees the erase-before-write rule at all. On top of that mapping the FTL does two more essential jobs: wear levelling, which deliberately spreads writes so that hot data does not burn out one block while others sit idle (flash cells die after a finite number of erases), and garbage collection, which in the background gathers the still-live pages out of mostly-dead blocks and erases those blocks to refill the free pool."}]
43:["$","p","4",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"This is why the two directions are so asymmetric on an SSD. A read is a simple map lookup and a page fetch, fast and uniform. A write may trigger a cascade: find an erased page, update the map, and eventually cause garbage collection to copy live pages and erase blocks elsewhere. That hidden copying means the drive can physically write more bytes than you asked it to, write amplification, which both slows sustained writes and consumes the finite erase budget faster. TRIM helps by letting the OS tell the drive \"this block belongs to a file I deleted\", so garbage collection does not waste effort preserving data nobody wants."}]
44:["$","div","5",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["The mental model flip",": "]}],"On an HDD the enemy is the seek. On an SSD there is no seek, the enemy is the write, because writing means eventually erasing, and erasing is coarse, slow, and wears the cells out. Read cheap, write complicated."]}]]}]
45:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch27%2F05-ssd-flash.jpg?v=66e5ea214eb62648aa31da9a81b7686f","alt":"Handwritten A4 diagram: a NAND-flash chip drawn as a grid, the grid subdivided into large rectangles labelled \"erase block\" and each block further split into small rows labelled \"page (read/write unit)\"; three rules boxed on the right: \"read: any page, fast\", \"write: only to an erased page\", \"erase: only a whole block at once\"; below, a layer labelled \"FTL (Flash Translation Layer)\" mapping logical block numbers to physical pages, with side notes \"wear levelling\", \"garbage collection\", and \"TRIM\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
46:["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["What actually changed",": "]}],"The device got a hundred times faster and lost its moving parts, so the OS shifted its effort from \"reorder to cut seeks\" to \"stay out of the way and keep the queues full\". The scheduling chapter you just read still matters, mostly for the spinning disks that still store the world’s cold data cheaply."]}]]}]
47:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch27%2F06-hdd-vs-ssd-os.jpg?v=35d61795799a240840572c2edf4661be","alt":"Handwritten A4 comparison table on A4: two columns headed \"HDD\" and \"SSD\" with rows for random access (slow / fast), the dominant cost (seek time / write & erase), and \"does the elevator help? (yes, a lot / barely)\"; below the table a sketch of the Linux block layer, a single request queue feeding an HDD labelled \"mq-deadline / BFQ\" versus many parallel queues feeding an NVMe SSD labelled \"blk-mq, scheduler often = none\"; a small note \"align partitions to the erase block\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
48:["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Keep it in proportion",": "]}],"RAID is a redundancy-and-throughput tool that sits just below the file system, presenting many disks as one. It changes the failure and performance characteristics of the block device, but the file system on top still just reads and writes numbered blocks."]}]]}]
49:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch27%2F07-raid.jpg?v=30e18e294fd3c7a7ab957c1f41de4999","alt":"Handwritten A4 diagram: four small multi-disk sketches side by side: RAID 0 showing a block split A1/A2/A3 striped across two disks (labelled \"speed, no safety\"), RAID 1 showing the same block mirrored identically on two disks (labelled \"safety, half capacity\"), RAID 5 showing data blocks plus a \"P\" parity block rotating across three disks (labelled \"safety + capacity, survives 1 failure\"), and RAID 10 showing two mirrored pairs then striped (labelled \"speed + safety, costly\"); a caption \"one big reliable/fast volume out of many disks\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
4a:["$","pre",null,{"className":"overflow-x-auto px-4 py-3 text-[0.86rem] leading-[1.6]","children":["$","code",null,{"className":"font-mono text-ink/90","children":"$$ iostat -x 1\nDevice      r/s      w/s    rkB/s     wkB/s   r_await  w_await   aqu-sz  %util\nnvme0n1   120.0   3400.0   4800.0  210000.0     0.08     0.42     1.40   18.3\nsda        15.0    240.0    600.0    9800.0     6.20    14.80     3.90   98.6"}]}]
4b:["$","p","4",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Read that the way you would in an incident. The NVMe drive is barely breathing: 18% utilised, sub-millisecond waits, moving 200-plus MB/s of writes without strain. The spinning sda is pinned at 98.6% utilisation with a queue backing up and write waits of nearly 15 ms, that disk is the bottleneck, and no amount of CPU or memory tuning will help until the workload moves off it or its random writes are turned sequential. The high %util and await, not the throughput number, are the tells; a fast device can be saturated at a low MB/s if the access pattern is punishing it."}]
4c:["$","div","5",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Recap & hand-off",": "]}],"A disk is a slow, numbered array of blocks; an HDD pays for seeks and rotation, so the OS reorders requests with elevator-style scheduling, while an SSD hides an erase-before-write world behind its FTL and prefers you keep the queues full and the writes sequential. That flat block array is exactly the foundation the next chapters build on: how the file system turns numbered blocks into named files, directories, and inodes, and how it survives a crash."]}]]}]
4d:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L33",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch27%2F08-storage-for-engineers.jpg?v=b92791f5e07180629903338ce13a50eb","alt":"Handwritten A4 diagram: on the left two access patterns drawn on a block strip: \"random writes\" as scattered arrows landing all over, versus \"append-only log\" as arrows landing in one growing sequential run; an arrow labelled \"log-structured / LSM / WAL\" points from the messy pattern to the tidy one; on the right a mock terminal showing an \"iostat -x 1\" table with one device circled at %util 98.6 and high await, labelled \"this disk is the bottleneck\"; a forward arrow at the bottom points to \"→ file systems (ch28)\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
