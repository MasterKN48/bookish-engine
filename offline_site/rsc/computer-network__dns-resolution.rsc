24:["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Your device runs a tiny stub resolver that offloads the real work to a recursive resolver, usually run by your ISP or a public one like 8.8.8.8. The recursive resolver does all the asking around and returns just the final answer."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L23",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch20%2F03-resolver.jpg?v=f03a63fb57de10fa12c87b2942b53867","alt":"A stub resolver on the laptop asking a recursive resolver that does the work."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]
25:["$","section","04-recursive-walk",{"id":"04-recursive-walk","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Walking the tree"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"To resolve www.example.com the resolver asks in turn: the root (\"where is .com?\"), the .com TLD (\"where is example.com?\"), and finally example.com’s authoritative server (\"what is the IP?\"). Each step narrows it down until the address is found."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L23",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch20%2F04-recursive-walk.jpg?v=06116c064398d3eba5abcd562b23f941","alt":"Resolver asks Root, then TLD, then authoritative to get the IP."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
26:["$","section","05-caching",{"id":"05-caching","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Caching and TTL"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"That full walk would be slow to repeat, so every answer carries a TTL (time to live). Resolvers cache the record for that duration and answer subsequent queries instantly from cache, which is why the first lookup of a site is slower than the rest."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L23",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch20%2F05-caching.jpg?v=6adc0cb2d8e554ee947db42d7f339c68","alt":"A resolver caches a record with TTL 300s; a repeat lookup is instant."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
27:["$","section","06-iterative-recursive",{"id":"06-iterative-recursive","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Recursive vs iterative"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Two query styles exist. In a recursive query, you ask the resolver and it does everything, returning the final IP. In iterative queries (what the resolver itself uses upstream), each server simply replies with a referral to the next server to ask."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L23",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch20%2F06-iterative-recursive.jpg?v=6d02a628e56f7e511271e65c4cdbab89","alt":"Recursive: resolver does all the work; iterative: each server points to the next."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
28:["$","section","07-udp-tcp",{"id":"07-udp-tcp","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"07"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"DNS over UDP and TCP"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"DNS uses port 53. Most lookups go over UDP because they are small and fast, a single query and reply. But when a response is too large to fit, or for zone transfers between servers, DNS switches to TCP for reliable, larger transfers."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Modern note",": "]}],"Today DNS is increasingly encrypted too: DNS over HTTPS (DoH) and DNS over TLS (DoT) protect these queries from eavesdropping."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L23",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch20%2F07-udp-tcp.jpg?v=94a581b6cfd8f56fde4d341edd8f867a","alt":"DNS on port 53: UDP for normal queries, TCP for large responses/zone transfers."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
