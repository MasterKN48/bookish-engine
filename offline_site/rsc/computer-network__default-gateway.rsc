22:["$","section","02-same-direct",{"id":"02-same-direct","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Same network is easy"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"If the subnet-mask check says the target is on our network, we simply send directly to it (using its MAC address, a mechanism we cover soon). No problem there."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch05%2F02-same-direct.jpg?v=264742d292299c1d806c3b1af8d0f63b","alt":"Laptop and phone on the same network with a direct arrow."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
23:["$","section","03-problem",{"id":"03-problem","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The out-of-network problem"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The interesting case: we know the target’s IP (say DNS resolved a domain to it), but the subnet mask told us it is not on our network. We have an address, but no direct path. How do we send it?"}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch05%2F03-problem.jpg?v=e0665df430dd6a56bf1ec618c705e947","alt":"A laptop wondering how to send when the target IP is not on its network."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
24:["$","section","04-gateway-is-router",{"id":"04-gateway-is-router","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The default gateway is the router"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The answer is the default gateway, which in a home network is your router. When a device does not know how to reach an IP directly, it forwards the packet to its default gateway and effectively says: \"I do not know where this is, but I assume you do, please forward it.\""}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch05%2F04-gateway-is-router.jpg?v=7c3cc48000880cf368634c49db9e9839","alt":"Laptop handing a packet to a router labelled default gateway, which points to the internet."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
25:["$","section","05-forwarding",{"id":"05-forwarding","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The door to the outside world"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The router then routes the packet onward, possibly through many more routers, until it reaches the destination network. Your default gateway is the single door through which everything leaving your network passes."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Definition",": "]}],"The default gateway is the device that knows how to reach the outside network. To get anywhere beyond your own network, you go through it."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch05%2F05-forwarding.jpg?v=1f8076ab1bfd45f017c1dae1226e67cb","alt":"Laptop to router to router to router to a far server, forwarding hop by hop."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
26:["$","section","06-preconfigured",{"id":"06-preconfigured","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"How your device knows its gateway"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"You do not configure this yourself, the default gateway is set automatically when your device connects to the router (again via DHCP). It is typically the router’s own IP, like 192.168.1.1."}],["$","div","1",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Coming up",": "]}],"To actually hand the packet to the gateway, we need its MAC address, which pulls in MAC addresses and ARP, the next chapters."]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch05%2F06-preconfigured.jpg?v=aa76ed3008912b14dd0e81056c345dfa","alt":"A laptop connecting to a router, gateway set automatically as 192.168.1.1."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
