21:["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A brand-new device joining a network knows nothing, it has no IP, no gateway, no DNS. Configuring all of that by hand for every device would be painful and error-prone. DHCP (Dynamic Host Configuration Protocol) automates it completely."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch25%2F01-why-dhcp.jpg?v=e97b7e2b2b6defd33ccf4f4e342ce7f6","alt":"A new laptop joining a network with no IP yet."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]
22:["$","section","02-what-it-gives",{"id":"02-what-it-gives","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"What DHCP hands out"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"In one exchange, DHCP provides everything a device needs to be on the network:"}],["$","dl","1",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"IP address"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The device’s address on this network."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Subnet mask"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"So it can tell local from remote (Chapter 4)."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Default gateway"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The router to reach other networks (Chapter 5)."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"DNS server"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Where to resolve names to IPs."}]]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch25%2F02-what-it-gives.jpg?v=3b0b4f9958eb2881c8690222c0b2d0d2","alt":"A card listing IP, subnet mask, default gateway, DNS server."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
23:["$","section","03-dora",{"id":"03-dora","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"The DORA exchange"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"DHCP works in four steps, remembered as DORA:"}],["$","dl","1",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Discover"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Client: \"Is there a DHCP server out there?\""}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Offer"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Server: \"Yes, here is an IP you can use.\""}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Request"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Client: \"I would like that IP, please.\""}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Ack"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Server: \"It is yours, here are all the settings.\""}]]}]]}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch25%2F03-dora.jpg?v=f8bc1e81012c502c45395a79b4e5a318","alt":"Discover, Offer, Request, Ack between client and DHCP server."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
24:["$","section","04-discover-broadcast",{"id":"04-discover-broadcast","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Discover is a broadcast"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Here is a neat detail: the client has no IP yet, so it cannot address the DHCP server directly. Instead the Discover message is a broadcast to the entire network: \"will any DHCP server answer me?\" The server then replies with an offer."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch25%2F04-discover-broadcast.jpg?v=65f068de6d3842b04aa3d7db9941918e","alt":"A new laptop broadcasting to the whole network to find a DHCP server."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
25:["$","section","05-lease",{"id":"05-lease","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"IPs are leased, not owned"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"A DHCP address is a lease, it is yours only for a set time (say 24 hours). Before it expires, your device renews it. If a device leaves and never renews, its address returns to the pool for reuse. This is exactly why your IP can change (Chapter 8)."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch25%2F05-lease.jpg?v=9a0518a82263c4e9655e3728555c3004","alt":"An IP with a 24h lease timer that must be renewed."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
26:["$","section","06-reservation",{"id":"06-reservation","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Dynamic vs reserved"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Usually DHCP hands out any free IP from a pool (dynamic). But you can also configure a reservation so a specific device, identified by its MAC address, always receives the same IP. Handy for printers, servers, and anything you want to find at a predictable address."}]]}],["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L28",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/cn-notes/objects/ch25%2F06-reservation.jpg?v=78dac1cf9a3269dab4c2bebcc7d171af","alt":"Dynamic pool assignment vs a reservation tying a MAC to a fixed IP."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]]}]]}]
