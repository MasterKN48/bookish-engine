32:I[76156,["2619","static/chunks/2619-04bc32f026a0d946.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs","6238","static/chunks/app/operating-system/%5Bchapter%5D/page-6f5feff9906adfcd.js?dpl=dpl_7RkrhxkHMBxRwELcvSCn238CEijs"],"NoteImage"]
2a:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L32",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch16%2F01-why-classic-problems.jpg?v=b1e891df3fbdf3ce27bc53e4c6d32489","alt":"Handwritten A4 diagram: three labelled panels side by side, left, a bounded buffer box with \"producers\" arrows in and \"consumers\" arrows out; middle, a shared book with a crowd of \"readers\" allowed together but a single \"writer\" behind a locked door; right, five philosophers seated around a round table with a single fork drawn between each neighbouring pair. A banner across the top reads \"same three shapes, everywhere\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
33:T46e,#define N 8
int    buffer[N];
int    in = 0, out = 0;      /* next write / next read slot */

sem_t  empty;                /* free slots, init to N     */
sem_t  full;                 /* used slots, init to 0     */
pthread_mutex_t m;           /* guards in, out, buffer      */

/* setup: sem_init(&empty, 0, N); sem_init(&full, 0, 0); */

void producer(void) {
    for (;;) {
        int item = produce_item();
        sem_wait(&empty);                 /* one fewer free slot; blocks if full  */
        pthread_mutex_lock(&m);           /* enter critical section               */
        buffer[in] = item;
        in = (in + 1) % N;
        pthread_mutex_unlock(&m);
        sem_post(&full);                  /* one more item to consume             */
    }
}

void consumer(void) {
    for (;;) {
        sem_wait(&full);                  /* one fewer item; blocks if empty      */
        pthread_mutex_lock(&m);
        int item = buffer[out];
        out = (out + 1) % N;
        pthread_mutex_unlock(&m);
        sem_post(&empty);                 /* one more free slot                   */
        consume_item(item);
    }
}2b:["$","section","02-producer-consumer",{"id":"02-producer-consumer","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"02"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Producer–Consumer and the bounded buffer"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The setup: one or more producer threads generate items and put them into a shared buffer; one or more consumer threads take items out and process them. The buffer is bounded, it holds at most N items, because memory is finite and unbounded queues are how systems quietly die. Three things must never happen. A producer must never write into a full buffer, a consumer must never read from an empty one, and no two threads may touch the buffer’s internal state (the pointers, the count) at the same time."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Notice there are two completely different kinds of coordination hiding here. The buffer’s internal bookkeeping needs mutual exclusion, that is a job for a mutex. But \"wait until there is a free slot\" and \"wait until there is an item\" are not mutual exclusion at all; they are counting and waiting. That is exactly what a counting semaphore is for. Trying to solve the whole thing with one mutex is the classic beginner mistake; the elegance is in using the right tool for each of the two jobs."}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"So we use two counting semaphores and one mutex. The semaphore empty counts how many free slots remain and starts at N; the semaphore full counts how many filled slots exist and starts at 0. A producer waits on empty (blocking if the buffer is full), and after inserting, it signals full. A consumer is the mirror image: it waits on full (blocking if the buffer is empty), and after removing, it signals empty. The mutex is held only for the brief moment of actually touching the shared indices."}],["$","figure","3",{"className":"overflow-hidden rounded-lg border border-ink/15 bg-ink/[0.04]","children":[["$","div",null,{"className":"flex items-center justify-between border-b border-ink/10 bg-ink/[0.03] px-3.5 py-1.5","children":[["$","span",null,{"className":"font-mono text-[0.7rem] uppercase tracking-wide text-mute","children":"Bounded buffer with POSIX semaphores and a mutex, the canonical solution."}],["$","span",null,{"className":"font-mono text-[0.7rem] text-accent/70","children":"c"}]]}],["$","pre",null,{"className":"overflow-x-auto px-4 py-3 text-[0.86rem] leading-[1.6]","children":["$","code",null,{"className":"font-mono text-ink/90","children":"$33"}]}]]}],"$L34","$L35","$L36"]}],"$L37"]}]]}]
2c:["$","section","03-producer-consumer-real-world",{"id":"03-producer-consumer-real-world","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"03"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Producer–Consumer in the systems you build"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Producer–Consumer is not an exercise; it is arguably the most common concurrency pattern in all of software. The instant you have work being generated at one rate and processed at another, you reach for a queue between them, and that queue is a bounded buffer whether you call it that or not. Recognising the pattern tells you immediately what can go wrong and what the knobs mean."}],["$","ul","1",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Thread pools: a fixed set of worker threads (consumers) pull tasks off a shared work queue that your application code (producers) submits to. The pool’s queue is the buffer; its size is a real capacity decision."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Message brokers: Kafka, RabbitMQ, and SQS are Producer–Consumer scaled to a network, with the buffer durably stored so producers and consumers need not even be alive at the same time."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Go channels: a buffered channel, ch := make(chan T, N), is literally a bounded buffer with the semaphores built in, sending blocks when full, receiving blocks when empty, exactly like our code."}]]}],["$","li","3",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Buffered I/O and logging: your program produces log lines fast; a background thread consumes and flushes them to disk slowly. The in-memory buffer between them is the same structure."}]]}]]}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The word that turns this from trivia into engineering wisdom is backpressure. The buffer is bounded on purpose. When it fills, the producer blocks on the empty semaphore, and that blocking is a feature, not a bug. It is the system telling fast producers \"slow down, the consumers cannot keep up.\" Remove the bound to stop the blocking and you have not fixed anything; you have moved the failure. An unbounded queue absorbs the mismatch by growing without limit until the machine runs out of memory and the whole process dies, usually under exactly the peak load where you needed it most."}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],"$L38"]}],"$L39"]}],"$L3a"]}]]}]
2d:["$","section","04-readers-writers",{"id":"04-readers-writers","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"04"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Readers–Writers: sharing reads, isolating writes"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The setup: many threads share a piece of data. Threads that only read it do not interfere with one another, so it would be wasteful to force them to take turns, we want any number of readers active at once. But a writer changes the data, so a writer must have it entirely to itself: no other writer, and no reader, at the same time. This asymmetry, reads share, writes are exclusive, is the whole problem, and it is everywhere data is read far more often than it is written."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The trick is to make the readers, as a group, behave like a single user of the data with respect to writers. We keep a counter, read_count, of how many readers are currently active, protected by its own small mutex. The first reader to arrive acquires the write lock on behalf of all readers; the last reader to leave releases it. In between, readers come and go freely without touching the write lock at all. Writers simply grab that one write lock exclusively."}],["$","figure","2",{"className":"overflow-hidden rounded-lg border border-ink/15 bg-ink/[0.04]","children":[["$","div",null,{"className":"flex items-center justify-between border-b border-ink/10 bg-ink/[0.03] px-3.5 py-1.5","children":[["$","span",null,{"className":"font-mono text-[0.7rem] uppercase tracking-wide text-mute","children":"Readers–Writers, reader-priority variant. rw_lock guards the data; count_mtx guards read_count."}],["$","span",null,{"className":"font-mono text-[0.7rem] text-accent/70","children":"c"}]]}],["$","pre",null,{"className":"overflow-x-auto px-4 py-3 text-[0.86rem] leading-[1.6]","children":["$","code",null,{"className":"font-mono text-ink/90","children":"int read_count = 0;\nsem_t rw_lock;          /* exclusive data access, init 1 */\nsem_t count_mtx;        /* guards read_count, init 1 */\n\nvoid writer(void) {\n    sem_wait(&rw_lock);              /* full exclusive access */\n    write_data();\n    sem_post(&rw_lock);\n}\n\nvoid reader(void) {\n    sem_wait(&count_mtx);\n    if (++read_count == 1)           /* first reader in... */\n        sem_wait(&rw_lock);          /* ...locks out writers */\n    sem_post(&count_mtx);\n\n    read_data();                     /* many readers here at once */\n\n    sem_wait(&count_mtx);\n    if (--read_count == 0)           /* last reader out... */\n        sem_post(&rw_lock);          /* ...lets writers back in */\n    sem_post(&count_mtx);\n}"}]}]]}],["$","p","3",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Trace it once and the elegance is clear. Reader A arrives, bumps read_count to 1, and takes rw_lock. Reader B arrives, bumps it to 2, and, because it is not the first, walks straight in without touching rw_lock. Both read concurrently. A writer that shows up must wait on rw_lock until read_count falls to 0. Correct and efficient for the read-heavy case we wanted."}],"$L3b","$L3c","$L3d","$L3e"]}],"$L3f"]}]]}]
2e:["$","section","05-readers-writers-real-world",{"id":"05-readers-writers-real-world","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"05"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Readers–Writers in the systems you run"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"You almost never hand-roll the semaphore dance from the previous section, because the pattern is so common that it has been packaged into a primitive of its own: the read-write lock. POSIX gives you pthread_rwlock_t with rdlock and wrlock; Java has ReentrantReadWriteLock; Go has sync.RWMutex; Rust’s RwLock is in the standard library. Each one is exactly the Readers–Writers solution, hardened and given a name, with a documented policy about fairness and starvation you should actually read."}],["$","ul","1",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Databases: this is the beating heart of concurrency control. A shared (S) lock lets many transactions read a row at once; an exclusive (X) lock lets exactly one write it, blocking all readers. SELECT versus UPDATE is Readers–Writers at the row and table level, and the engine’s starvation policy determines whether a long-running report can starve an urgent write."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Read-heavy caches and config: an in-process cache, a routing table, a feature-flag map, read on nearly every request, written only when something changes. A read-write lock lets the hot read path run fully concurrently and pays the exclusive cost only on the rare refresh."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Copy-on-write and snapshots: some systems dodge the writer entirely by letting readers see an immutable snapshot while the writer prepares a new version and swaps a single pointer. It is the same asymmetry, solved by never blocking readers at all."}]]}]]}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Knowing this pattern changes how you debug production. When a database grinds to a halt under load, \"who holds the exclusive lock and who is queued behind it\" is the first question, and it is the Readers–Writers picture in your head that makes the question obvious. When a service’s tail latency spikes on writes, you suspect readers are starving the writer; when reads slow down, you suspect a writer is holding the exclusive lock too long. The classic problem is not academic; it is the mental model you debug with."}],["$","div","3",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],"$L40"]}]]}],"$L41"]}]]}]
2f:["$","section","06-dining-philosophers",{"id":"06-dining-philosophers","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"06"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"Dining Philosophers: the deadlock trap"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The setup is deliberately whimsical so the mechanics stay clear. Five philosophers sit around a round table. Between each pair of neighbours lies a single fork, five forks for five philosophers. A philosopher alternates between thinking and eating, and to eat they need both the fork on their left and the fork on their right. A fork is shared by two neighbours, so it is a shared resource, and each philosopher is a thread that needs two of them at once to make progress."}],["$","p","1",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The obvious solution is the trap. \"Pick up your left fork, then pick up your right fork, eat, put both down.\" Model each fork as a mutex and it reads perfectly reasonable:"}],["$","figure","2",{"className":"overflow-hidden rounded-lg border border-ink/15 bg-ink/[0.04]","children":[["$","div",null,{"className":"flex items-center justify-between border-b border-ink/10 bg-ink/[0.03] px-3.5 py-1.5","children":[["$","span",null,{"className":"font-mono text-[0.7rem] uppercase tracking-wide text-mute","children":"The naive solution, correct-looking, and deadlock-prone."}],["$","span",null,{"className":"font-mono text-[0.7rem] text-accent/70","children":"text"}]]}],["$","pre",null,{"className":"overflow-x-auto px-4 py-3 text-[0.86rem] leading-[1.6]","children":["$","code",null,{"className":"font-mono text-ink/90","children":"philosopher(i):\n    while true:\n        think()\n        lock(fork[i])                 # my left fork\n        lock(fork[(i + 1) % 5])       # my right fork\n        eat()\n        unlock(fork[i])\n        unlock(fork[(i + 1) % 5])"}]}]]}],["$","p","3",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Now imagine the interleaving that nature will eventually hand you. Every philosopher gets hungry at once. Each one successfully picks up their left fork, philosopher 0 takes fork 0, philosopher 1 takes fork 1, and so on around the table. Now every philosopher is holding one fork and reaching for the right-hand fork, which is the left fork of their neighbour, who is holding it and will not let go. Nobody can proceed, nobody will release, and the table sits frozen forever. That is a textbook deadlock, and the fact that it needs a specific timing to appear is exactly what makes it so dangerous, the code passes every casual test and then hangs in production at 3 a.m."}],["$","p","4",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The deadlock arises because all four of the necessary conditions line up: each fork gives mutual exclusion, philosophers hold one fork while waiting for another (hold-and-wait), nobody can be forced to drop a fork (no preemption), and the \"everyone waits for their neighbour\" arrangement forms a circular wait around the table. Break any one condition and the deadlock cannot form. Each classic solution is precisely an attack on one of those conditions."}],"$L42","$L43","$L44"]}],"$L45"]}]]}]
30:["$","section","07-what-they-teach",{"id":"07-what-they-teach","className":"scroll-mt-8","children":[["$","div",null,{"className":"mb-5 flex items-baseline gap-3","children":[["$","span",null,{"className":"font-hand text-3xl font-bold text-accent/60","children":"07"}],["$","h2",null,{"className":"font-hand text-3xl font-bold leading-tight text-ink sm:text-4xl","children":"What these problems really teach"}]]}],["$","div",null,{"className":"grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:items-start","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","p","0",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Strip away the costumes and each problem leaves you with one transferable idea you will use for the rest of your career. These are not three party tricks; they are three lenses for looking at any concurrent system, and the engineers who see through them reason about production incidents that leave others guessing."}],["$","dl","1",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"From Producer–Consumer: backpressure"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Decouple producers from consumers with a bounded buffer, and treat the bound as policy. When it fills, you must choose consciously between blocking, dropping, and (dangerously) growing forever."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"From Readers–Writers: exploit asymmetry"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"When one operation dominates, optimise its path. Let reads share and isolate only the rare write, but always ask which side your fairness policy is quietly starving."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"From Dining Philosophers: order your locks"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Circular wait is the deadlock you can design away for free. Acquire every set of locks in one consistent global order and cycles become impossible."}]]}]]}],["$","p","2",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"Underneath all three runs a single distinction that is worth naming explicitly, because you will use it every time you evaluate a concurrent design. Safety means nothing bad ever happens, no two threads corrupt the buffer, no reader sees a half-written value, no fork is held by two philosophers. Liveness means something good eventually happens, producers eventually proceed, writers eventually get their turn, philosophers eventually eat. Almost every concurrency bug is a violation of one or the other: a race condition breaks safety, while deadlock and starvation break liveness. A solution is only correct when it delivers both, and the classic problems are so instructive precisely because the naive answers nail one and quietly betray the other."}],["$","ul","3",{"className":"flex flex-col gap-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],"$L46"]}],"$L47","$L48"]}],"$L49"]}],"$L4a"]}]]}]
34:["$","p","4",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The single most important detail is the ordering: the semaphore wait happens outside the mutex, never inside it. Picture the alternative. A consumer grabs the mutex first and then waits on full while the buffer is empty, it now sleeps holding the lock, so no producer can ever get in to add an item and wake it. That is a self-inflicted deadlock. Wait for the resource first, then take the lock to touch the data; release the lock, then signal. Get that order right and the solution is bulletproof."}]
35:["$","dl","5",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"empty (counting semaphore)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"How many free slots remain; producers wait on it, consumers signal it. Starts at N."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"full (counting semaphore)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"How many filled slots exist; consumers wait on it, producers signal it. Starts at 0."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"mutex"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Guards the buffer indices during the tiny insert/remove step so two threads never corrupt them."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"The golden rule"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"wait(semaphore) before lock(mutex); unlock(mutex) before signal(semaphore). Never block on a semaphore while holding the lock."}]]}]]}]
36:["$","div","6",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Why two semaphores, not a counter you check",": "]}],"You might be tempted to keep an int count and test it. But testing and then sleeping is two steps, and a thread can be preempted between them, the lost-wakeup race. A counting semaphore makes \"decrement, and block if that would go negative\" a single atomic act, which is precisely why it exists."]}]]}]
37:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L32",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch16%2F02-producer-consumer.jpg?v=2713a1fd8c7419ff59d9f2be42049f2b","alt":"Handwritten A4 diagram: a fixed-size ring buffer of N slots drawn as boxes, with an \"in\" pointer where producers deposit items and an \"out\" pointer where consumers remove them. Two counting semaphores are labelled beside it: \"empty = free slots (init N)\" and \"full = filled slots (init 0)\", and a small mutex padlock sits on the buffer itself. Producer threads on the left push in; consumer threads on the right pull out."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
38:["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["The engineer’s lens",": "]}],"Whenever you see a queue in a design, ask: is it bounded, and what happens when it fills? \"It blocks\" (backpressure), \"it drops\" (load shedding), and \"it grows forever\" (a latent outage) are three very different systems. The bounded buffer forces you to choose on purpose instead of discovering the answer during an incident."]}]
39:["$","p","4",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"This is also why tuning a thread pool is subtle. Too small a queue and you reject or block work you could have absorbed; too large and you hide a chronic capacity shortfall behind a growing backlog and rising latency, until the buffer is a queue of stale work nobody wants anymore. The classic problem gave you the mechanism; production teaches you that the buffer size encodes a policy about how your system should behave when it is overloaded."}]
3a:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L32",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch16%2F03-producer-consumer-real-world.jpg?v=662070970ae9c41b7b67beb6649bf3be","alt":"Handwritten A4 diagram: a central bounded work-queue box. On the left, web-request threads push jobs in. On the right, a fixed pool of worker threads pull jobs out. A dashed arrow loops from a \"queue full\" label back to the producers with the label \"backpressure, producers slow down / block\". Below, small icons labelled \"thread pool\", \"Kafka / RabbitMQ\", \"Go channel ch := make(chan T, N)\", and \"buffered I/O\" show the same shape recurring."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
3b:["$","p","4",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"But this version has a nasty flaw that its own cleverness creates: writer starvation. As long as at least one reader is always active, read_count never returns to 0, so rw_lock is never released, so a waiting writer waits forever even though it may be an urgent update. Under a steady stream of readers, this solution is correct on safety but broken on liveness, the writer’s work never happens."}]
3c:["$","p","5",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The fix is to change the priority policy. A writer-priority variant adds bookkeeping so that once a writer is waiting, new readers are held back until that writer has had its turn, protecting writers at the risk of starving readers instead. Better still are fair (or \"no-starvation\") solutions that serve threads in roughly arrival order, so neither side is locked out indefinitely. There is no single right answer: the correct policy depends on whether stale reads or delayed writes hurt your application more. That judgement call is the real lesson."}]
3d:["$","dl","6",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"read_count"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"How many readers are active right now; the first reader acquires the write lock and the last releases it."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"rw_lock"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"The exclusive gate on the data. Held by an active writer, or held on behalf of the whole reader group."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Reader priority"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Readers never wait for a waiting writer; maximises read concurrency but can starve writers."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Writer priority / fair"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Holds back new readers once a writer is waiting, or serves in arrival order, to bound how long either side waits."}]]}]]}]
3e:["$","div","7",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["The transferable idea",": "]}],"The reader/writer asymmetry, cheap shared access for the common operation, exclusive access only for the rare mutating one, is one of the highest-leverage patterns in systems performance. When reads vastly outnumber writes, forcing everyone to take turns leaves most of your throughput on the floor."]}]]}]
3f:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L32",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch16%2F04-readers-writers.jpg?v=6cf7111767c2bd502f228b3be2c4911c","alt":"Handwritten A4 diagram: a shared data box in the centre. Multiple reader threads connect to it simultaneously with green \"OK\" arrows, shown reading together. A single writer thread reaches it through a locked gate; while the writer holds the gate, all readers are queued behind a barrier. A side note tracks \"read_count\" with an arrow showing \"first reader locks out writers, last reader lets them back in\". A caution bubble reads \"readers keep arriving → writer starves\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
40:["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["A caution worth internalising",": "]}],"A read-write lock is not automatically faster than a plain mutex. It carries more internal bookkeeping, so under short critical sections or a heavy write mix it can be slower. Reach for it when reads genuinely dominate and the critical section is non-trivial, measure, do not assume."]}]
41:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L32",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch16%2F05-readers-writers-real-world.jpg?v=64747e319524155e41d8dcf2a55c84e1","alt":"Handwritten A4 diagram: three labelled panels. Left, a \"read-write lock\" API sketch showing pthread_rwlock with rdlock (many arrows) and wrlock (one arrow). Middle, a database row with \"shared / S lock\" allowing many SELECTs and \"exclusive / X lock\" for a single UPDATE. Right, an in-memory cache box with a swarm of reader threads and one occasional writer refreshing an entry, annotated \"reads dominate → optimise the read path\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
42:["$","dl","5",{"className":"flex flex-col gap-2.5","children":[["$","div","0",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Resource ordering (break circular wait)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Number the forks and require every philosopher to pick up the lower-numbered fork first. Now the last philosopher reaches for the shared low fork before their own, so the cycle cannot close."}]]}],["$","div","1",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Limit the diners (break hold-and-wait pressure)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Allow at most four philosophers at the five-seat table at once (a counting semaphore of value 4). With one seat always spare, at least one philosopher can always get both forks."}]]}],["$","div","2",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Arbitrator / waiter (break the free-for-all)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"A central waiter must grant permission before anyone picks up forks, handing out forks only in combinations that cannot deadlock. Simple and correct, but the waiter is a bottleneck."}]]}],["$","div","3",{"className":"rounded-lg border border-ink/12 bg-surface/60 px-3.5 py-2.5","children":[["$","dt",null,{"className":"font-hand text-xl font-bold leading-tight text-accent2","children":"Try-and-back-off (break hold-and-wait directly)"}],["$","dd",null,{"className":"mt-0.5 text-[0.97rem] leading-[1.55] text-ink/80","children":"Take the first fork, then try the second; if it is unavailable, put the first back down and think again. Avoids deadlock but risks livelock, everyone politely retrying forever, unless you add randomness."}]]}]]}]
43:["$","p","6",{"className":"text-[1.02rem] leading-[1.75] text-ink/90","children":"The resource-ordering fix is the one worth burning into memory, because it generalises far beyond forks. Impose a single global order on your locks and always acquire them in that order, and a circular wait becomes impossible, there is no cycle when everyone climbs the same ladder in the same direction. This is not a philosophers’ trick; it is the number-one deadlock-prevention rule in real multithreaded code, from kernels to database engines. We will make this rigorous in the deadlock chapters, but Dining Philosophers is where you feel in your bones why lock ordering matters."}]
44:["$","div","7",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["The bridge to what is next",": "]}],"Dining Philosophers is really a deadlock problem wearing a costume. It hands you all four Coffman conditions and a menu of ways to defeat each one, mutual exclusion, hold-and-wait, no preemption, circular wait. Chapters 18 and 19 take exactly this vocabulary and build the full theory of preventing, avoiding, detecting, and recovering from deadlock."]}]]}]
45:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L32",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch16%2F06-dining-philosophers.jpg?v=78656c8000a38e6e6277c410e3765db2","alt":"Handwritten A4 diagram: five philosophers seated around a round table, numbered 0 to 4, with a single fork drawn between each adjacent pair (five forks total). Each philosopher needs both neighbouring forks to eat. One panel shows every philosopher having grabbed their left fork and reaching in vain for the right, arrows forming a cycle labelled \"DEADLOCK\". A second panel shows the fix: philosopher 4 reaching for the lower-numbered fork first, breaking the cycle."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
46:["$","span",null,{"children":"Producer–Consumer: safe with the mutex, live only if the buffer is bounded and backpressure is handled deliberately."}]
47:["$","li","1",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Readers–Writers: safe with the write lock, live only if the priority policy does not starve one side."}]]}]
48:["$","li","2",{"className":"flex gap-3 text-[1.02rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[2px] select-none text-accent","children":"▸"}],["$","span",null,{"children":"Dining Philosophers: safe with per-fork mutexes, live only once you break the circular wait."}]]}]
49:["$","div","4",{"className":"flex gap-3 rounded-lg border-l-[3px] border-accent bg-accent/10 px-4 py-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-0.5 select-none text-lg","children":"✎"}],["$","p",null,{"className":"text-[0.98rem] leading-[1.6] text-ink/90","children":[["$","span",null,{"className":"font-hand text-lg font-bold text-accent","children":["Handing off to deadlock",": "]}],"Dining Philosophers already showed you deadlock in the wild and one clean way out. Next we generalise: the four conditions that make deadlock possible, and the full toolkit of prevention, avoidance, detection, and recovery. You now have the intuition, the coming chapters give it teeth."]}]]}]
4a:["$","figure",null,{"className":"lg:sticky lg:top-8","children":[["$","$L32",null,{"url":"https://96375ehh.ap-southeast.insforge.app/api/storage/buckets/os-notes/objects/ch16%2F07-what-they-teach.jpg?v=019556a33c2d792470999c4da4aafc3b","alt":"Handwritten A4 summary sheet: three rows, each a problem mapped to its real-world lesson. Row 1, Producer–Consumer arrow to \"bounded buffers = backpressure\". Row 2, Readers–Writers arrow to \"optimise the common read path; watch for starvation\". Row 3, Dining Philosophers arrow to \"acquire locks in a global order\". A footer box labelled \"safety = nothing bad happens; liveness = something good eventually happens\" and a forward arrow to \"Deadlock, ch18–19\"."}],["$","figcaption",null,{"className":"mt-2 text-center text-xs italic text-mute","children":"Tap to enlarge"}]]}]
